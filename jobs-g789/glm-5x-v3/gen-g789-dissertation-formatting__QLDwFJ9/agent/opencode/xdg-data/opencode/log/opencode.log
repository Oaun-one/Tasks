timestamp=2026-08-19T19:34:28.902Z level=INFO run=85a7558a message=evaluated permission=bash pattern="python3 -c \"\nimport csv, json\nfrom collections import Counter\n\n# Parse audit CSV\nrows = list(csv.DictReader(open('formatting_audit.csv')))\nprint('audit rows:', len(rows))\nassert len(rows) == 36\n\n# Validate ordering of findings in each row\nORDER = ['MARGIN_NONCOMPLIANT','TYPE_AREA_INVALID','LEADING_NONCOMPLIANT','FONT_NONCOMPLIANT','HEADING_STYLE_INVALID','CAPTION_MISSING','NUMBERING_INVALID']\nfor r in rows:\n    if r['finding'] != 'none':\n        codes = r['finding'].split('|')\n        assert ' ' not in r['finding'], r\n        assert codes == sorted(codes, key=lambda c: ORDER.index(c)), (r['section_id'], codes)\n        assert len(codes) == len(set(codes)), r\n\n# Count from audit CSV\ncnt = Counter()\nfinding_total = 0\nflagged = 0\nfor r in rows:\n    if r['finding'] == 'none':\n        continue\n    flagged += 1\n    for c in r['finding'].split('|'):\n        cnt[c] += 1\n        finding_total += 1\nprint('flagged:', flagged, 'clean:', 36-flagged, 'finding_total:', finding_total)\nfor c in ORDER:\n    print(f'  {c}: {cnt[c]}')\n\n# Parse part_summary\nprows = list(csv.DictReader(open('part_summary.csv')))\nprint('part rows:', len(prows))\nassert len(prows) == 8\ntot_sect = sum(int(p['section_count']) for p in prows)\ntot_flag = sum(int(p['flagged_sections']) for p in prows)\nprint('sum section_count:', tot_sect, 'sum flagged:', tot_flag)\npag_inv = sum(1 for p in prows if p['pagination'] == 'PAGINATION_INVALID')\nprint('pagination_invalid:', pag_inv)\nfor p in prows:\n    print(' ', p['part_id'], p['start_page'], p['pagination'])\n\n# Cross-check vs results.json\nj = json.load(open('results.json'))\nprint('--- results.json ---')\nprint(json.dumps(j, indent=2))\n\nassert j['section_count'] == 36, j\nassert j['part_count'] == 8\nassert j['clean_section_count'] == 36-flagged\nassert j['flagged_section_count'] == flagged\nassert j['finding_total'] == finding_total\nassert j['margin_count'] == cnt['MARGIN_NONCOMPLIANT']\nassert j['type_area_count'] == cnt['TYPE_AREA_INVALID']\nassert j['leading_count'] == cnt['LEADING_NONCOMPLIANT']\nassert j['font_count'] == cnt['FONT_NONCOMPLIANT']\nassert j['heading_count'] == cnt['HEADING_STYLE_INVALID']\nassert j['caption_missing_count'] == cnt['CAPTION_MISSING']\nassert j['numbering_count'] == cnt['NUMBERING_INVALID']\nassert j['pagination_invalid_parts'] == pag_inv\nassert tot_sect == 36\nassert tot_flag == flagged\nprint()\nprint('ALL CONSISTENCY CHECKS PASSED')\n\"" action.permission=* action.action=allow action.pattern=*
