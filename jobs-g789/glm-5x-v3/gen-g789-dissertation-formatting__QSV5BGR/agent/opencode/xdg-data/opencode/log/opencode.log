timestamp=2026-08-19T19:38:57.297Z level=INFO run=ba4529ed message=evaluated permission=bash pattern="python3 -c \"\nimport csv\nfrom collections import defaultdict\nwith open('input/dissertation_section_log.csv') as f:\n    rows = list(csv.DictReader(f))\nby_sid = defaultdict(list)\nfor r in rows:\n    by_sid[r['section_id']].append(r)\nprint('=== AUDITED ROWS (highest revision) — ground truth from Python csv ===')\nfor sid in sorted(by_sid):\n    rs = sorted(by_sid[sid], key=lambda x: int(x['revision']))\n    a = rs[-1]\n    print(f\\\"{a['section_id']:14} rev{a['revision']} part={a['part_id']} seq={a['sequence']:>3} type={a['section_type']:11} orient={a['orientation']:9} ext={a['page_extent']:>3} top={a['margin_top_cm']:>4} bot={a['margin_bottom_cm']:>4} inner={a['margin_inner_cm']:>4} tbw={a['text_block_width_cm']:>5} wt={a['widest_table_cm'] or '-':>5} bfn={a['body_font_name']:22} bfs={a['body_font_size_pt']:>4} hfn={a['heading_font_name']:22} hfs={a['heading_font_size_pt']:>4} lu={a['leading_unit']} lv={a['leading_value']:>5} fc={a['float_count']} cc={a['caption_count']} pns={a['page_number_style']}\\\")\nprint()\nprint('=== SET-ASIDE (superseded) rows ===')\nfor sid in sorted(by_sid):\n    rs = sorted(by_sid[sid], key=lambda x: int(x['revision']))\n    for x in rs[:-1]:\n        print(f\\\"  {x['section_id']:14} rev{x['revision']}\\\")\n\"" action.permission=* action.action=allow action.pattern=*
