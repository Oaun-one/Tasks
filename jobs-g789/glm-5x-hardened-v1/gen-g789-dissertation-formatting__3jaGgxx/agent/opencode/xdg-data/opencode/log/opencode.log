timestamp=2026-08-19T18:42:54.632Z level=INFO run=322ee73c message=evaluated permission=bash pattern="python3 -c \"\nimport csv, json\nrows = list(csv.DictReader(open('input/dissertation_section_log.csv')))\n\n# pick highest revision per section_id\nbest = {}\nfor r in rows:\n    sid=r['section_id']; rev=int(r['revision'])\n    if sid not in best or rev > int(best[sid]['revision']):\n        best[sid]=r\n\nACCEPTED_FONTS = {'Times New Roman','TimesNewRomanPSMT','Times New Roman PS MT Std'}\nSUBMIT='2026-03-09'\n\n# thresholds\nINNER_MIN=3.0   # A-2\nSIDE_MIN=2.5     # base Rule 1\nFONT_SIZE=12.0\nMULT_REQ=1.5     # A-4 not in force\nEXACT_REQ=18.0  # A-5\nLANDSCAPE_W=29.7\nPRINTABLE_W=LANDSCAPE_W - INNER_MIN - SIDE_MIN  # 24.2\nprint('printable width threshold:', PRINTABLE_W)\n\n# waivers in force\nw1=True   # SEC-AN-01 font identifier, expires 2026-12-31 -> in force\nw2=False  # SEC-AN-03 font identifier, expires 2026-01-31 < 2026-03-09 expired\nw3=True   # SEC-LOF outer margin, expires 2026-11-30 -> in force\n\nfindings={}\nfor sid,r in best.items():\n    st=r['section_type']; orient=r['orientation']\n    mt=float(r['margin_top_cm']); mb=float(r['margin_bottom_cm'])\n    mi=float(r['margin_inner_cm']); mo=float(r['margin_outer_cm'])\n    wt=r['widest_table_cm'].strip()\n    wt=float(wt) if wt else None\n    # exception A-3\n    exc = (st=='annex' and orient=='landscape' and wt is not None and wt>PRINTABLE_W)\n    f=[]\n    # margins\n    margin_bad=False\n    # inner never relieved\n    if mi < INNER_MIN: margin_bad=True\n    if not exc:\n        if mt < SIDE_MIN or mb < SIDE_MIN or mo < SIDE_MIN: margin_bad=True\n    else:\n        # top/bottom/outer relieved; only inner matters (already checked)\n        pass\n    # W-3: SEC-LOF outer margin only\n    if sid=='SEC-LOF' and w3:\n        # clears outer margin only\n        if mo < SIDE_MIN and not exc and mt>=SIDE_MIN and mb>=SIDE_MIN and mi>=INNER_MIN:\n            margin_bad=False\n    if margin_bad: f.append('MARGIN_NONCOMPLIANT')\n    # font\n    font_ok = r['font_name'] in ACCEPTED_FONTS and float(r['font_size_pt'])==FONT_SIZE\n    # waivers\n    if sid=='SEC-AN-01' and w1:\n        if r['font_name'] not in ACCEPTED_FONTS and float(r['font_size_pt'])==FONT_SIZE:\n            font_ok=True  # clears identifier only, size still must be 12\n    if sid=='SEC-AN-03' and w2:\n        if r['font_name'] not in ACCEPTED_FONTS and float(r['font_size_pt'])==FONT_SIZE:\n            font_ok=True\n    if not font_ok: f.append('FONT_NONCOMPLIANT')\n    # spacing\n    spacing_ok=False\n    if r['spacing_mode']=='multiple':\n        spacing_ok = abs(float(r['spacing_value'])-MULT_REQ)<1e-9\n    elif r['spacing_mode']=='exact':\n        spacing_ok = abs(float(r['spacing_value'])-EXACT_REQ)<1e-9\n    if not spacing_ok: f.append('SPACING_NONCOMPLIANT')\n    findings[sid]= (f, exc)\n\norder=['MARGIN_NONCOMPLIANT','FONT_NONCOMPLIANT','SPACING_NONCOMPLIANT']\ndef fmt(f):\n    if not f: return 'none'\n    return '|'.join(x for x in order if x in f)\n\nfor sid in sorted(findings):\n    f,exc=findings[sid]\n    print(f'{sid:14s} exc={int(exc)} -> {fmt(f)}')\n\nprint()\nprint('section_count', len(findings))\nflagged=sum(1 for s,(f,e) in findings.items() if f)\nprint('flagged_count', flagged)\nprint('margin_count', sum(1 for s,(f,e) in findings.items() if 'MARGIN_NONCOMPLIANT' in f))\nprint('font_count', sum(1 for s,(f,e) in findings.items() if 'FONT_NONCOMPLIANT' in f))\nprint('spacing_count', sum(1 for s,(f,e) in findings.items() if 'SPACING_NONCOMPLIANT' in f))\nprint()\nprint('exception applies to:')\nfor sid in sorted(findings):\n    f,exc=findings[sid]\n    if exc: print(' ',sid, best[sid]['widest_table_cm'])\n\"" action.permission=* action.action=allow action.pattern=*
