timestamp=2026-08-20T02:44:02.050Z level=INFO run=a3b12e3a message=evaluated permission=bash pattern="cat > /tmp/opencode/write_deliverables.py << 'PYEOF'\nimport csv, json\nfrom datetime import date\n\nAUDIT_DATE = date(2026, 3, 31)\n\ndef load_csv(path):\n    with open(path, newline='') as f:\n        return list(csv.DictReader(f))\n\naccounts = {a['account_id']: a for a in load_csv('/app/input/client_accounts.csv')}\naccounts_order = [a['account_id'] for a in load_csv('/app/input/client_accounts.csv')]\nlicences = {l['license_id']: l for l in load_csv('/app/input/licensed_property_register.csv')}\nrequests = load_csv('/app/input/composite_request_log.csv')\n\ndef parse_date(s):\n    y, m, d = s.split('-')\n    return date(int(y), int(m), int(d))\n\ndef lic_covers(req, lic_id, use_type):\n    if lic_id in ('none',''):\n        return False\n    lic = licences.get(lic_id)\n    if lic is None:\n        return False\n    if lic['license_type'] != use_type:\n        return False\n    dists = [d.strip() for d in lic['covers_distribution'].split(';')]\n    if dists != ['all'] and req['intended_distribution'] not in dists:\n        return False\n    if parse_date(lic['valid_until']) < AUDIT_DATE:\n        return False\n    return True\n\ndef account_clears(acc, distribution):\n    if acc['agreement_status'] != 'active':\n        return False\n    covers = [c.strip() for c in acc['master_agreement_covers'].split(';')]\n    return distribution in covers\n\nFINDING_ORDER = [\n    'UNLICENSED_CHARACTER_USE',\n    'THIRD_PARTY_BACKGROUND_UNLICENSED',\n    'MISSING_MINOR_CONSENT',\n    'COMMERCIAL_DISTRIBUTION_FLAG',\n    'ALTERATION_DISCLOSURE_MISSING',\n]\n\naudit = {}\nfor req in requests:\n    rid = req['request_id']\n    findings = []\n    if req['character_property'] != 'none':\n        cleared_by_lic = lic_covers(req, req['character_license_id'], 'character')\n        personal = req['intended_distribution'] == 'personal_only'\n        if not (cleared_by_lic or personal):\n            findings.append('UNLICENSED_CHARACTER_USE')\n    bs = req['background_source']\n    if bs == 'third_party_unlicensed':\n        findings.append('THIRD_PARTY_BACKGROUND_UNLICENSED')\n    elif bs == 'third_party_licensed':\n        if not lic_covers(req, req['background_license_id'], 'background'):\n            findings.append('THIRD_PARTY_BACKGROUND_UNLICENSED')\n    if req['subject_is_minor'] == 'True':\n        ct = req['minor_consent_type']\n        fail = False\n        if ct == 'none':\n            fail = True\n        else:\n            if parse_date(req['minor_consent_valid_until']) < AUDIT_DATE:\n                fail = True\n            dist = req['intended_distribution']\n            if ct == 'basic' and dist not in ('personal_only','client_internal'):\n                fail = True\n        if fail:\n            findings.append('MISSING_MINOR_CONSENT')\n    dist = req['intended_distribution']\n    if dist in ('social_public','print_for_sale'):\n        acc = accounts[req['account_id']]\n        if not account_clears(acc, dist):\n            findings.append('COMMERCIAL_DISTRIBUTION_FLAG')\n    if req['alteration_level']=='substantive' and dist in ('social_public','print_for_sale'):\n        if req['alteration_disclosure_on_file'] != 'True':\n            findings.append('ALTERATION_DISCLOSURE_MISSING')\n    ordered = [f for f in FINDING_ORDER if f in findings]\n    audit[rid] = ordered\n\n# composite_request_audit.csv\nwith open('/app/composite_request_audit.csv','w',newline='') as f:\n    w = csv.writer(f)\n    w.writerow(['request_id','finding'])\n    for req in requests:\n        rid = req['request_id']\n        fs = audit[rid]\n        w.writerow([rid, '|'.join(fs) if fs else 'none'])\n\n# account_summary.csv\nacc_rows = []\nfor acc_id in accounts_order:\n    acc = accounts[acc_id]\n    reqs = [r for r in requests if r['account_id']==acc_id]\n    flagged = [r for r in reqs if audit[r['request_id']]]\n    escalate = 'none'\n    if len(flagged) >= 2 or any(len(audit[r['request_id']])>=3 for r in reqs):\n        escalate = 'ESCALATION_REQUIRED'\n    acc_rows.append([acc_id, acc['account_type'], len(reqs), len(flagged), escalate])\nwith open('/app/account_summary.csv','w',newline='') as f:\n    w = csv.writer(f)\n    w.writerow(['account_id','account_type','request_count','flagged_requests','escalation'])\n    for row in acc_rows:\n        w.writerow(row)\n\n# results.json\nflagged_count = sum(1 for r in requests if audit[r['request_id']])\nfinding_total = sum(len(audit[r['request_id']]) for r in requests)\ndef count_finding(f):\n    return sum(1 for r in requests if f in audit[r['request_id']])\nescalated = sum(1 for a in accounts_order if acc_rows[[r[0] for r in acc_rows].index(a)][4]=='ESCALATION_REQUIRED')\nresults = {\n    'request_count': len(requests),\n    'account_count': len(accounts),\n    'flagged_count': flagged_count,\n    'compliant_count': len(requests)-flagged_count,\n    'finding_total': finding_total,\n    'character_count': count_finding('UNLICENSED_CHARACTER_USE'),\n    'background_count': count_finding('THIRD_PARTY_BACKGROUND_UNLICENSED'),\n    'consent_count': count_finding('MISSING_MINOR_CONSENT'),\n    'commercial_count': count_finding('COMMERCIAL_DISTRIBUTION_FLAG'),\n    'disclosure_count': count_finding('ALTERATION_DISCLOSURE_MISSING'),\n    'escalated_accounts': escalated,\n}\nwith open('/app/results.json','w') as f:\n    json.dump(results, f, indent=2)\n    f.write('\\n')\n\nprint(\"Deliverables written.\")\nprint(json.dumps(results, indent=2))\nPYEOF" action.permission=* action.action=allow action.pattern=*
