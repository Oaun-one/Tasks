timestamp=2026-08-19T13:07:32.535Z level=INFO run=da1a75f8 message=evaluated permission=bash pattern="python3 << 'PYEOF'\nimport csv, re, json\nREQUIRED=[\"race\",\"colour\",\"religion\",\"sex\",\"familial status\",\"national origin\",\"disability\",\"sexual orientation\",\"veteran status\",\"marital status\",\"source of income\"]\nRESP={\"closing_page\",\"agent_bio\"}\nMARKER=\"this brokerage complies with the federal fair housing act\"\nrows=list(csv.DictReader(open(\"/app/input/seller_book_sections.csv\")))\ndef notice(t):\n    low=t.lower(); i=low.find(MARKER); return (None,t) if i==-1 else (t[i:],t[:i])\ndef named(n):\n    if not n: return set()\n    low=n.lower(); s=set()\n    for c in REQUIRED:\n        vs=[c] if c!=\"colour\" else [\"colour\",\"color\"]\n        for v in vs:\n            if re.search(r\"\\b\"+re.escape(v)+r\"\\b\", low): s.add(c); break\n    return s\ndef pcl(t):\n    low=t.lower()\n    for t2 in [\"race\",\"colour\",\"color\",\"religion\",\"sex\",\"familial status\",\"national origin\",\"disability\",\"sexual orientation\",\"veteran status\"]:\n        if re.search(r\"\\b\"+re.escape(t2)+r\"\\b\", low): return True\n    for t2 in [\"church\",\"churches\",\"churchgoing\",\"parish\",\"faith\",\"worship\",\"congregation\"]:\n        if re.search(r\"\\b\"+re.escape(t2)+r\"\\b\", low): return True\n    if re.search(r\"\\b(family-oriented|young families|churchgoing households|long-established families|congregation-centred)\\b\", low): return True\n    if re.search(r\"\\b(street|block|neighbourhood|neighborhood)\\b\", low) and re.search(r\"\\b(households|families|family-oriented)\\b\", low): return True\n    return False\ndef pn(t):\n    low=t.lower()\n    return any(re.search(p,low) for p in [r\"write us a a letter\",r\"write us a letter\",r\"personal note about yourself\",r\"personal note about themselves\",r\"covering letter introducing yourself\",r\"introduce a short personal note\",r\"letter about what brought you here\",r\"tell us about yourselves\",r\"why this home suits them\",r\"like to know who is buying\"])\nexpected={}\nfor r in rows:\n    sid=r[\"section_id\"]; role=r[\"role\"]; body=r[\"body\"]; title=r[\"title\"]\n    n,p=notice(body); nm=named(n)\n    complete = n is not None and nm==set(REQUIRED); abridged = n is not None and not complete\n    f=[]\n    if pn(title+\" \"+body): f.append(\"PROHIBITED_PERSONAL_NARRATIVE\")\n    hit=pcl(p+\" \"+title)\n    if abridged and pcl(n): hit=True\n    if hit: f.append(\"PROTECTED_CLASS_LANGUAGE\")\n    if role in RESP and not complete: f.append(\"DISCLAIMER_MISSING\")\n    expected[sid]=\"|\".join(f) if f else \"none\"\nwritten={r[\"section_id\"]:r[\"finding\"] for r in csv.DictReader(open(\"/app/fairhousing_audit.csv\"))}\nmism=[(s,expected[s],written.get(s)) for s in expected if expected[s]!=written.get(s)]\norder=[r[\"section_id\"] for r in rows]\norder_ok = list(written.keys())==order\nprint(\"inventory-order match:\", order_ok)\nprint(\"findings match:\", not mism)\nif mism: print(\"MISMATCHES:\", mism)\nprint(\"expected==written for all 30:\", expected==written)\nPYEOF" action.permission=* action.action=allow action.pattern=*
