timestamp=2026-08-20T02:44:26.369Z level=INFO run=a3b12e3a message=evaluated permission=bash pattern="python3 -c \"\nimport csv, json\n# validate CSV headers and row counts\nfor path,cols in [('/app/composite_request_audit.csv',['request_id','finding']),('/app/account_summary.csv',['account_id','account_type','request_count','flagged_requests','escalation'])]:\n    with open(path) as f:\n        r=csv.reader(f)\n        header=next(r)\n        rows=list(r)\n        assert header==cols, f'{path} header {header} != {cols}'\n        print(path, 'header OK', len(rows),'rows')\n# cross-check audit findings vs memo tally / results.json\naudit={}\nwith open('/app/composite_request_audit.csv') as f:\n    for row in csv.DictReader(f):\n        audit[row['request_id']]=row['finding'].split('|') if row['finding']!='none' else []\nflagged=sum(1 for v in audit.values() if v)\nftotal=sum(len(v) for v in audit.values())\nfrom collections import Counter\nc=Counter()\nfor v in audit.values():\n    for f in v: c[f]+=1\nres=json.load(open('/app/results.json'))\nassert res['request_count']==len(audit)\nassert res['flagged_count']==flagged\nassert res['compliant_count']==len(audit)-flagged\nassert res['finding_total']==ftotal\nassert res['character_count']==c['UNLICENSED_CHARACTER_USE']\nassert res['background_count']==c['THIRD_PARTY_BACKGROUND_UNLICENSED']\nassert res['consent_count']==c['MISSING_MINOR_CONSENT']\nassert res['commercial_count']==c['COMMERCIAL_DISTRIBUTION_FLAG']\nassert res['disclosure_count']==c['ALTERATION_DISCLOSURE_MISSING']\nprint('results.json matches audit.csv:', res)\n# account summary cross-check\nacc={}\nfor rid,fs in audit.items():\n    acc.setdefault(rid.split('-')[1],[]).__class__  # no-op\n# build from request log\nimport csv as _c\nlog=list(_c.DictReader(open('/app/input/composite_request_log.csv')))\nacct={}\nfor r in log:\n    acct.setdefault(r['account_id'],[]).append(r['request_id'])\nasum={}\nwith open('/app/account_summary.csv') as f:\n    for row in csv.DictReader(f):\n        asum[row['account_id']]=row\nesc=0\nfor aid,reqs in acct.items():\n    flagged_reqs=[x for x in reqs if audit[x]]\n    row=asum[aid]\n    assert int(row['request_count'])==len(reqs), aid\n    assert int(row['flagged_requests'])==len(flagged_reqs), aid\n    exp='ESCALATION_REQUIRED' if (len(flagged_reqs)>=2 or any(len(audit[x])>=3 for x in reqs)) else 'none'\n    assert row['escalation']==exp, (aid,row['escalation'],exp)\n    if exp=='ESCALATION_REQUIRED': esc+=1\nassert res['escalated_accounts']==esc\nprint('account_summary.csv OK, escalated_accounts=',esc)\nprint('ALL CHECKS PASSED')\n\"" action.permission=* action.action=allow action.pattern=*
