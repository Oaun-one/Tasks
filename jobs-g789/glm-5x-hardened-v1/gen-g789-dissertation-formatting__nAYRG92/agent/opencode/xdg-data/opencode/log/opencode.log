timestamp=2026-08-19T18:50:23.396Z level=INFO run=5d323c2a message=evaluated permission=bash pattern="cat << 'EOF' > /tmp/audit.py\nimport csv\n\n# Thresholds (submission date 2026-03-09)\nSUB = \"2026-03-09\"\nINNER_MIN = 3.0   # A-2 in force (eff 2025-01-15 <= sub)\nSIDE_MIN = 2.5    # base, unchanged\nFONT_SIZE_REQ = 12.0\nACCEPTED_FONTS = {\"Times New Roman\", \"TimesNewRomanPSMT\", \"Times New Roman PS MT Std\"}\nMULT_REQ = 1.5    # A-4 NOT in force (eff 2026-07-01 > sub) -> body stays 1.5\nEXACT_REQ = 18.0  # A-5 in force (eff 2025-11-01 <= sub)\nLS_WIDTH = 29.7\nPRINTABLE_WIDTH_LS = LS_WIDTH - INNER_MIN - SIDE_MIN  # 24.2\nprint(\"Landscape printable width threshold:\", PRINTABLE_WIDTH_LS)\n\n# Waivers: (section -> (rule, scope, granted, expires))\nwaivers = {\n    \"SEC-AN-01\": (\"Rule2_fontid\", \"2025-10-04\", \"2026-12-31\"),\n    \"SEC-AN-03\": (\"Rule2_fontid\", \"2025-04-18\", \"2026-01-31\"),\n    \"SEC-LOF\":   (\"Rule1_outer\",  \"2025-12-02\", \"2026-11-30\"),\n}\n\nrows = []\nwith open(\"/app/input/dissertation_section_log.csv\") as f:\n    r = csv.DictReader(f)\n    for row in r:\n        rows.append(row)\n\nprint(\"Total data rows:\", len(rows))\n\n# pick highest revision per section_id\nlatest = {}\nsetaside = []\nfor row in rows:\n    sid = row[\"section_id\"]\n    rev = int(row[\"revision\"])\n    if sid not in latest or rev > int(latest[sid][\"revision\"]):\n        if sid in latest:\n            setaside.append(latest[sid])\n        latest[sid] = row\n    else:\n        setaside.append(row)\n\n# setaside should be the superseded ones. Let's recompute cleanly.\nlatest = {}\nallrevs = {}\nfor row in rows:\n    sid = row[\"section_id\"]\n    allrevs.setdefault(sid, []).append(row)\naudited = {}\nsetaside = []\nfor sid, lst in allrevs.items():\n    lst.sort(key=lambda x: int(x[\"revision\"]))\n    audited[sid] = lst[-1]\n    for x in lst[:-1]:\n        setaside.append(x)\n\nprint(\"Audited sections:\", len(audited))\nprint(\"Set-aside rows:\", len(setaside))\nprint(\"Set-aside:\", [(r[\"section_id\"], r[\"revision\"]) for r in setaside])\n\ndef fnum(v):\n    try:\n        return float(v)\n    except:\n        return None\n\nresults = {}\nmargin_count = font_count = spacing_count = flagged_count = 0\nflagged_list = []\nfor sid, row in audited.items():\n    findings = []\n    st = row[\"section_type\"]\n    orient = row[\"orientation\"]\n    top = fnum(row[\"margin_top_cm\"]); bot = fnum(row[\"margin_bottom_cm\"])\n    inn = fnum(row[\"margin_inner_cm\"]); out = fnum(row[\"margin_outer_cm\"])\n    wt = fnum(row[\"widest_table_cm\"]) if row[\"widest_table_cm\"] else None\n    fn = row[\"font_name\"]; fs = fnum(row[\"font_size_pt\"])\n    smode = row[\"spacing_mode\"]; sval = fnum(row[\"spacing_value\"])\n\n    # Rule 1 exception (A-3): annex + landscape + oversized table (widest > printable width)\n    exception = (st == \"annex\" and orient == \"landscape\" and wt is not None and wt > PRINTABLE_WIDTH_LS)\n\n    # Margins\n    margin_breach = False\n    # inner always checked\n    if inn is None or inn < INNER_MIN:\n        margin_breach = True\n    if not exception:\n        # top, bottom, outer checked in full\n        if top is None or top < SIDE_MIN: margin_breach = True\n        if bot is None or bot < SIDE_MIN: margin_breach = True\n        if out is None or out < SIDE_MIN: margin_breach = True\n    if margin_breach:\n        findings.append(\"MARGIN_NONCOMPLIANT\")\n\n    # Font (Rule 2)\n    font_breach = False\n    id_ok = fn in ACCEPTED_FONTS\n    size_ok = (fs is not None and fs == FONT_SIZE_REQ)\n    w = waivers.get(sid)\n    id_waived = False\n    if w and w[0] == \"Rule2_fontid\":\n        if w[1] <= SUB <= w[2]:\n            id_waived = True\n    if not id_ok and not id_waived:\n        font_breach = True\n    if not size_ok:\n        font_breach = True\n    if font_breach:\n        findings.append(\"FONT_NONCOMPLIANT\")\n\n    # Spacing (Rule 3 + A-5; A-4 not in force -> body stays 1.5)\n    spacing_breach = False\n    if smode == \"multiple\":\n        if sval != MULT_REQ:\n            spacing_breach = True\n    elif smode == \"exact\":\n        if sval != EXACT_REQ:\n            spacing_breach = True\n    else:\n        spacing_breach = True\n    # W-3 for SEC-LOF is outer-margin only; doesn't touch spacing\n    if spacing_breach:\n        findings.append(\"SPACING_NONCOMPLIANT\")\n\n    order = [\"MARGIN_NONCOMPLIANT\",\"FONT_NONCOMPLIANT\",\"SPACING_NONCOMPLIANT\"]\n    findings.sort(key=lambda x: order.index(x))\n    finding = \"|\".join(findings) if findings else \"none\"\n    results[sid] = (finding, exception, id_waived, wt, inn, out, top, bot, fn, fs, smode, sval)\n    if findings:\n        flagged_count += 1\n        flagged_list.append(sid)\n        if \"MARGIN_NONCOMPLIANT\" in findings: margin_count += 1\n        if \"FONT_NONCOMPLIANT\" in findings: font_count += 1\n        if \"SPACING_NONCOMPLIANT\" in findings: spacing_count += 1\n\nprint(\"\\n=== AUDIT ===\")\nfor sid in sorted(results):\n    f, exc, idw, wt, inn, out, top, bot, fn, fs, sm, sv = results[sid]\n    print(f\"{sid:12} -> {f:50} | exc={exc} wt={wt} inn={inn} out={out} top={top} bot={bot} | {fn} {fs} | {sm} {sv}\")\n\nprint(\"\\n=== COUNTS ===\")\nprint(\"section_count:\", len(audited))\nprint(\"flagged_count:\", flagged_count)\nprint(\"margin_count:\", margin_count)\nprint(\"font_count:\", font_count)\nprint(\"spacing_count:\", spacing_count)\nprint(\"flagged:\", flagged_list)\n\nprint(\"\\n=== EXCEPTION APPLIED TO ===\")\nexc_sections = [sid for sid in results if results[sid][1]]\nprint(sorted(exc_sections))\nEOF" action.permission=* action.action=allow action.pattern=*
