timestamp=2026-08-19T19:40:55.636Z level=INFO run=716e7d97 message=evaluated permission=bash pattern="python3 -c \"\nimport sys; sys.path.insert(0,'/tmp/opencode')\nfrom audit import results\nfor s in sorted(results, key=lambda x: results[x]['sequence']):\n    r=results[s]\n    print(f\\\"{s} [{r['part_id']}/{r['template_id']}] seq={r['sequence']} type={r['section_type']} {r['orientation']} -> {r['code']}\\\")\n    for d in r['details']:\n        if d[0].endswith('_CLEARED'):\n            print('    CLEARED', d[0], '|', d[1], '|', d[2], '|', d[3])\n        else:\n            print('    ', d[0], '|', d[1], '|', d[2], '|', d[3])\n\"" action.permission=* action.action=allow action.pattern=*
