timestamp=2026-08-19T13:03:03.289Z level=INFO run=455de72b message=evaluated permission=bash pattern="python3 - <<'EOF'\nimport csv, json\n# Validate CSV: exactly two columns, header, 30 data rows, matches inventory order and results.json\ninv = list(csv.DictReader(open(\"/app/input/seller_book_sections.csv\")))\ninv_ids = [r[\"section_id\"] for r in inv]\n\nwith open(\"/app/fairhousing_audit.csv\", newline=\"\") as f:\n    rdr = list(csv.reader(f))\nheader = rdr[0]; data = rdr[1:]\nassert header == [\"section_id\",\"finding\"], f\"BAD HEADER: {header}\"\nassert len(data)==30, f\"BAD ROW COUNT: {len(data)}\"\n# no trailing empty rows\nassert all(len(row)==2 for row in data), \"row without exactly 2 cols\"\ncsv_ids = [row[0] for row in data]\nassert csv_ids==inv_ids, \"order mismatch with inventory\"\nallowed = {\"PROHIBITED_PERSONAL_NARRATIVE\",\"PROTECTED_CLASS_LANGUAGE\",\"DISCLAIMER_MISSING\",\"none\"}\nfor sid,finding in data:\n    parts = finding.split(\"|\")\n    for p in parts: assert p in allowed, f\"bad label {p} in {sid}\"\n    assert parts == sorted(parts, key=lambda x:[\"PROHIBITED_PERSONAL_NARRATIVE\",\"PROTECTED_CLASS_LANGUAGE\",\"DISCLAIMER_MISSING\"].index(x)), f\"bad join order in {sid}: {finding}\"\n\n# Recompute counts from CSV and compare to results.json\nfindings = {row[0]:row[1] for row in data}\nres = json.load(open(\"/app/results.json\"))\nexpect = {\n \"section_count\": len(findings),\n \"flagged_count\": sum(1 for v in findings.values() if v!=\"none\"),\n \"personal_narrative_count\": sum(1 for v in findings.values() if \"PROHIBITED_PERSONAL_NARRATIVE\" in v),\n \"protected_lang_count\": sum(1 for v in findings.values() if \"PROTECTED_CLASS_LANGUAGE\" in v),\n \"disclaimer_missing_count\": sum(1 for v in findings.values() if \"DISCLAIMER_MISSING\" in v),\n}\nassert res==expect, f\"MISMATCH csv vs results.json\\n res={res}\\n expect={expect}\"\nprint(\"CSV OK: header\", header, \"| rows\", len(data), \"| inventory order preserved | join order correct\")\nprint(\"results.json matches CSV-derived counts:\")\nprint(json.dumps(expect, indent=2))\nEOF" action.permission=* action.action=allow action.pattern=*
