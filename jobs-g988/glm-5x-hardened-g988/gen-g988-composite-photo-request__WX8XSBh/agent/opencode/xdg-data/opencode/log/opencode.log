timestamp=2026-08-20T02:41:09.960Z level=INFO run=c69f11eb message=evaluated permission=bash pattern="python3 -c \"\nimport json, csv\n# validate audit csv\nwith open('/app/composite_request_audit.csv') as f:\n    rows = list(csv.DictReader(f))\nprint('audit rows:', len(rows), 'cols:', list(rows[0].keys()))\nassert list(rows[0].keys()) == ['request_id','finding'], 'audit cols wrong'\nassert all(r['request_id'] for r in rows)\n# validate account csv\nwith open('/app/account_summary.csv') as f:\n    arows = list(csv.DictReader(f))\nprint('account rows:', len(arows), 'cols:', list(arows[0].keys()))\nassert list(arows[0].keys()) == ['account_id','account_type','request_count','flagged_requests','escalation'], 'account cols wrong'\n# validate json\nd = json.load(open('/app/results.json'))\nprint('json keys:', list(d.keys()))\nassert d['request_count']==32 and d['account_count']==8 and d['flagged_count']==16 and d['compliant_count']==16\nassert d['finding_total']==24\nassert d['character_count']==4 and d['background_count']==5 and d['consent_count']==4 and d['commercial_count']==8 and d['disclosure_count']==3\nassert d['escalated_accounts']==['ACC-01','ACC-02','ACC-04','ACC-05','ACC-06','ACC-08']\n# cross-check finding_total = sum of categories\nassert d['finding_total'] == d['character_count']+d['background_count']+d['consent_count']+d['commercial_count']+d['disclosure_count']\n# cross-check flagged_count = requests with non-none finding\nflagged = sum(1 for r in rows if r['finding']!='none')\nassert flagged == d['flagged_count'], (flagged, d['flagged_count'])\n# count findings per request\nimport collections\ntotal=0\nfor r in rows:\n    if r['finding']!='none':\n        total += len(r['finding'].split('|'))\nassert total == d['finding_total'], (total, d['finding_total'])\n# check escalation counts match flagged_requests\nfor ar in arows:\n    print(ar['account_id'], 'reqs=',ar['request_count'],'flagged=',ar['flagged_requests'],'esc=',ar['escalation'])\nprint('ALL VALIDATIONS PASSED')\n\"" action.permission=* action.action=allow action.pattern=*
