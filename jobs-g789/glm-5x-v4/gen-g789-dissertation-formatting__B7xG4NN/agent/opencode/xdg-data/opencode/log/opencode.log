timestamp=2026-08-19T20:17:46.413Z level=INFO run=7c8b03f1 message=evaluated permission=bash pattern="python3 -c \"\nimport json, csv, os\nfiles = ['formatting_audit.csv','part_summary.csv','formatting_memo.md','results.json']\nfor f in files:\n    print(f, '->', 'EXISTS' if os.path.exists(f) else 'MISSING', os.path.getsize(f), 'bytes')\nprint()\n# validate results.json: all values integers\nr = json.load(open('results.json'))\nreq_keys = ['section_count','part_count','clean_section_count','flagged_section_count','finding_total','margin_count','type_area_count','leading_count','font_count','heading_count','caption_missing_count','numbering_count','caption_shortfall_total','pagination_invalid_parts','sections_in_invalid_parts','flagged_archive_sections','flagged_reading_sections']\nassert set(r.keys()) == set(req_keys), (set(r.keys())^set(req_keys))\nassert all(isinstance(v,int) for v in r.values()), [k for k,v in r.items() if not isinstance(v,int)]\nprint('results.json keys+integers OK:', r)\nprint()\n# validate audit csv\nrows = list(csv.DictReader(open('formatting_audit.csv')))\nassert len(rows)==44, len(rows)\nassert list(rows[0].keys())==['section_id','part_id','template_id','finding']\ncodes = set()\nfor x in rows:\n    for c in x['finding'].split('|'):\n        codes.add(c)\nprint('audit rows:', len(rows), '| distinct findings incl none:', sorted(codes))\nprint()\n# validate part summary\nprows = list(csv.DictReader(open('part_summary.csv')))\nassert len(prows)==8\nassert list(prows[0].keys())==['part_id','template_id','section_count','flagged_sections','start_page','pagination']\nprint('part_summary rows:', len(prorows))\nsc = sum(int(x['section_count']) for x in prows); fl = sum(int(x['flagged_sections']) for x in prows)\nprint('sum section_count =', sc, 'sum flagged =', fl)\n# cross-check\nimport collections\ncnt = collections.Counter()\nfor x in rows:\n    if x['finding']!='none':\n        for c in x['finding'].split('|'): cnt[c]+=1\nprint('finding counts:', dict(cnt), 'total=', sum(cnt.values()))\n\"" action.permission=* action.action=allow action.pattern=*
