timestamp=2026-08-19T14:18:37.199Z level=INFO run=1164c392 message=evaluated permission=bash pattern="python3 - <<'PY'\nimport csv, json\nrows=list(csv.DictReader(open('fairhousing_audit.csv')))\nprint(\"csv header:\", list(rows[0].keys()))\nprint(\"csv row count (excl header):\", len(rows))\norder_ok = [r['section_id'] for r in rows]==[f\"SEC-{i:02d}\" for i in range(1,31)]\nprint(\"inventory order ok:\", order_ok)\nvalid_labels={'PROHIBITED_PERSONAL_NARRATIVE','PROTECTED_CLASS_LANGUAGE','DISCLAIMER_MISSING','none'}\nbad=[r for r in rows if not (set(r['finding'].split('|'))<=valid_labels)]\nprint(\"invalid label rows:\", bad)\nflagged=sum(1 for r in rows if r['finding']!='none')\npn=sum(1 for r in rows if 'PROHIBITED_PERSONAL_NARRATIVE' in r['finding'].split('|'))\npl=sum(1 for r in rows if 'PROTECTED_CLASS_LANGUAGE' in r['finding'].split('|'))\ndm=sum(1 for r in rows if 'DISCLAIMER_MISSING' in r['finding'].split('|'))\nprint(\"flagged\",flagged,\"pn\",pn,\"pl\",pl,\"dm\",dm)\nres=json.load(open('results.json'))\nprint(\"results.json:\", res)\nprint(\"match:\", res=={\"section_count\":30,\"flagged_count\":flagged,\"personal_narrative_count\":pn,\"protected_lang_count\":pl,\"disclaimer_missing_count\":dm})\nPY" action.permission=* action.action=allow action.pattern=*
