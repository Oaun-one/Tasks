timestamp=2026-08-20T03:14:30.026Z level=INFO run=474eda98 message=evaluated permission=bash pattern="cat > /tmp/opencode/audit.py << 'PYEOF'\nimport csv\nfrom datetime import date\n\nAUDIT = date(2026,3,31)\n\n# Load licence register\nlicences = {}\nwith open('/app/input/licensed_property_register.csv') as f:\n    for r in csv.DictReader(f):\n        licences[r['license_id']] = r\n\n# Build supersession map: superseded_id -> superseding_id\nsupersede = {}\nfor lid, row in licences.items():\n    if row['supersedes'] and row['supersedes'] != 'none':\n        supersede[row['supersedes']] = lid\n\ndef effective(lid):\n    \"\"\"Return (license_type, covers_distribution, valid_until) governing a cited licence id.\"\"\"\n    if lid == 'none' or lid not in licences:\n        return None\n    # if this id is superseded, use superseding row's terms\n    gov = lid\n    if lid in supersede:\n        gov = supersede[lid]\n    g = licences[gov]\n    return (g['license_type'], g['covers_distribution'], g['valid_until'])\n\ndef covers(lid, use_type, dist):\n    eff = effective(lid)\n    if eff is None:\n        return False\n    ltype, cdist, vuntil = eff\n    if ltype != use_type:\n        return False\n    covers_list = cdist.split(';')\n    if 'all' not in covers_list and dist not in covers_list:\n        return False\n    if date.fromisoformat(vuntil) < AUDIT:\n        return False\n    return True\n\naccounts = {}\nwith open('/app/input/client_accounts.csv') as f:\n    for r in csv.DictReader(f):\n        accounts[r['account_id']] = r\n\nrequests = []\nwith open('/app/input/composite_request_log.csv') as f:\n    for r in csv.DictReader(f):\n        requests.append(r)\n\nresults = {}\nacct_counts = {}\n\nfor r in requests:\n    rid = r['request_id']\n    if r['intake_status'] == 'withdrawn':\n        continue\n    acc = accounts[r['account_id']]\n    dist = r['intended_distribution']\n    findings = []\n\n    # §3 character\n    if r['character_property'] != 'none':\n        char_lic = r['character_license_id']\n        cleared_lic = covers(char_lic, 'character', dist) if char_lic != 'none' else False\n        cleared_allow = (dist == 'personal_only')\n        if not (cleared_lic or cleared_allow):\n            findings.append('UNLICENSED_CHARACTER_USE')\n\n    # §4 background\n    bs = r['background_source']\n    if bs == 'customer_original':\n        pass\n    elif bs == 'third_party_unlicensed':\n        findings.append('THIRD_PARTY_BACKGROUND_UNLICENSED')\n    elif bs == 'third_party_licensed':\n        blic = r['background_license_id']\n        if not covers(blic, 'background', dist):\n            findings.append('THIRD_PARTY_BACKGROUND_UNLICENSED')\n\n    # §5 minor consent\n    if r['subject_is_minor'] == 'True':\n        ct = r['minor_consent_type']\n        present = ct != 'none'\n        current = r['minor_consent_valid_until'] != 'none' and date.fromisoformat(r['minor_consent_valid_until']) >= AUDIT\n        if ct == 'publicity':\n            wide = True\n        elif ct == 'basic':\n            wide = dist in ('personal_only','client_internal')\n        else:\n            wide = False\n        if not (present and current and wide):\n            findings.append('MISSING_MINOR_CONSENT')\n\n    # §6 commercial distribution\n    if dist in ('social_public','print_for_sale'):\n        active = acc['agreement_status'] == 'active'\n        cov = acc['master_agreement_covers']\n        named = cov != 'none' and dist in cov.split(';')\n        if not (active and named):\n            findings.append('COMMERCIAL_DISTRIBUTION_FLAG')\n\n    # §7 alteration disclosure\n    if r['alteration_level'] == 'substantive' and dist in ('social_public','print_for_sale'):\n        if r['alteration_disclosure_on_file'] != 'True':\n            findings.append('ALTERATION_DISCLOSURE_MISSING')\n\n    finding_str = '|'.join(findings) if findings else 'none'\n    results[rid] = findings\n\n    a = r['account_id']\n    acct_counts.setdefault(a, {'req':0,'flag':0,'maxf':0})\n    acct_counts[a]['req'] += 1\n    if findings:\n        acct_counts[a]['flag'] += 1\n    acct_counts[a]['maxf'] = max(acct_counts[a]['maxf'], len(findings))\n\n    print(f\"{rid}: {finding_str}\")\n\nprint(\"\\n--- accounts ---\")\ntotal_req = sum(v['req'] for v in acct_counts.values())\ntotal_flag = sum(v['flag'] for v in acct_counts.values())\nbatch_share = total_flag/total_req\nprint(f\"audited={total_req} flagged={total_flag} batch_share={batch_share:.4f}\")\nfor a in sorted(acct_counts):\n    v = acct_counts[a]\n    share = v['flag']/v['req'] if v['req'] else 0\n    esc = (share > batch_share) or (v['maxf'] >= 3)\n    print(f\"{a}: type={accounts[a]['account_type']} req={v['req']} flag={v['flag']} maxf={v['maxf']} share={share:.4f} esc={esc}\")\n\n# per-finding counts\nfrom collections import Counter\nc = Counter()\ntotal_findings = 0\nfor fset in results.values():\n    for f in fset:\n        c[f]+=1\n        total_findings+=1\nprint(\"\\n--- finding counts ---\")\nfor k in ['UNLICENSED_CHARACTER_USE','THIRD_PARTY_BACKGROUND_UNLICENSED','MISSING_MINOR_CONSENT','COMMERCIAL_DISTRIBUTION_FLAG','ALTERATION_DISCLOSURE_MISSING']:\n    print(f\"{k}: {c[k]}\")\nprint(\"total_findings:\", total_findings)\nprint(\"flagged_count:\", total_flag)\nprint(\"compliant:\", total_req - total_flag)\nprint(\"escalated:\", sum(1 for a in acct_counts if (acct_counts[a]['flag']/acct_counts[a]['req'] > batch_share) or acct_counts[a]['maxf']>=3))\nPYEOF" action.permission=* action.action=allow action.pattern=*
