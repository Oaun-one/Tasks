timestamp=2026-08-20T03:44:19.926Z level=INFO run=e0acfc18 message=evaluated permission=bash pattern="python3 -c \"\nimport csv, os\nIN='/app/input'\nprofiles={}; \nfor r in csv.DictReader(open(IN+'/stock_profiles.csv')):\n    profiles[r['stock_code']]=dict(min_dpi=int(r['min_dpi']),min_margin_in=float(r['min_margin_in']),max_ink_pct=int(r['max_ink_pct']),min_bleed_in=float(r['min_bleed_in']))\nsections={}\nfor r in csv.DictReader(open(IN+'/kit_sections.csv')):\n    sections[r['section_id']]=dict(binding=r['binding'],stock_code=r['stock_code'])\nrows=list(csv.DictReader(open(IN+'/activity_kit_pages.csv')))\nbase={'cover':1,'parent_guide':2,'map':4,'activity':4,'mission_cards':6,'bingo':9,'badge_certificate':4}\ndef emin(t,b):\n    m=base[t]\n    if b=='saddle_stitch' and t in ('mission_cards','badge_certificate'): m+=2\n    return m\ndef find(r):\n    sec=sections[r['section_id']]; st=profiles[sec['stock_code']]\n    eff=int(r['artwork_dpi'])*100//int(r['placement_scale_pct'])\n    fb=r['full_bleed_design']=='True'; m=float(r['margin_in']); bl=float(r['bleed_in']); ink=int(r['total_ink_pct']); ec=int(r['element_count']); e=emin(r['page_type'],sec['binding'])\n    f=[]\n    if eff<st['min_dpi']: f.append('DPI_TOO_LOW')\n    if (not fb) and m<st['min_margin_in']: f.append('MARGIN_VIOLATION')\n    if fb and bl<st['min_bleed_in']: f.append('BLEED_SHORT')\n    if ink>st['max_ink_pct']: f.append('INK_OVER')\n    if ec<e: f.append('ELEMENT_COUNT_SHORT')\n    return '|'.join(f) if f else 'none', eff, m, bl, ink, ec, e\n# superseded pairs\npairs=[('PG-04','AW-1004','AW-1034'),('PG-12','AW-1012','AW-1030'),('PG-18','AW-1018','AW-1031'),('PG-27','AW-1027','AW-1032')]\nfor pid,old,new in pairs:\n    ro=[x for x in rows if x['artwork_id']==old][0]\n    rn=[x for x in rows if x['artwork_id']==new][0]\n    print('---',pid,'---')\n    print(' OLD',old, find(ro))\n    print(' NEW',new, find(rn))\n\"" action.permission=* action.action=allow action.pattern=*
