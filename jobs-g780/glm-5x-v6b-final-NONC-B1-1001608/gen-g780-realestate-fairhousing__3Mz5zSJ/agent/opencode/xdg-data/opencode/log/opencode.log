timestamp=2026-08-19T10:35:31.976Z level=INFO run=b53959fc message=evaluated permission=bash pattern="python3 - << 'EOF'\nimport csv, json\nlabels={\"none\",\"PROHIBITED_PERSONAL_NARRATIVE\",\"PROTECTED_CLASS_LANGUAGE\",\"DISCLAIMER_MISSING\"}\nrows=list(csv.reader(open('/app/fairhousing_audit.csv')))\nassert rows[0]==[\"section_id\",\"finding\"], rows[0]\nids=[r[0] for r in rows[1:]]\nassert ids==[f\"SEC-{i:02d}\" for i in range(1,31)], \"order/ids wrong\"\norder=[\"PROHIBITED_PERSONAL_NARRATIVE\",\"PROTECTED_CLASS_LANGUAGE\",\"DISCLAIMER_MISSING\"]\nfor r in rows[1:]:\n    assert len(r)==2, f\"not 2 cols: {r}\"\n    parts=r[1].split(\"|\")\n    assert all(p in labels for p in parts), f\"bad label {r}\"\n    if r[1]!=\"none\":\n        idx=[order.index(p) for p in parts]\n        assert idx==sorted(idx), f\"wrong order {r}\"\nprint(\"CSV OK: 30 rows, exactly 2 cols, valid labels, label order correct\")\nd=json.load(open('/app/results.json'))\nfindings=[r[1] for r in rows[1:]]\nassert d['section_count']==30\nassert d['flagged_count']==sum(1 for f in findings if f!='none')\nassert d['personal_narrative_count']==sum(1 for f in findings if 'PROHIBITED_PERSONAL_NARRATIVE' in f)\nassert d['protected_lang_count']==sum(1 for f in findings if 'PROTECTED_CLASS_LANGUAGE' in f)\nassert d['disclaimer_missing_count']==sum(1 for f in findings if 'DISCLAIMER_MISSING' in f)\nprint(\"results.json OK: all counts consistent with CSV\")\nprint(\"flagged:\", d['flagged_count'], \"| PN:\", d['personal_narrative_count'],\n      \"| PCL:\", d['protected_lang_count'], \"| DM:\", d['disclaimer_missing_count'])\nEOF" action.permission=* action.action=allow action.pattern=*
