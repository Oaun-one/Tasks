timestamp=2026-08-19T09:58:50.380Z level=INFO run=fd0af30a message=evaluated permission=bash pattern="python3 -c \"\nimport csv, re\nrows=list(csv.DictReader(open('input/seller_book_sections.csv')))\nreq={'race','color','colour','religion','sex','familial status','national origin','disability','sexual orientation','veteran status','marital status','source of income'}\nfor r in rows:\n    b=r['body']\n    # extract classes named in any 'does not discriminate on the basis of ...' clause\n    m=re.search(r'does not discriminate on the basis of (.+?)\\.?\\s*$', b)\n    if m:\n        seg=m.group(1)\n        named=re.split(r',|\\sor\\s', seg)\n        named=[x.strip().rstrip('.') for x in named if x.strip()]\n        present=set(x.lower() for x in named)\n        missing=[c for c in ['marital status','source of income','disability','sexual orientation','veteran status'] if c not in present and 'colo'+'ur' not in c]\n        print(r['section_id'], r['role'], '| named:',len(named), '| missing:', missing)\n    else:\n        print(r['section_id'], r['role'], '| NO NOTICE')\n\"" action.permission=* action.action=allow action.pattern=*
