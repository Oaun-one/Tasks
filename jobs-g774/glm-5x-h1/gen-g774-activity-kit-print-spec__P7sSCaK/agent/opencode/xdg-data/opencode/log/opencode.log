timestamp=2026-08-20T03:44:30.494Z level=INFO run=c82c906d message=evaluated permission=bash pattern="cat > /tmp/opencode/deltas.py << 'PYEOF'\nimport csv, math\nfrom collections import defaultdict\nINP=\"/app/input\"\nstocks={}\nwith open(f\"{INP}/stock_profiles.csv\") as f:\n    for r in csv.DictReader(f):\n        stocks[r[\"stock_code\"]]={k:float(v) if k!=\"stock_code\" else v for k,v in r.items()}\n        stocks[r[\"stock_code\"]][\"min_dpi\"]=int(r[\"min_dpi\"]); stocks[r[\"stock_code\"]][\"max_ink_pct\"]=int(r[\"max_ink_pct\"])\nsections={}\nwith open(f\"{INP}/kit_sections.csv\") as f:\n    for r in csv.DictReader(f): sections[r[\"section_id\"]]=r\nbase={\"cover\":1,\"parent_guide\":2,\"map\":4,\"activity\":4,\"mission_cards\":6,\"bingo\":9,\"badge_certificate\":4}\ndef emin(pt,b):\n    m=base[pt]\n    if b==\"saddle_stitch\" and pt in (\"mission_cards\",\"badge_certificate\"): m+=2\n    return m\nrows=[]\nwith open(f\"{INP}/activity_kit_pages.csv\") as f:\n    for r in csv.DictReader(f):\n        r[\"revision\"]=int(r[\"revision\"]); r[\"artwork_dpi\"]=int(r[\"artwork_dpi\"]); r[\"placement_scale_pct\"]=int(r[\"placement_scale_pct\"])\n        rows.append(r)\nby=defaultdict(list)\nfor r in rows: by[r[\"page_id\"]].append(r)\nsup=[]\nfor pid,lst in by.items():\n    s=sorted(lst,key=lambda x:x[\"revision\"])\n    for r in s[:-1]: sup.append((pid,r))\n# pair superseded with their live\nlive={pid:max(by[pid],key=lambda x:x[\"revision\"]) for pid in by}\nprint(\"=== SUPERSESSION DELTAS ===\")\nfor pid,old in sup:\n    new=live[pid]\n    sec=sections[new[\"section_id\"]]; st=stocks[sec[\"stock_code\"]]\n    def eff(r): return math.floor(int(r[\"artwork_dpi\"])*100/int(r[\"placement_scale_pct\"]))\n    print(f\"\\n{pid}: {old['artwork_id']} r{old['revision']}  ->  {new['artwork_id']} r{new['revision']}  [{sec['binding']}/{sec['stock_code']}]\")\n    print(f\"  dpi:  eff {eff(old)} -> {eff(new)}   (min {int(st['min_dpi'])})\")\n    print(f\"  margin: {old['margin_in']} -> {new['margin_in']}   (min {st['min_margin_in']})\")\n    print(f\"  bleed:  {old['bleed_in']} -> {new['bleed_in']}  fb {old['full_bleed_design']}->{new['full_bleed_design']}  (min {st['min_bleed_in']})\")\n    print(f\"  ink:    {old['total_ink_pct']} -> {new['total_ink_pct']}   (max {int(st['max_ink_pct'])})\")\n    print(f\"  elem:   {old['element_count']} -> {new['element_count']}   (min {emin(new['page_type'],sec['binding'])})\")\nPYEOF" action.permission=* action.action=allow action.pattern=*
