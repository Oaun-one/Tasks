timestamp=2026-08-19T10:17:52.536Z level=INFO run=dd1dfccf message=evaluated permission=bash pattern="python3 - <<'PY'\nimport csv, re\n\nrequired = [\"race\",\"color\",\"religion\",\"sex\",\"familial status\",\"national origin\",\n            \"disability\",\"sexual orientation\",\"veteran status\",\"marital status\",\"source of income\"]\n\ndef notice_classes(body):\n    # grab the \"does not discriminate on the basis of X\" clause\n    m = re.search(r\"does not discriminate on the basis of (.*?)\\.?\\s*$\", body)\n    if not m: return None\n    clause = m.group(1)\n    # split on commas and \"or\"\n    parts = re.split(r\",|\\bor\\b\", clause)\n    found=[]\n    for p in parts:\n        p=p.strip().rstrip(\".\").strip().lower()\n        for c in required:\n            if c in p and c not in found:\n                found.append(c)\n    return found\n\nrows=[]\nwith open(\"input/seller_book_sections.csv\") as f:\n    r=csv.DictReader(f)\n    for row in r: rows.append(row)\n\nfor row in rows:\n    nc=notice_classes(row[\"body\"])\n    has_notice = nc is not None\n    complete = has_notice and all(c in nc for c in required)\n    print(row[\"section_id\"], row[\"role\"], \"| notice_classes=\", nc, \"| complete=\", complete)\nPY" action.permission=* action.action=allow action.pattern=*
