timestamp=2026-08-20T02:55:43.844Z level=INFO run=8e75bdb8 message=evaluated permission=bash pattern="python3 - <<'PY'\nimport csv, json\nfrom datetime import date\n\nAUDIT = date(2026,3,31)\n\ndef parse_date(s):\n    if not s or s == \"none\": return None\n    y,m,d = s.split(\"-\"); return date(int(y),int(m),int(d))\n\n# --- load register, build effective terms accounting for supersession ---\nreg = {}\nwith open(\"/app/input/licensed_property_register.csv\") as f:\n    for r in csv.DictReader(f):\n        reg[r[\"license_id\"]] = r\neffective = {lid: dict(row) for lid,row in reg.items()}   # own terms first\nfor lid,row in reg.items():\n    sup = row[\"supersedes\"]\n    if sup and sup != \"none\":\n        effective[sup] = dict(row)      # superseded id -> superseding row's terms\n        effective[lid] = dict(row)       # superseding id -> own terms\n\ndef covers(lic_id, ltype, distribution):\n    \"\"\"§2 coverage test.\"\"\"\n    if lic_id == \"none\" or lic_id == \"\": return None\n    row = effective.get(lic_id)\n    if row is None: return None            # id not in register\n    if row[\"license_type\"] != ltype: return None\n    cov = row[\"covers_distribution\"]\n    if cov != \"all\" and distribution not in cov.split(\";\"): return None\n    vu = parse_date(row[\"valid_until\"])\n    if vu is None or vu < AUDIT: return None\n    return lic_id   # returns the governing licence id\n\n# --- load accounts ---\naccts = {}\nwith open(\"/app/input/client_accounts.csv\") as f:\n    for r in csv.DictReader(f):\n        cov = r[\"master_agreement_covers\"]\n        covers_set = set() if cov == \"none\" else set(cov.split(\";\"))\n        accts[r[\"account_id\"]] = {\n            \"account_type\": r[\"account_type\"],\n            \"covers\": covers_set,\n            \"status\": r[\"agreement_status\"],\n        }\n\ndef channel_cleared(acc_id, dist):\n    a = accts[acc_id]\n    return a[\"status\"] == \"active\" and dist in a[\"covers\"]\n\nCANON = [\"UNLICENSED_CHARACTER_USE\",\"THIRD_PARTY_BACKGROUND_UNLICENSED\",\n         \"MISSING_MINOR_CONSENT\",\"COMMERCIAL_DISTRIBUTION_FLAG\",\n         \"ALTERATION_DISCLOSURE_MISSING\"]\n\nrows = []\nwith open(\"/app/input/composite_request_log.csv\") as f:\n    for r in csv.DictReader(f):\n        rows.append(r)\n\naudit_rows = []\nper_req = {}\nfor r in rows:\n    if r[\"intake_status\"] == \"withdrawn\":\n        continue\n    rid = r[\"request_id\"]; acc = r[\"account_id\"]; dist = r[\"intended_distribution\"]\n    findings = set()\n\n    # §3 character\n    if r[\"character_property\"] != \"none\":\n        cleared = False\n        if covers(r[\"character_license_id\"], \"character\", dist):\n            cleared = True\n        if dist == \"personal_only\":\n            cleared = True\n        if not cleared:\n            findings.add(\"UNLICENSED_CHARACTER_USE\")\n\n    # §4 background\n    bs = r[\"background_source\"]\n    if bs == \"third_party_unlicensed\":\n        findings.add(\"THIRD_PARTY_BACKGROUND_UNLICENSED\")\n    elif bs == \"third_party_licensed\":\n        if not covers(r[\"background_license_id\"], \"background\", dist):\n            findings.add(\"THIRD_PARTY_BACKGROUND_UNLICENSED\")\n\n    # §5 minor consent\n    if r[\"subject_is_minor\"] == \"True\":\n        ct = r[\"minor_consent_type\"]\n        vu = parse_date(r[\"minor_consent_valid_until\"])\n        present = ct != \"none\"\n        current = vu is not None and vu >= AUDIT\n        if ct == \"basic\":\n            wide = dist in (\"personal_only\",\"client_internal\")\n        elif ct == \"publicity\":\n            wide = True\n        else:\n            wide = False\n        if not (present and current and wide):\n            findings.add(\"MISSING_MINOR_CONSENT\")\n\n    # §6 commercial distribution\n    if dist in (\"social_public\",\"print_for_sale\"):\n        if not channel_cleared(acc, dist):\n            findings.add(\"COMMERCIAL_DISTRIBUTION_FLAG\")\n\n    # §7 alteration disclosure\n    if r[\"alteration_level\"] == \"substantive\" and dist in (\"social_public\",\"print_for_sale\"):\n        if r[\"alteration_disclosure_on_file\"] != \"True\":\n            findings.add(\"ALTERATION_DISCLOSURE_MISSING\")\n\n    ordered = [c for c in CANON if c in findings]\n    finding = \"|\".join(ordered) if ordered else \"none\"\n    per_req[rid] = ordered\n    audit_rows.append((rid, finding, acc, ordered))\n\n# --- write audit csv ---\nwith open(\"/app/composite_request_audit.csv\",\"w\",newline=\"\") as f:\n    w = csv.writer(f); w.writerow([\"request_id\",\"finding\"])\n    for rid,finding,acc,ord_ in audit_rows:\n        w.writerow([rid,finding])\n\n# --- account summary ---\nbatch_flagged = sum(1 for _,_,_,o in audit_rows if o)\nbatch_total = len(audit_rows)\nbatch_share = batch_flagged/batch_total\n\nacct_reqs = {}; acct_flag = {}\nfor rid,finding,acc,o in audit_rows:\n    acct_reqs.setdefault(acc,0); acct_reqs[acc]+=1\n    if o:\n        acct_flag.setdefault(acc,0); acct_flag[acc]+=1\n    else:\n        acct_flag.setdefault(acc,0)\n\nsumm = []\nfor acc in sorted(accts):\n    rc = acct_reqs.get(acc,0)\n    fc = acct_flag.get(acc,0)\n    share = fc/rc if rc else 0\n    has3 = any(len(o)>=3 for _,_,a,o in audit_rows if a==acc)\n    esc = \"ESCALATION_REQUIRED\" if (share > batch_share or has3) else \"none\"\n    summ.append((acc, accts[acc][\"account_type\"], rc, fc, esc))\n\nwith open(\"/app/account_summary.csv\",\"w\",newline=\"\") as f:\n    w = csv.writer(f); w.writerow([\"account_id\",\"account_type\",\"request_count\",\"flagged_requests\",\"escalation\"])\n    for row in summ: w.writerow(row)\n\n# --- results.json ---\nfc_total = sum(len(o) for _,_,_,o in audit_rows)\nflagged = sum(1 for _,_,_,o in audit_rows if o)\ncompliant = batch_total - flagged\ndef cnt(code): return sum(1 for _,_,_,o in audit_rows if code in o)\nres = {\n \"request_count\": batch_total,\n \"account_count\": len(accts),\n \"flagged_count\": flagged,\n \"compliant_count\": compliant,\n \"finding_total\": fc_total,\n \"character_count\": cnt(\"UNLICENSED_CHARACTER_USE\"),\n \"background_count\": cnt(\"THIRD_PARTY_BACKGROUND_UNLICENSED\"),\n \"consent_count\": cnt(\"MISSING_MINOR_CONSENT\"),\n \"commercial_count\": cnt(\"COMMERCIAL_DISTRIBUTION_FLAG\"),\n \"disclosure_count\": cnt(\"ALTERATION_DISCLOSURE_MISSING\"),\n \"escalated_accounts\": sum(1 for r in summ if r[4]==\"ESCALATION_REQUIRED\"),\n}\nwith open(\"/app/results.json\",\"w\") as f:\n    json.dump(res,f,indent=2)\n\nprint(\"batch_share =\", batch_flagged,\"/\",batch_total,\"=\",round(batch_share,4))\nprint(json.dumps(res,indent=2))\nprint(\"\\n--- per account ---\")\nfor r in summ: print(r)\nprint(\"\\n--- findings ---\")\nfor rid,finding,acc,o in audit_rows:\n    if o: print(rid, acc, finding)\nPY" action.permission=* action.action=allow action.pattern=*
