timestamp=2026-08-19T14:23:22.005Z level=INFO run=bbf3b359 message=evaluated permission=bash pattern="python3 << 'EOF'\nimport json, csv\nrows = list(csv.DictReader(open('fairhousing_audit.csv')))\nn = len(rows)\nflagged = [r for r in rows if r['finding'] != 'none']\npn = [r for r in rows if 'PROHIBITED_PERSONAL_NARRATIVE' in r['finding']]\npl = [r for r in rows if 'PROTECTED_CLASS_LANGUAGE' in r['finding']]\ndm = [r for r in rows if 'DISCLAIMER_MISSING' in r['finding']]\nderived = {\n  'section_count': n,\n  'flagged_count': len(flagged),\n  'personal_narrative_count': len(pn),\n  'protected_lang_count': len(pl),\n  'disclaimer_missing_count': len(dm),\n}\ndisk = json.load(open('results.json'))\nprint('derived:', derived)\nprint('disk:  ', disk)\nprint('MATCH:', derived == disk)\n# verify order = inventory order\nids = [r['section_id'] for r in rows]\nprint('order ok:', ids == sorted(ids, key=lambda s: int(s.split('-')[1])))\n# verify label order in multi-finding rows\norder = ['PROHIBITED_PERSONAL_NARRATIVE','PROTECTED_CLASS_LANGUAGE','DISCLAIMER_MISSING']\nbad = []\nfor r in rows:\n    parts = r['finding'].split('|')\n    if parts != ['none'] and parts != [p for p in order if p in r['finding']]:\n        bad.append(r['section_id']+': '+r['finding'])\nprint('label-order issues:', bad if bad else 'none')\nEOF" action.permission=* action.action=allow action.pattern=*
