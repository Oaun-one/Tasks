timestamp=2026-08-19T20:09:33.410Z level=INFO run=d1486552 message=evaluated permission=bash pattern="python3 -c \"\nLANDSCAPE_W=29.7; BE=3.0\nfor t,o in [('ARCHIVE',2.5),('READING',2.0)]:\n    print(t, 'landscape-annex oversized-table threshold =', round(LANDSCAPE_W-BE-o,2), 'cm')\n# Verify implied outer for key landscape annexes\nprint()\nfor sid,inner,tbw,wt,tpl_outer in [\n ('AN-01',3.0,25.5,26.0,2.0),('AN-02',3.0,25.2,24.9,2.0),('AN-03',3.0,25.1,24.4,2.0),\n ('AN-05',3.0,25.7,27.0,2.0),('AN-06',2.7,25.9,28.0,2.0),('AN-07',3.0,25.4,25.5,2.0),\n ('AN-08',3.0,25.5,26.5,2.0),('AN-15',3.0,25.3,24.7,2.0),\n ('AN-09',3.0,25.0,24.3,2.5),('AN-10',2.85,24.95,24.1,2.5),('AN-12',3.0,25.2,25.0,2.5)]:\n    outer=round(29.7-inner-tbw,2)\n    thr=round(29.7-3.0-(2.0 if tpl_outer==2.0 else 2.5),2)\n    rel = wt>thr\n    breach = outer < tpl_outer\n    print(f'{sid}: outer={outer} vs min_outer={tpl_outer} breach={breach}; wt={wt} vs thr={thr} released={rel}')\nprint()\nprint('AN-13 leading 18.04 -> diff', round(abs(18.04-18.0),4), 'tol 0.05')\nprint('AN-15 wt 24.7 vs READING thr 24.7 -> strictly greater?', 24.7>24.7)\nprint('AN-09 wt 24.3 vs ARCHIVE thr 24.2 ->', 24.3>24.2, ' vs READING thr 24.7 ->', 24.3>24.7)\n\"" action.permission=* action.action=allow action.pattern=*
