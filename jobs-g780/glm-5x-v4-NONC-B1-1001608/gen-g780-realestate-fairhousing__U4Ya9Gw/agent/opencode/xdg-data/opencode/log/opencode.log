timestamp=2026-08-19T09:46:04.899Z level=INFO run=0d9499a4 message=evaluated permission=bash pattern="python3 -c \"\nimport json, csv\n# JSON valid + print\nd = json.load(open('/app/results.json'))\nprint('JSON OK:', d)\n# CSV: exactly 2 cols, header + 11 rows\nrows = list(csv.reader(open('/app/fairhousing_audit.csv')))\nprint('CSV rows (incl header):', len(rows))\nassert rows[0] == ['section_id','finding'], rows[0]\nfor r in rows:\n    assert len(r)==2, ('bad cols', r)\nids = [r[0] for r in rows[1:]]\nassert ids == [f'SEC-{i:02d}' for i in range(1,12)], ids\nprint('CSV 2-col + inventory order OK')\n# Reconcile counts from CSV\nfrom collections import Counter\nlabels = Counter(); flagged=0\nfor sid,f in rows[1:]:\n    if f!='none':\n        flagged+=1\n        for lab in f.split('|'):\n            labels[lab]+=1\nprint('flagged:', flagged, 'PN:', labels['PROHIBITED_PERSONAL_NARRATIVE'], 'PCL:', labels['PROTECTED_CLASS_LANGUAGE'], 'DM:', labels['DISCLAIMER_MISSING'])\nassert d['section_count']==11 and d['flagged_count']==flagged==7\nassert d['personal_narrative_count']==labels['PROHIBITED_PERSONAL_NARRATIVE']==3\nassert d['protected_lang_count']==labels['PROTECTED_CLASS_LANGUAGE']==4\nassert d['disclaimer_missing_count']==labels['DISCLAIMER_MISSING']==3\nprint('ALL CHECKS PASSED')\n\"" action.permission=* action.action=allow action.pattern=*
