timestamp=2026-08-18T22:40:34.557Z level=INFO run=f74787b5 message=evaluated permission=bash pattern="python3 -c \"\nimport json, csv\n# validate JSON\nwith open('/app/results.json') as f:\n    r = json.load(f)\nprint('results.json:', r)\nassert set(r) == {'section_count','flagged_count','personal_narrative_count','protected_lang_count','disclaimer_missing_count'}, r\n# validate CSV: exactly 2 cols, 7 rows + header, order matches\nwith open('/app/fairhousing_audit.csv') as f:\n    rows = list(csv.reader(f))\nprint('csv rows:', rows)\nassert rows[0] == ['section_id','finding'], rows[0]\nassert all(len(r)==2 for r in rows), 'must be exactly 2 columns'\nassert len(rows)==8, 'header + 7 sections'\n# cross-check counts\nfinds = {r[0]: r[1] for r in rows[1:]}\npn = sum('PROHIBITED_PERSONAL_NARRATIVE' in v for v in finds.values())\npcl = sum('PROTECTED_CLASS_LANGUAGE' in v for v in finds.values())\ndm = sum('DISCLAIMER_MISSING' in v for v in finds.values())\nflagged = sum(1 for v in finds.values() if v!='none')\nprint('derived counts:', {'section_count':len(finds),'flagged_count':flagged,'personal_narrative_count':pn,'protected_lang_count':pcl,'disclaimer_missing_count':dm})\nassert r['section_count']==len(finds)==7\nassert r['flagged_count']==flagged==4\nassert r['personal_narrative_count']==pn==2\nassert r['protected_lang_count']==pcl==2\nassert r['disclaimer_missing_count']==dm==2\nprint('ALL CHECKS PASSED')\n\"" action.permission=* action.action=allow action.pattern=*
