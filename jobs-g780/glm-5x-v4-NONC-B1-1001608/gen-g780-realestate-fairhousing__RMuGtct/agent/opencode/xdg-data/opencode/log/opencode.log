timestamp=2026-08-19T09:45:17.488Z level=INFO run=8e18d7c5 message=evaluated permission=bash pattern="python3 - <<'PY'\nimport csv, json\n\n# CSV shape check\nwith open('/app/fairhousing_audit.csv', newline='') as f:\n    rows = list(csv.reader(f))\nassert rows[0] == ['section_id', 'finding'], rows[0]\ndata = rows[1:]\nassert all(len(r) == 2 for r in data), [r for r in data if len(r) != 2]\nassert len(data) == 11, len(data)\n\n# Derive counts (by section, not by label)\norder = ['PROHIBITED_PERSONAL_NARRATIVE', 'PROTECTED_CLASS_LANGUAGE', 'DISCLAIMER_MISSING']\nflagged = [r for r in data if r[1] != 'none']\npn = [r for r in data if 'PROHIBITED_PERSONAL_NARRATIVE' in r[1].split('|')]\npl = [r for r in data if 'PROTECTED_CLASS_LANGUAGE' in r[1].split('|')]\ndm = [r for r in data if 'DISCLAIMER_MISSING' in r[1].split('|')]\nderived = {\n    'section_count': len(data),\n    'flagged_count': len(flagged),\n    'personal_narrative_count': len(pn),\n    'protected_lang_count': len(pl),\n    'disclaimer_missing_count': len(dm),\n}\n\n# JSON parse + match\nwith open('/app/results.json') as f:\n    res = json.load(f)\nassert res == derived, (res, derived)\n\n# label-order check on multi-finding rows\nfor sid, finding in data:\n    labels = finding.split('|')\n    if len(labels) > 1:\n        assert labels == [l for l in order if l in labels], (sid, labels)\n\nprint('OK: CSV 2-col x11, JSON valid, counts match, label order correct')\nprint(json.dumps(derived))\nPY" action.permission=* action.action=allow action.pattern=*
