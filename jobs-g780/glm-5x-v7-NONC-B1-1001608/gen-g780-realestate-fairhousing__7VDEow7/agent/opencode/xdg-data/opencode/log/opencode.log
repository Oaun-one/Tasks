timestamp=2026-08-19T12:38:19.543Z level=INFO run=e7dfec69 message=evaluated permission=bash pattern="cat > /tmp/opencode/audit.py << 'PYEOF'\nimport csv, re, json\n\nrequired = [\"race\",\"color\",\"religion\",\"sex\",\"familial status\",\"national origin\",\n            \"disability\",\"sexual orientation\",\"veteran status\",\"marital status\",\"source of income\"]\nprotected2 = [\"race\",\"color\",\"religion\",\"sex\",\"familial status\",\"national origin\",\n              \"disability\",\"sexual orientation\",\"veteran status\"]  # §2 classes only\nresponsible_roles = {\"closing_page\",\"agent_bio\"}  # §4 + 5b\n\ndef classes_in_notice(body):\n    m = re.search(r\"does not discriminate on the basis of (.+?)\\.\\s*$\", body)\n    if not m: return None  # no notice\n    clause = m.group(1).lower()\n    # normalize separators: \"or\"/\"and\"/\",\"\n    found = []\n    # split on commas and on \" or \" / \" and \"\n    parts = re.split(r\",|\\bor\\b|\\band\\b\", clause)\n    for p in parts:\n        p = p.strip().rstrip('.')\n        for c in required:\n            if c == p:\n                found.append(c); break\n    return found\n\ndef has_notice(body):\n    return \"does not discriminate on the basis of\" in body\n\n# heuristic protected-class detection in prose (outside the notice)\ndef protected_in_prose(body):\n    # strip the notice portion if present\n    prose = re.sub(r\"This brokerage complies.*?does not discriminate on the basis of.*?\\.\\s*$\",\"\",body,flags=re.DOTALL).lower()\n    hits=[]\n    fam = any(t in prose for t in [\"family-oriented\",\"families\",\"young families\",\"toddler\",\"households\"])\n    rel = any(t in prose for t in [\"church\",\"churchgoing\",\"parish\",\"faith\",\"congregation\",\"worship\"])\n    if fam: hits.append(\"familial status\")\n    if rel: hits.append(\"religion\")\n    return hits\n\ndef personal_narrative(body):\n    b = body.lower()\n    triggers = [\"write us a letter\",\"personal note about yourself\",\"personal note about themselves\",\n                \"covering letter introducing yourself\",\"letter about what brought you\"]\n    return any(t in b for t in triggers)\n\nrows=[]\nwith open(\"/app/input/seller_book_sections.csv\") as f:\n    for r in csv.DictReader(f):\n        rows.append(r)\n\nout=[]\nfor r in rows:\n    sid=r[\"section_id\"]; role=r[\"role\"]; body=r[\"body\"]\n    findings=[]\n    # §1\n    if personal_narrative(body): findings.append(\"PROHIBITED_PERSONAL_NARRATIVE\")\n    # §2\n    notice_cls = classes_in_notice(body)\n    prose_hits = protected_in_prose(body)\n    pcl = False\n    if prose_hits: pcl = True\n    if notice_cls is not None:\n        # abridged? (must contain ALL 11)\n        complete = set(notice_cls)==set(required)\n        if not complete:\n            pcl = True  # abridged -> no exemption -> notice terms count\n        # if complete, notice terms are exempt -> don't set pcl from notice\n    if pcl: findings.append(\"PROTECTED_CLASS_LANGUAGE\")\n    # §4\n    if role in responsible_roles:\n        if notice_cls is None or set(notice_cls)!=set(required):\n            findings.append(\"DISCLAIMER_MISSING\")\n    out.append((sid, findings, role, notice_cls, prose_hits))\n\nfor sid,findings,role,nc,ph in out:\n    print(f\"{sid}\\t{role:16s}\\t{'|'.join(findings) if findings else 'none':55s}\\tnotice={nc}\\tprose={ph}\")\n\nprint(\"\\n--- counts ---\")\nsc=len(out)\nflagged=sum(1 for _,f,_,_,_ in out if f)\npn=sum(1 for _,f,_,_,_ in out if \"PROHIBITED_PERSONAL_NARRATIVE\" in f)\npcl=sum(1 for _,f,_,_,_ in out if \"PROTECTED_CLASS_LANGUAGE\" in f)\ndm=sum(1 for _,f,_,_,_ in out if \"DISCLAIMER_MISSING\" in f)\nprint(f\"section_count={sc} flagged={flagged} pn={pn} pcl={pcl} dm={dm}\")\nprint(\"none:\",[s for s,f,_,_,_ in out if not f])\nPYEOF" action.permission=* action.action=allow action.pattern=*
