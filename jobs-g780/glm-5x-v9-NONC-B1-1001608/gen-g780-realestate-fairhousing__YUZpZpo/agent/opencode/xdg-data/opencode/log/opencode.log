timestamp=2026-08-19T13:42:32.511Z level=INFO run=911e7a7a message=evaluated permission=bash pattern="python3 -c \"\nimport csv\nwith open('fairhousing_audit.csv', newline='') as f:\n    rows = list(csv.reader(f))\nhdr = rows[0]; data = rows[1:]\nassert hdr == ['section_id','finding'], hdr\nassert all(len(r)==2 for r in rows), 'some row not 2 cols'\nassert len(data)==30, len(data)\nassert [r[0] for r in data] == [f'SEC-{i:02d}' for i in range(1,31)], 'order'\nallowed = {'none','PROHIBITED_PERSONAL_NARRATIVE','PROTECTED_CLASS_LANGUAGE','DISCLAIMER_MISSING'}\nfor sid,finding in data:\n    for lab in finding.split('|'):\n        assert lab in allowed, (sid,lab)\n# join order check\norder=['PROHIBITED_PERSONAL_NARRATIVE','PROTECTED_CLASS_LANGUAGE','DISCLAIMER_MISSING']\nfor sid,finding in data:\n    if finding!='none':\n        labs=finding.split('|')\n        assert labs==[l for l in order if l in labs], (sid,labs)\nprint('CSV OK: 2 cols, header + 30 rows, inventory order, valid labels, correct join order')\nimport json\nj=json.load(open('results.json'))\nassert set(j)=={'section_count','flagged_count','personal_narrative_count','protected_lang_count','disclaimer_missing_count'}\nassert [j['section_count'],j['flagged_count'],j['personal_narrative_count'],j['protected_lang_count'],j['disclaimer_missing_count']]==[30,22,7,14,11]\n# cross-check counts against CSV\nfrom collections import Counter\nc=Counter()\nflag=0\nfor sid,finding in data:\n    if finding!='none':\n        flag+=1\n        for lab in finding.split('|'): c[lab]+=1\nassert flag==j['flagged_count']\nassert c['PROHIBITED_PERSONAL_NARRATIVE']==j['personal_narrative_count']\nassert c['PROTECTED_CLASS_LANGUAGE']==j['protected_lang_count']\nassert c['DISCLAIMER_MISSING']==j['disclaimer_missing_count']\nprint('JSON OK: 5 keys, counts consistent with CSV')\n\"" action.permission=* action.action=allow action.pattern=*
