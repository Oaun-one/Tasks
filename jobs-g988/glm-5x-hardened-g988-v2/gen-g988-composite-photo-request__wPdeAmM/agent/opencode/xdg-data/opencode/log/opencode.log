timestamp=2026-08-20T03:15:09.979Z level=INFO run=474eda98 message=evaluated permission=bash pattern="cat > /tmp/opencode/check.py << 'PYEOF'\nimport csv\nfrom datetime import date\nAUDIT = date(2026,3,31)\nlicences={}\nfor r in csv.DictReader(open('/app/input/licensed_property_register.csv')): licences[r['license_id']]=r\nsupersede={row['supersedes']:lid for lid,row in licences.items() if row['supersedes']!='none'}\ndef effective(lid):\n    if lid=='none' or lid not in licences: return None\n    gov=supersede.get(lid,lid); g=licences[gov]\n    return (g['license_type'],g['covers_distribution'],g['valid_until'])\ndef covers(lid,ut,dist):\n    eff=effective(lid)\n    if eff is None: return False\n    lt,cd,vu=eff\n    if lt!=ut: return False\n    if 'all' not in cd.split(';') and dist not in cd.split(';'): return False\n    if date.fromisoformat(vu)<AUDIT: return False\n    return True\naccounts={r['account_id']:r for r in csv.DictReader(open('/app/input/client_accounts.csv'))}\nexp={}\nac={}\nfor r in csv.DictReader(open('/app/input/composite_request_log.csv')):\n    if r['intake_status']=='withdrawn': continue\n    rid=r['request_id']; acc=accounts[r['account_id']]; dist=r['intended_distribution']; f=[]\n    if r['character_property']!='none':\n        cl=r['character_license_id']\n        if not((cl!='none' and covers(cl,'character',dist)) or dist=='personal_only'): f.append('UNLICENSED_CHARACTER_USE')\n    if r['background_source']=='third_party_unlicensed': f.append('THIRD_PARTY_BACKGROUND_UNLICENSED')\n    elif r['background_source']=='third_party_licensed':\n        if not covers(r['background_license_id'],'background',dist): f.append('THIRD_PARTY_BACKGROUND_UNLICENSED')\n    if r['subject_is_minor']=='True':\n        ct=r['minor_consent_type']; pr=ct!='none'\n        cu=r['minor_consent_valid_until']!='none' and date.fromisoformat(r['minor_consent_valid_until'])>=AUDIT\n        w = (ct=='publicity') or (ct=='basic' and dist in ('personal_only','client_internal'))\n        if not(pr and cu and w): f.append('MISSING_MINOR_CONSENT')\n    if dist in ('social_public','print_for_sale'):\n        a=acc; named=a['agreement_status']=='active' and a['master_agreement_covers']!='none' and dist in a['master_agreement_covers'].split(';')\n        if not named: f.append('COMMERCIAL_DISTRIBUTION_FLAG')\n    if r['alteration_level']=='substantive' and dist in ('social_public','print_for_sale') and r['alteration_disclosure_on_file']!='True':\n        f.append('ALTERATION_DISCLOSURE_MISSING')\n    exp[rid]='|'.join(f) if f else 'none'\n    x=ac.setdefault(r['account_id'],{'req':0,'flag':0,'maxf':0}); x['req']+=1\n    if f: x['flag']+=1\n    x['maxf']=max(x['maxf'],len(f))\n\n# compare audit csv\ngot={r['request_id']:r['finding'] for r in csv.DictReader(open('/app/composite_request_audit.csv'))}\nassert set(got)==set(exp), (set(got)^set(exp))\nfor k in exp:\n    assert got[k]==exp[k], (k, got[k], exp[k])\nprint(\"AUDIT CSV matches computed:\", True)\n\n# compare account csv\nbsh=sum(v['flag'] for v in ac.values())/sum(v['req'] for v in ac.values())\ngot_ac={r['account_id']:r for r in csv.DictReader(open('/app/account_summary.csv'))}\nassert set(got_ac)==set(ac), (set(got_ac)^set(ac))\nfor aid,v in ac.items():\n    g=got_ac[aid]\n    assert g['account_type']==accounts[aid]['account_type'], aid\n    assert int(g['request_count'])==v['req'], aid\n    assert int(g['flagged_requests'])==v['flag'], aid\n    sh=v['flag']/v['req']\n    esc=(sh>bsh) or (v['maxf']>=3)\n    want='ESCALATION_REQUIRED' if esc else 'none'\n    assert g['escalation']==want, (aid, g['escalation'], want)\nprint(\"ACCOUNT CSV matches computed:\", True)\nprint(\"All deliverables consistent with policy.\")\nPYEOF" action.permission=* action.action=allow action.pattern=*
