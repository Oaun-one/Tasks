timestamp=2026-08-19T20:10:29.093Z level=INFO run=d1486552 message=evaluated permission=bash pattern="python3 -c \"\nimport csv, json\nrows=list(csv.DictReader(open('formatting_audit.csv')))\nparts=list(csv.DictReader(open('part_summary.csv')))\nr=json.load(open('results.json'))\ncodes=['MARGIN_NONCOMPLIANT','TYPE_AREA_INVALID','LEADING_NONCOMPLIANT','FONT_NONCOMPLIANT','HEADING_STYLE_INVALID','CAPTION_MISSING','NUMBERING_INVALID']\nassert len(rows)==r['section_count'], (len(rows), r['section_count'])\nassert len(parts)==r['part_count']\nflagged=[x for x in rows if x['finding']!='none']\nclean=[x for x in rows if x['finding']=='none']\nassert len(flagged)==r['flagged_section_count'], (len(flagged),r['flagged_section_count'])\nassert len(clean)==r['clean_section_count']\nft=0; cc={c:0 for c in codes}\nfor x in flagged:\n    for c in x['finding'].split('|'):\n        ft+=1; cc[c]+=1\nassert ft==r['finding_total'], (ft,r['finding_total'])\nfor c in codes:\n    key=c.lower().replace('_noncompliant','').replace('_invalid','').replace('_missing','')+'_count'\n    # map names\nassert cc[c]==r[{ 'MARGIN_NONCOMPLIANT':'margin_count','TYPE_AREA_INVALID':'type_area_count','LEADING_NONCOMPLIANT':'leading_count','FONT_NONCOMPLIANT':'font_count','HEADING_STYLE_INVALID':'heading_count','CAPTION_MISSING':'caption_missing_count','NUMBERING_INVALID':'numbering_count'}[c]], (c, cc[c])\nassert sum(p['section_count'] for p in parts)==r['section_count']\nassert sum(p['flagged_sections'] for p in parts)==r['flagged_section_count']\ninv=[p for p in parts if p['pagination']=='PAGINATION_INVALID']\nassert len(inv)==r['pagination_invalid_parts'], (len(inv),r['pagination_invalid_parts'])\nassert sum(p['section_count'] for p in inv)==r['sections_in_invalid_parts']\nassert all(p['pagination'] in ('none','PAGINATION_INVALID') for p in parts)\nprint('All cross-checks passed.')\nprint('pagination_invalid parts:', [p['part_id']+'@p'+str(p['start_page']) for p in inv])\n\"" action.permission=* action.action=allow action.pattern=*
