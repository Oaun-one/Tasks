timestamp=2026-08-19T10:18:07.993Z level=INFO run=dd1dfccf message=evaluated permission=bash pattern="python3 - <<'PY'\nimport csv, re, json\n\nrequired = [\"race\",\"color\",\"religion\",\"sex\",\"familial status\",\"national origin\",\n            \"disability\",\"sexual orientation\",\"veteran status\",\"marital status\",\"source of income\"]\nRESPONSIBLE = {\"closing_page\",\"agent_bio\"}  # §4 + §5b\n\ndef notice_classes(body):\n    m = re.search(r\"does not discriminate on the basis of (.*?)\\.?\\s*$\", body)\n    if not m: return None\n    clause = m.group(1).lower()\n    found=[]\n    for c in required:\n        if c in clause: found.append(c)\n    return found\n\ndef has_complete_notice(body):\n    nc = notice_classes(body)\n    if nc is None: return False, False  # has_notice, complete\n    return True, all(c in nc for c in required)\n\ndef split_notice(body):\n    marker = \"This brokerage complies with the federal Fair Housing Act\"\n    i = body.find(marker)\n    if i == -1: return body, \"\"\n    return body[:i], body[i:]\n\ndef personal_narrative(body):\n    pat = (r\"write us a letter|tell us about yourselves|personal note|covering letter|\"\n           r\"what brought you here|what this home would mean|why this home suits|\"\n           r\"introducing yourself|who is buying|love letter\")\n    return bool(re.search(pat, body, re.I))\n\ndef prose_protected(prose):\n    p = prose.lower()\n    religion = bool(re.search(r\"church\\w*|parish|congregation|faith community|house of worship\", p))\n    familial = bool(re.search(r\"family-oriented|families|toddler\", p))\n    bare = bool(re.search(r\"\\b(race|colour|color|religion|sex|familial status|national origin|\"\n                          r\"disability|sexual orientation|veteran status|marital status|\"\n                          r\"source of income)\\b\", p))\n    return religion or familial or bare\n\nrows=[]\nwith open(\"input/seller_book_sections.csv\") as f:\n    for row in csv.DictReader(f): rows.append(row)\n\nout=[]\nfor row in rows:\n    sid, role, body = row[\"section_id\"], row[\"role\"], row[\"body\"]\n    prose, _ = split_notice(body)\n    has_notice, complete = has_complete_notice(body)\n    f=[]\n    if personal_narrative(body): f.append(\"PROHIBITED_PERSONAL_NARRATIVE\")\n    protected = prose_protected(prose)           # prose never exempt (§3)\n    if has_notice and not complete:              # abridged notice -> no §3 exemption -> its named classes trip §2\n        protected = True\n    if protected: f.append(\"PROTECTED_CLASS_LANGUAGE\")\n    if role in RESPONSIBLE and not complete:    # §4 (closing_page) + §5b (agent_bio)\n        f.append(\"DISCLAIMER_MISSING\")\n    out.append((sid, \"|\".join(f) if f else \"none\", role))\n\n# write CSV\nwith open(\"fairhousing_audit.csv\",\"w\",newline=\"\") as f:\n    w=csv.writer(f); w.writerow([\"section_id\",\"finding\"])\n    for sid,finding,_ in out: w.writerow([sid,finding])\n\n# counts (sections, not labels)\nsection_count=len(out)\nflagged_count=sum(1 for _,finding,_ in out if finding!=\"none\")\npn=sum(1 for _,finding,_ in out if \"PROHIBITED_PERSONAL_NARRATIVE\" in finding)\npl=sum(1 for _,finding,_ in out if \"PROTECTED_CLASS_LANGUAGE\" in finding)\ndm=sum(1 for _,finding,_ in out if \"DISCLAIMER_MISSING\" in finding)\nres={\"section_count\":section_count,\"flagged_count\":flagged_count,\n     \"personal_narrative_count\":pn,\"protected_lang_count\":pl,\"disclaimer_missing_count\":dm}\nwith open(\"results.json\",\"w\") as f: json.dump(res,f,indent=2)\n\nfor sid,finding,role in out: print(f\"{sid}\\t{role:16}\\t{finding}\")\nprint(\"\\n\", res)\nPY" action.permission=* action.action=allow action.pattern=*
