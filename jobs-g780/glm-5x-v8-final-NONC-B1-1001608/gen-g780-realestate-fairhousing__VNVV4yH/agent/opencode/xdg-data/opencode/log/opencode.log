timestamp=2026-08-19T13:05:53.078Z level=INFO run=da1a75f8 message=evaluated permission=bash pattern="cat > /tmp/opencode/dbg2.py << 'PYEOF'\nimport csv, re\nREQUIRED = [\"race\",\"colour\",\"religion\",\"sex\",\"familial status\",\"national origin\",\n            \"disability\",\"sexual orientation\",\"veteran status\",\"marital status\",\"source of income\"]\nMARKER = \"this brokerage complies with the federal fair housing act\"\nrows = list(csv.DictReader(open(\"/app/input/seller_book_sections.csv\")))\ndef find_notice(text):\n    low=text.lower(); i=low.find(MARKER)\n    if i==-1: return None,text\n    return text[i:], text[:i]\ndef classes_named(notice):\n    if not notice: return set()\n    low=notice.lower(); named=set()\n    for c in REQUIRED:\n        variants=[c] if c!=\"colour\" else [\"colour\",\"color\"]\n        for v in variants:\n            if re.search(r\"\\b\"+re.escape(v)+r\"\\b\", low): named.add(c); break\n    return named\nfor r in rows:\n    if r[\"section_id\"] in (\"SEC-23\",\"SEC-19\",\"SEC-26\"):\n        body=r[\"body\"]\n        n,p=find_notice(body)\n        named=classes_named(n)\n        print(r[\"section_id\"], \"MARKER_found:\", n is not None)\n        print(\"  notice:\", repr(n))\n        print(\"  named:\", sorted(named), \"complete:\", named==set(REQUIRED))\n        print(\"  missing:\", sorted(set(REQUIRED)-named))\nPYEOF" action.permission=* action.action=allow action.pattern=*
