timestamp=2026-08-19T12:36:15.094Z level=INFO run=53d8c1d1 message=evaluated permission=bash pattern="cat << 'PYEOF' > /tmp/opencode/audit.py\nimport csv, re, json\n\nREQUIRED = [\"race\",\"color\",\"religion\",\"sex\",\"familial status\",\"national origin\",\n            \"disability\",\"sexual orientation\",\"veteran status\",\"marital status\",\"source of income\"]\n# color/colour both acceptable; normalize\ndef normalize(s): return s.lower().replace(\"colour\",\"color\")\n\nPROXIES = [\"church\",\"churches\",\"parish\",\"faith\",\"congregation\",\"worship\",\"family-oriented\",\"young families\",\"families\",\"households\",\"toddler\"]\n# protected-class bare terms for own-prose detection (the 9 from §2)\nPC9 = [\"race\",\"color\",\"religion\",\"sex\",\"familial status\",\"national origin\",\"disability\",\"sexual orientation\",\"veteran status\"]\n\nNOTICE_RE = re.compile(r\"This brokerage complies with the federal Fair Housing Act and RCW 49\\.60 and does not discriminate on the basis of (.+?)\\.\\s*$\")\n\ndef extract_notice(body):\n    m = NOTICE_RE.search(body)\n    if not m: return None\n    classes = m.group(1)\n    # split on commas and 'or'\n    parts = re.split(r\",|\\bor\\b\", classes)\n    found = []\n    for p in parts:\n        p = p.strip().rstrip(\".\").strip()\n        if not p: continue\n        found.append(p.lower().replace(\"colour\",\"color\"))\n    return found\n\ndef own_prose(body):\n    m = NOTICE_RE.search(body)\n    if m:\n        prose = body[:m.start()]\n    else:\n        prose = body\n    return prose.lower()\n\nrows = []\nwith open(\"input/seller_book_sections.csv\") as f:\n    r = csv.DictReader(f)\n    for row in r:\n        rows.append(row)\n\nprint(f\"Total sections: {len(rows)}\")\nfor row in rows:\n    sid = row[\"section_id\"]; role = row[\"role\"]; body = row[\"body\"]\n    notice = extract_notice(body)\n    notice_classes = sorted(notice) if notice else []\n    missing = [c for c in REQUIRED if c not in (notice or [])] if notice else None\n    has_notice = notice is not None\n    is_full = has_notice and len(missing)==0\n    prose = own_prose(body)\n    # personal narrative\n    pn_triggers = [\"write us a letter\",\"send a personal note\",\"short personal note\",\"covering letter introducing yourself\",\"personal note about yourself\"]\n    pn = any(t in prose for t in pn_triggers)\n    # protected class in own prose (proxies + bare pc9)\n    pc_prose = False\n    for term in [\"race\",\"color\",\"religion\",\"sex\",\"familial\",\"national origin\",\"disability\",\"sexual orientation\",\"veteran\",\n                 \"church\",\"parish\",\"faith\",\"congregation\",\"worship\",\"family-oriented\",\"young families\",\"families\",\"households\",\"toddler\"]:\n        if term in prose:\n            pc_prose = True\n    # protected class via abridged notice\n    pc_notice = has_notice and not is_full\n    pc = pc_prose or pc_notice\n    # disclaimer missing: responsible roles closing_page/agent_bio, and (no notice or abridged)\n    if role in (\"closing_page\",\"agent_bio\"):\n        dm = (not has_notice) or (not is_full)\n    else:\n        dm = False\n    labels=[]\n    if pn: labels.append(\"PROHIBITED_PERSONAL_NARRATIVE\")\n    if pc: labels.append(\"PROTECTED_CLASS_LANGUAGE\")\n    if dm: labels.append(\"DISCLAIMER_MISSING\")\n    finding = \"|\".join(labels) if labels else \"none\"\n    print(f\"{sid}\\t{role}\\t{'FULL' if is_full else ('ABR('+str(len(notice or []))+')' if has_notice else 'NONE')}\\tpn={pn}\\tpc_prose={pc_prose}\\t{finding}\")\n\nPYEOF" action.permission=* action.action=allow action.pattern=*
