timestamp=2026-08-19T20:13:32.560Z level=INFO run=49df4b65 message=evaluated permission=bash pattern="python3 -c \"\nimport pickle\nd=pickle.load(open('audit_state.pkl','rb'))\nres=d['results']; parts=d['parts']; templates=d['templates']\nprint('--- landscape annexes (audited) ---')\nfor sid in sorted(res, key=lambda s: res[s]['sequence']):\n    r=res[sid]\n    # need section_type/orientation/widest from audited row\nprint('--- clearances: exception (landscape annex released) ---')\nfor sid in sorted(res, key=lambda s: res[s]['sequence']):\n    r=res[sid]\n    if r['type_area_exception']:\n        print(' ',sid, r['part_id'], r['template_id'], 'outer=',r['outer'],'min_outer=',r['min_outer'],'-> released by exception')\nprint('--- clearances: waiver ---')\nfor sid in sorted(res, key=lambda s: res[s]['sequence']):\n    r=res[sid]\n    if r['type_area_waiver']:\n        print(' ',sid, 'TYPE_AREA cleared by W-3, outer=',r['outer'],'min_outer=',r['min_outer'])\n# font waiver SEC-AN-01, caption waiver SEC-CH07\nfor sid in ['SEC-AN-01','SEC-CH07']:\n    print(' ',sid, '-> would breach but waived:', sid, '(see waivers)')\nprint('--- template-dependent type-area releases (widest in (24.2, 24.7]) ---')\nimport csv\nrows={r['section_id']:r for r in csv.DictReader(open('/app/input/dissertation_section_log.csv'))}\nfor sid in sorted(res, key=lambda s: res[s]['sequence']):\n    r=res[sid]\n    raw=rows[sid]\n    if raw['section_type']=='annex' and raw['orientation']=='landscape':\n        widest=float(raw['widest_table_cm'])\n        if 24.2 < widest <= 24.7 + 1e-9:\n            print(' ',sid, r['part_id'], r['template_id'], 'widest=',widest, 'released?',r['type_area_exception'],'outer=',r['outer'])\n\"" action.permission=* action.action=allow action.pattern=*
