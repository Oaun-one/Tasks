timestamp=2026-08-20T04:02:47.105Z level=INFO run=7013ea99 message=evaluated permission=bash pattern="python3 -c \"\nimport csv, json\n# cross-check the three files agree\naudit = list(csv.DictReader(open('activity_kit_audit.csv')))\nsec = list(csv.DictReader(open('section_summary.csv')))\nr = json.load(open('results.json'))\nflagged = [x for x in audit if x['finding']!='none']\nclean = [x for x in audit if x['finding']=='none']\nassert len(audit)==r['page_count']==36\nassert len(clean)==r['clean_count']==11\nassert len(flagged)==r['flagged_count']==25\n# finding_total\nft=sum(len(x['finding'].split('|')) for x in audit if x['finding']!='none')\nassert ft==r['finding_total']==41, (ft,r['finding_total'])\n# per-finding counts\nfrom collections import Counter\nc=Counter()\nfor x in audit:\n    if x['finding']!='none':\n        for k in x['finding'].split('|'): c[k]+=1\nassert c['DPI_TOO_LOW']==r['dpi_low_count']==9\nassert c['MARGIN_VIOLATION']==r['margin_count']==11\nassert c['BLEED_SHORT']==r['bleed_short_count']==3\nassert c['INK_OVER']==r['ink_over_count']==8\nassert c['ELEMENT_COUNT_SHORT']==r['element_short_count']==10\n# section rollup sums\ntot_live=sum(int(x['live_page_count']) for x in sec)\ntot_held=sum(int(x['held_back']) for x in sec)\ntot_flag=sum(int(x['flagged_pages']) for x in sec)\ninv=[x for x in sec if x['imposition']=='IMPOSITION_INVALID']\nassert tot_live==36 and tot_held==10 and tot_flag==25\nassert len(inv)==r['imposition_invalid_sections']==4\n# shortfall: next-multiple minus imposed\nshort=0\nfor x in inv:\n    imp=int(x['imposed_page_count']); m=4 if x['binding']=='saddle_stitch' else 2\n    short += m-(imp%m)\nassert short==r['imposition_shortfall_total']==8, (short, r['imposition_shortfall_total'])\nprint('ALL CROSS-CHECKS PASS')\nprint('imposition invalid:', [(x['section_id'],x['imposed_page_count'],x['binding']) for x in inv])\n\"" action.permission=* action.action=allow action.pattern=*
