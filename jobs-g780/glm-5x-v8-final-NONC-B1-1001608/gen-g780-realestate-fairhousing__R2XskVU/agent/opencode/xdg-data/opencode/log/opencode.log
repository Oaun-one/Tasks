timestamp=2026-08-19T12:56:29.109Z level=INFO run=4d63f917 message=evaluated permission=bash pattern="cat << 'PYEOF' > /tmp/opencode/build_audit.py\nimport csv, re, json\n\nREQUIRED = [\"race\",\"color\",\"religion\",\"sex\",\"familial status\",\"national origin\",\n            \"disability\",\"sexual orientation\",\"veteran status\",\"marital status\",\"source of income\"]\n\n# ---- notice extraction & completeness ----\ndef notice_span(body):\n    m = re.search(r\"This brokerage complies.*?(does not discriminate on the basis of[^.]*\\.)\", body, re.S)\n    return m\n\ndef notice_classes(body):\n    m = notice_span(body)\n    if not m: return None, None\n    notice = m.group(1).lower()\n    found = []\n    for c in REQUIRED:\n        if c in notice: found.append(c)\n        elif c == \"color\" and \"colour\" in notice: found.append(c)\n    return notice, found\n\ndef notice_complete(body):\n    notice, found = notice_classes(body)\n    if notice is None: return None\n    return len(found) == len(REQUIRED)\n\n# ---- personal narrative (§1) ----\nNARR_PATS = [\n    r\"about yoursel\", r\"write us a letter\", r\"personal note\", r\"introducing yourself\",\n    r\"covering letter\", r\"what brought you here\", r\"why this home suit\",\n    r\"what this home would mean\", r\"like to know who is buying\", r\"the one that moves us most\",\n    r\"short personal note about themselves\", r\"send a personal note\",\n]\ndef has_narrative(body):\n    b = body.lower()\n    return any(re.search(p, b) for p in NARR_PATS)\n\n# ---- protected-class proxies in PROSE (outside notice) ----\nPROXY_PATS = [\n    r\"church\", r\"parish\", r\"faith\", r\"congregation\", r\"worship\", r\"churchgoing\",\n    r\"family-oriented\", r\"\\bfamilies\\b\", r\"toddler\",\n]\ndef prose(body):\n    m = notice_span(body)\n    if m:\n        return (body[:m.start()] + \" \" + body[m.end():]).lower()\n    return body.lower()\ndef has_prose_proxy(body):\n    p = prose(body)\n    return any(re.search(pat, p) for pat in PROXY_PATS)\n\n# ---- main ----\nRESPONSIBLE_ROLES = {\"closing_page\", \"agent_bio\"}\nrows = list(csv.DictReader(open('/app/input/seller_book_sections.csv')))\n\naudit = []\nfor r in rows:\n    sid, role, body = r['section_id'], r['role'], r['body']\n    findings = []\n    # §1 personal narrative (any role)\n    if has_narrative(body):\n        findings.append(\"PROHIBITED_PERSONAL_NARRATIVE\")\n    # §2 protected class language\n    complete = notice_complete(body)\n    has_pcl = False\n    if has_prose_proxy(body):\n        has_pcl = True\n    if complete is True:          # complete notice -> its terms exempt\n        pass\n    elif complete is False:      # abridged notice present -> its terms count\n        has_pcl = True\n    # no notice -> only prose terms matter\n    if has_pcl:\n        findings.append(\"PROTECTED_CLASS_LANGUAGE\")\n    # §4 disclaimer missing (responsible roles only)\n    if role in RESPONSIBLE_ROLES:\n        if complete is not True:   # no notice OR abridged\n            findings.append(\"DISCLAIMER_MISSING\")\n    finding = \"|\".join(findings) if findings else \"none\"\n    audit.append((sid, finding))\n\n# write CSV\nwith open('/app/fairhousing_audit.csv','w',newline='') as f:\n    w = csv.writer(f)\n    w.writerow([\"section_id\",\"finding\"])\n    for sid, finding in audit:\n        w.writerow([sid, finding])\n\n# results.json\nflagged = [a for a in audit if a[1] != \"none\"]\ndef cnt(label): return sum(1 for _,f in audit if label in f.split(\"|\"))\nresults = {\n    \"section_count\": len(audit),\n    \"flagged_count\": len(flagged),\n    \"personal_narrative_count\": cnt(\"PROHIBITED_PERSONAL_NARRATIVE\"),\n    \"protected_lang_count\": cnt(\"PROTECTED_CLASS_LANGUAGE\"),\n    \"disclaimer_missing_count\": cnt(\"DISCLAIMER_MISSING\"),\n}\nwith open('/app/results.json','w') as f:\n    json.dump(results, f, indent=2)\n\nprint(\"=== AUDIT ===\")\nfor sid, finding in audit:\n    print(f\"{sid}: {finding}\")\nprint(\"\\n=== RESULTS ===\")\nprint(json.dumps(results, indent=2))\nPYEOF" action.permission=* action.action=allow action.pattern=*
