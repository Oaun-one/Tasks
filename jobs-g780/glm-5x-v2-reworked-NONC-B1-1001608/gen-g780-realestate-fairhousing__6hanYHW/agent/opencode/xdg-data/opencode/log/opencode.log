timestamp=2026-08-19T09:16:15.428Z level=INFO run=d8528695 message=evaluated permission=bash pattern="python3 -c \"\nimport csv, json\nrows=list(csv.reader(open('fairhousing_audit.csv')))\nassert rows[0]==['section_id','finding'], rows[0]\ndata=[r for r in rows[1:] if r]\nassert len(data)==10, len(data)\nfor r in data:\n    assert len(r)==2, r  # exactly two columns\nids=[r[0] for r in data]\nassert ids==['SEC-%02d'%i for i in range(1,11)], ids  # inventory order\nlabels=['PROHIBITED_PERSONAL_NARRATIVE','PROTECTED_CLASS_LANGUAGE','DISCLAIMER_MISSING']\norder_ok=True\nfor r in data:\n    if r[1]!='none':\n        parts=r[1].split('|')\n        if parts!=sorted(parts, key=lambda x: labels.index(x)): order_ok=False\nassert order_ok, 'label order violated'\nflagged=sum(1 for r in data if r[1]!='none')\npn=sum(1 for r in data if 'PROHIBITED_PERSONAL_NARRATIVE' in r[1].split('|'))\npl=sum(1 for r in data if 'PROTECTED_CLASS_LANGUAGE' in r[1].split('|'))\ndm=sum(1 for r in data if 'DISCLAIMER_MISSING' in r[1].split('|'))\nres=json.load(open('results.json'))\nexpected={'section_count':10,'flagged_count':flagged,'personal_narrative_count':pn,'protected_lang_count':pl,'disclaimer_missing_count':dm}\nprint('CSV-derived:', expected)\nprint('results.json:', res)\nassert res==expected, (res, expected)\nprint('ALL CHECKS PASSED')\n\"" action.permission=* action.action=allow action.pattern=*
