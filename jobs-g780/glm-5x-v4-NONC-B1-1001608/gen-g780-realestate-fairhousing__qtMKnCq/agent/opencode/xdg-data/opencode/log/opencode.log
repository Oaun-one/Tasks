timestamp=2026-08-19T09:48:04.071Z level=INFO run=d9e90f48 message=evaluated permission=bash pattern="python3 - <<'EOF'\nimport csv, json, collections\nwith open('/app/fairhousing_audit.csv') as f:\n    rows = list(csv.DictReader(f))\nsection_count = len(rows)\nflagged = [r for r in rows if r['finding'] != 'none']\ndef has(label, r): return label in r['finding'].split('|')\npn = [r for r in rows if has('PROHIBITED_PERSONAL_NARRATIVE', r)]\npcl = [r for r in rows if has('PROTECTED_CLASS_LANGUAGE', r)]\ndm = [r for r in rows if has('DISCLAIMER_MISSING', r)]\nexpected = {\"section_count\":11,\"flagged_count\":7,\"personal_narrative_count\":3,\"protected_lang_count\":4,\"disclaimer_missing_count\":3}\nactual = {\"section_count\":section_count,\"flagged_count\":len(flagged),\"personal_narrative_count\":len(pn),\"protected_lang_count\":len(pcl),\"disclaimer_missing_count\":len(dm)}\nwith open('/app/results.json') as f: ondisk = json.load(f)\nprint(\"computed :\", actual)\nprint(\"on disk  :\", ondisk)\nprint(\"json valid & matches computed:\", ondisk==actual==expected)\nprint(\"inventory order preserved     :\", [r['section_id'] for r in rows]==[f\"SEC-{i:02d}\" for i in range(1,12)])\nprint(\"two columns only              :\", list(rows[0].keys())==['section_id','finding'])\nEOF" action.permission=* action.action=allow action.pattern=*
