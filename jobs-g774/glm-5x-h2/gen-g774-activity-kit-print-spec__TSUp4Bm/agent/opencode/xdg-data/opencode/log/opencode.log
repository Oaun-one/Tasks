timestamp=2026-08-20T04:04:17.640Z level=INFO run=fc6dc1ab message=evaluated permission=bash pattern="python3 -c \"\nimport csv, json\n\n# load audit\naudit = {}\nwith open('activity_kit_audit.csv') as f:\n    for r in csv.DictReader(f):\n        audit[r['page_id']] = r['finding']\n\n# load summary\nsumm = []\nwith open('section_summary.csv') as f:\n    for r in csv.DictReader(f):\n        summ.append(r)\n\nres = json.load(open('results.json'))\n\nassert len(audit) == res['page_count'] == 36, (len(audit), res['page_count'])\nassert res['clean_count'] == sum(1 for v in audit.values() if v=='none')\nassert res['flagged_count'] == sum(1 for v in audit.values() if v!='none')\n\ndef codes(v):\n    return [] if v=='none' else v.split('|')\nres_code_counts = {c:0 for c in ['DPI_TOO_LOW','MARGIN_VIOLATION','BLEED_SHORT','INK_OVER','ELEMENT_COUNT_SHORT']}\nftot = 0\nfor v in audit.values():\n    for c in codes(v):\n        res_code_counts[c]+=1\n        ftot+=1\nassert res['finding_total']==ftot, (res['finding_total'], ftot)\nfor k,n in [('dpi_low_count','DPI_TOO_LOW'),('margin_count','MARGIN_VIOLATION'),('bleed_short_count','BLEED_SHORT'),('ink_over_count','INK_OVER'),('element_short_count','ELEMENT_COUNT_SHORT')]:\n    assert res[k]==res_code_counts[n], (k,res[k],res_code_counts[n])\n\n# summary cross-check\nassert len(summ)==res['section_count']==8\nassert sum(int(s['live_page_count']) for s in summ)==res['page_count']\nassert sum(int(s['held_back']) for s in summ)==res['element_short_count']\nassert sum(int(s['flagged_pages']) for s in summ)==res['flagged_count']\ninvalids = [s for s in summ if s['imposition']=='IMPOSITION_INVALID']\nassert len(invalids)==res['imposition_invalid_sections']\n# recompute shortfall from summary\nneed = {'saddle_stitch':4,'perfect_bound':2}\nshort=0\nfor s in summ:\n    imp=int(s['imposed_page_count']); m=need[s['binding']]\n    if imp % m != 0:\n        short += ((imp//m)+1)*m - imp\nassert short==res['imposition_shortfall_total'], (short, res['imposition_shortfall_total'])\nprint('ALL CONSISTENT')\nprint('audit rows:', len(audit), '| summary rows:', len(summ), '| results keys:', len(res))\n\"" action.permission=* action.action=allow action.pattern=*
