timestamp=2026-08-19T19:08:44.989Z level=INFO run=911c27af message=evaluated permission=bash pattern="python3 -c \"\nimport csv\nrows = list(csv.reader(open('formatting_audit.csv')))\nhdr = rows[0]\nassert hdr == ['section_id','finding'], hdr\ndata = rows[1:]\nassert len(data) == 30\norder = ['MARGIN_NONCOMPLIANT','FONT_NONCOMPLIANT','SPACING_NONCOMPLIANT']\n# cross check counts\nmc=fc=sc=flag=0\nsids=set()\nfor sid,f in data:\n    sids.add(sid)\n    assert f=='none' or all(p in order for p in f.split('|'))\n    if f.split('|') != [p for p in order if p in f.split('|')]:\n        raise SystemExit('order wrong for '+sid+': '+f)\n    if f!='none':\n        flag+=1\n        if 'MARGIN' in f: mc+=1\n        if 'FONT' in f: fc+=1\n        if 'SPACING' in f: sc+=1\nprint('unique sids:', len(sids))\nprint('flagged:',flag,'margin:',mc,'font:',fc,'spacing:',sc)\nassert flag==18 and mc==10 and fc==6 and sc==5\nprint('ALL CHECKS PASSED')\n\"" action.permission=* action.action=allow action.pattern=*
