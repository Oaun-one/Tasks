timestamp=2026-08-20T02:55:49.284Z level=INFO run=8e75bdb8 message=evaluated permission=bash pattern="python3 - <<'PY'\nimport csv\nfrom datetime import date\nAUDIT = date(2026,3,31)\ndef pd(s):\n    if not s or s==\"none\": return None\n    y,m,d=s.split(\"-\"); return date(int(y),int(m),int(d))\nreg={}\nfor r in csv.DictReader(open(\"/app/input/licensed_property_register.csv\")): reg[r[\"license_id\"]]=r\neff={lid:dict(x) for lid,x in reg.items()}\nfor lid,x in reg.items():\n    s=x[\"supersedes\"]\n    if s and s!=\"none\":\n        eff[s]=dict(x); eff[lid]=dict(x)\ndef cov(lid,lt,d):\n    if not lid or lid==\"none\": return None\n    row=eff.get(lid)\n    if not row or row[\"license_type\"]!=lt: return None\n    c=row[\"covers_distribution\"]\n    if c!=\"all\" and d not in c.split(\";\"): return None\n    v=pd(row[\"valid_until\"])\n    if not v or v<AUDIT: return None\n    return (lid,row[\"covers_distribution\"],row[\"valid_until\"],row[\"supersedes\"])\n\nrows=[r for r in csv.DictReader(open(\"/app/input/composite_request_log.csv\")) if r[\"intake_status\"]!=\"withdrawn\"]\n\nprint(\"== character requests: how cleared ==\")\nfor r in rows:\n    if r[\"character_property\"]==\"none\": continue\n    d=r[\"intended_distribution\"]; lid=r[\"character_license_id\"]\n    c=cov(lid,\"character\",d)\n    if c:\n        print(r[\"request_id\"],r[\"character_property\"],\"LIC\",lid,\"-> covered by\",c[0],\"(cov\",c[1],\"vu\",c[2],\"supersedes\",c[3],\")\")\n    elif d==\"personal_only\":\n        print(r[\"request_id\"],r[\"character_property\"],\"LIC\",lid,\"-> NOT covered by licence; CLEARED by personal-use allowance (personal_only)\")\n    else:\n        print(r[\"request_id\"],r[\"character_property\"],\"LIC\",lid,\"-> NOT covered; finding UNLICENSED_CHARACTER_USE (dist\",d,\")\")\n\nprint(\"\\n== third_party_licensed backgrounds ==\")\nfor r in rows:\n    if r[\"background_source\"]!=\"third_party_licensed\": continue\n    d=r[\"intended_distribution\"]; lid=r[\"background_license_id\"]\n    c=cov(lid,\"background\",d)\n    if c:\n        print(r[\"request_id\"],\"bg LIC\",lid,\"-> covered by\",c[0],\"(cov\",c[1],\"vu\",c[2],\"supersedes\",c[3],\")\")\n    else:\n        print(r[\"request_id\"],\"bg LIC\",lid,\"-> NOT covered (dist\",d,\") -> finding\")\n\nprint(\"\\n== personal-use allowance clears (character, personal_only) ==\")\nfor r in rows:\n    if r[\"character_property\"]!=\"none\" and r[\"intended_distribution\"]==\"personal_only\":\n        print(r[\"request_id\"])\nPY" action.permission=* action.action=allow action.pattern=*
