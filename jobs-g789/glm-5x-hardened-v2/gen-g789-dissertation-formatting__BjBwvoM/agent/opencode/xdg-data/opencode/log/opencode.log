timestamp=2026-08-19T19:10:10.727Z level=INFO run=f4efe191 message=evaluated permission=bash pattern="python3 -c \"\nimport csv, json\nwith open('formatting_audit.csv') as f:\n    rows = list(csv.reader(f))\nprint('Header:', rows[0])\nassert rows[0] == ['section_id','finding'], 'BAD HEADER'\nassert len(rows[0])==2, 'HEADER NOT 2 COLS'\nprint('Data rows:', len(rows)-1)\nfindings = [r[1] for r in rows[1:]]\norder = ['MARGIN_NONCOMPLIANT','FONT_NONCOMPLIANT','SPACING_NONCOMPLIANT']\nfor f in findings:\n    if f!='none':\n        parts=f.split('|')\n        assert ' ' not in f, 'SPACE IN FINDING: '+f\n        assert parts==sorted(parts, key=lambda x: order.index(x)), 'WRONG ORDER: '+f\nprint('All findings well-formed and ordered.')\nprint('none count:', findings.count('none'))\nprint('flagged (non-none):', sum(1 for x in findings if x!='none'))\nprint('margin:', sum(1 for x in findings if 'MARGIN_NONCOMPLIANT' in x))\nprint('font:', sum(1 for x in findings if 'FONT_NONCOMPLIANT' in x))\nprint('spacing:', sum(1 for x in findings if 'SPACING_NONCOMPLIANT' in x))\nids=[r[0] for r in rows[1:]]\nprint('unique section_ids:', len(set(ids)))\nassert len(ids)==len(set(ids)), 'DUPLICATE SECTION_IDS'\nprint('=== JSON ===')\nj=json.load(open('results.json'))\nprint(j)\nassert set(j.keys())=={'section_count','flagged_count','margin_count','font_count','spacing_count'}\nassert all(isinstance(v,int) for v in j.values())\nprint('JSON keys & int types OK')\nassert j['section_count']==len(rows)-1\nassert j['flagged_count']==sum(1 for x in findings if x!='none')\nassert j['margin_count']==sum(1 for x in findings if 'MARGIN_NONCOMPLIANT' in x)\nassert j['font_count']==sum(1 for x in findings if 'FONT_NONCOMPLIANT' in x)\nassert j['spacing_count']==sum(1 for x in findings if 'SPACING_NONCOMPLIANT' in x)\nprint('JSON counts consistent with CSV.')\n\"" action.permission=* action.action=allow action.pattern=*
