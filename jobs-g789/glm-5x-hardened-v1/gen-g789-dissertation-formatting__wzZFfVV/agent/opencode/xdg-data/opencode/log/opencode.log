timestamp=2026-08-19T18:49:40.558Z level=INFO run=30ebe8f2 message=evaluated permission=bash pattern="python3 -c \"\nimport csv, json\nfrom collections import Counter\norder=['MARGIN_NONCOMPLIANT','FONT_NONCOMPLIANT','SPACING_NONCOMPLIANT']\nwith open('/app/formatting_audit.csv') as f:\n    rows=list(csv.reader(f))\nassert rows[0]==['section_id','finding'], rows[0]\nsids=set(); c=Counter(); flag=0\nfor sid,find in rows[1:]:\n    sids.add(sid)\n    assert ' ' not in find, (sid,find)\n    if find=='none': continue\n    flag+=1\n    parts=find.split('|')\n    # parts must be a subsequence of 'order' (correct order, no dup, no extra)\n    idx={p:i for i,p in enumerate(parts)}\n    assert len(parts)==len(set(parts))\n    assert [order.index(p) for p in parts]==sorted(order.index(p) for p in parts), (sid,find)\n    for p in parts: c[p]+=1\nassert len(sids)==30\nwith open('/app/results.json') as f: j=json.load(f)\nassert set(j)=={'section_count','flagged_count','margin_count','font_count','spacing_count'}\nassert all(isinstance(v,int) for v in j.values())\nassert j['section_count']==30==len(rows)-1\nassert j['flagged_count']==flag==18\nassert j['margin_count']==c['MARGIN_NONCOMPLIANT']==10\nassert j['font_count']==c['FONT_NONCOMPLIANT']==6\nassert j['spacing_count']==c['SPACING_NONCOMPLIANT']==5\nprint('ALL CHECKS PASS')\nprint('flagged',flag,'margin',c['MARGIN_NONCOMPLIANT'],'font',c['FONT_NONCOMPLIANT'],'spacing',c['SPACING_NONCOMPLIANT'])\n\"" action.permission=* action.action=allow action.pattern=*
