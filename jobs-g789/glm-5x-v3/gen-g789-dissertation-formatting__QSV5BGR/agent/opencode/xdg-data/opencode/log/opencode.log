timestamp=2026-08-19T19:41:28.364Z level=INFO run=ba4529ed message=evaluated permission=bash pattern="python3 -c \"\nimport csv\na=list(csv.DictReader(open('formatting_audit.csv')))\np=list(csv.DictReader(open('part_summary.csv')))\nprint('audit rows:', len(a))\nprint('part rows:', len(p))\n# cross-check counts from audit\nfrom collections import Counter\nfc=Counter()\nflagged=0; clean=0; ftotal=0\nshort=0\nfor r in a:\n    if r['finding']=='none': clean+=1\n    else:\n        flagged+=1\n        parts=r['finding'].split('|')\n        ftotal+=len(parts)\n        for x in parts: fc[x]+=1\nprint('clean:',clean,'flagged:',flagged,'finding_total:',ftotal)\nfor k in ['MARGIN_NONCOMPLIANT','TYPE_AREA_INVALID','LEADING_NONCOMPLIANT','FONT_NONCOMPLIANT','HEADING_STYLE_INVALID','CAPTION_MISSING','NUMBERING_INVALID']:\n    print(k, fc[k])\n# caption shortfall from memo rows\nprint('---part_summary cross-check---')\nptc=Counter()\nfor r in a: ptc[r['part_id']]+=1\npflag=Counter()\nfor r in a:\n    if r['finding']!='none': pflag[r['part_id']]+=1\nfor r in p:\n    print(r['part_id'],'count',r['section_count'],'(calc',ptc[r['part_id']],') flagged',r['flagged_sections'],'(calc',pflag[r['part_id']],') start',r['start_page'],r['pagination'])\n\"" action.permission=* action.action=allow action.pattern=*
