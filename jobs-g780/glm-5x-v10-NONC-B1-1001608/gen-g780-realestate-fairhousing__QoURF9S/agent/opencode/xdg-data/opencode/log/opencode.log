timestamp=2026-08-19T14:19:45.467Z level=INFO run=63302c7a message=evaluated permission=bash pattern="python3 - <<'PY'\nimport csv, json\ninv_ids=[r[\"section_id\"] for r in csv.DictReader(open(\"/app/input/seller_book_sections.csv\", newline=\"\"))]\nrows=list(csv.reader(open(\"/app/fairhousing_audit.csv\")))\nassert rows[0]==[\"section_id\",\"finding\"], rows[0]\ndata=rows[1:]\nassert len(data)==len(inv_ids)==30\nlabels={\"PROHIBITED_PERSONAL_NARRATIVE\",\"PROTECTED_CLASS_LANGUAGE\",\"DISCLAIMER_MISSING\"}\norder=[\"PROHIBITED_PERSONAL_NARRATIVE\",\"PROTECTED_CLASS_LANGUAGE\",\"DISCLAIMER_MISSING\"]\nfor (sid,finding),inv in zip(data,inv_ids):\n    assert sid==inv, (sid,inv)\n    if finding==\"none\": continue\n    parts=finding.split(\"|\")\n    assert parts==order[:len(parts)], (sid,parts)  # correct subset, correct order\n    assert set(parts)<=labels, (sid,parts)\ncnt={\n \"section_count\":len(data),\n \"flagged_count\":sum(1 for _,f in data if f!=\"none\"),\n \"personal_narrative_count\":sum(1 for _,f in data if \"PROHIBITED_PERSONAL_NARRATIVE\" in f.split(\"|\")),\n \"protected_lang_count\":sum(1 for _,f in data if \"PROTECTED_CLASS_LANGUAGE\" in f.split(\"|\")),\n \"disclaimer_missing_count\":sum(1 for _,f in data if \"DISCLAIMER_MISSING\" in f.split(\"|\")),\n}\nres=json.load(open(\"/app/results.json\"))\nassert cnt==res, (cnt,res)\nprint(\"OK: CSV matches inventory (30, in order); labels valid & ordered; results.json consistent.\")\nprint(json.dumps(cnt,indent=2))\nPY" action.permission=* action.action=allow action.pattern=*
