timestamp=2026-08-19T13:06:11.564Z level=INFO run=da1a75f8 message=evaluated permission=bash pattern="cat > /tmp/opencode/dump.py << 'PYEOF'\nimport csv, re\nREQUIRED = [\"race\",\"colour\",\"religion\",\"sex\",\"familial status\",\"national origin\",\n            \"disability\",\"sexual orientation\",\"veteran status\",\"marital status\",\"source of income\"]\nMARKER = \"this brokerage complies with the federal fair housing act\"\nrows=list(csv.DictReader(open(\"/app/input/seller_book_sections.csv\")))\ndef find_notice(t):\n    low=t.lower(); i=low.find(MARKER)\n    return (None,t) if i==-1 else (t[i:], t[:i])\ndef classes_named(n):\n    if not n: return set()\n    low=n.lower(); s=set()\n    for c in REQUIRED:\n        vs=[c] if c!=\"colour\" else [\"colour\",\"color\"]\n        for v in vs:\n            if re.search(r\"\\b\"+re.escape(v)+r\"\\b\", low): s.add(c); break\n    return s\nfor r in rows:\n    n,p=find_notice(r[\"body\"])\n    named=classes_named(n)\n    status=\"complete\" if n and named==set(REQUIRED) else (\"abridged\" if n else \"no-notice\")\n    print(f\"{r['section_id']} | {r['role']} | {status} | missing={sorted(set(REQUIRED)-named)}\")\n    print(f\"    TITLE: {r['title']}\")\n    print(f\"    BODY : {r['body']}\")\n    if n: print(f\"    NOTICE: {n}\")\n    print()\nPYEOF" action.permission=* action.action=allow action.pattern=*
