timestamp=2026-08-20T04:04:42.079Z level=INFO run=fe2aaff0 message=evaluated permission=bash pattern="python3 - <<'PY'\nimport csv, json\n# Validate audit CSV\nwith open(\"/app/activity_kit_audit.csv\") as f:\n    rows = list(csv.DictReader(f))\nprint(\"AUDIT rows:\", len(rows), \"cols:\", list(rows[0].keys()))\nassert list(rows[0].keys()) == [\"page_id\", \"finding\"]\nassert len(rows) == 36\nclean = sum(1 for r in rows if r[\"finding\"] == \"none\")\nprint(\"  clean:\", clean, \"flagged:\", 36-clean)\n# Validate section summary\nwith open(\"/app/section_summary.csv\") as f:\n    srows = list(csv.DictReader(f))\nprint(\"SECTION rows:\", len(srows), \"cols:\", list(srows[0].keys()))\nassert list(srows[0].keys()) == [\"section_id\",\"binding\",\"stock_code\",\"live_page_count\",\"held_back\",\"imposed_page_count\",\"flagged_pages\",\"imposition\"]\nassert len(srows) == 8\n# Cross-checks\nlive = sum(int(r[\"live_page_count\"]) for r in srows)\nheld = sum(int(r[\"held_back\"]) for r in srows)\nflagged = sum(int(r[\"flagged_pages\"]) for r in srows)\ninv = sum(1 for r in srows if r[\"imposition\"] == \"IMPOSITION_INVALID\")\nprint(\"  live total:\", live, \"held_back total:\", held, \"flagged total:\", flagged, \"invalid:\", inv)\nassert live == 36 and flagged == 25 and held == 10 and inv == 4\n# Validate results.json\nwith open(\"/app/results.json\") as f:\n    res = json.load(f)\nprint(\"RESULTS keys:\", list(res.keys()))\nassert res[\"page_count\"] == 36\nassert res[\"clean_count\"] + res[\"flagged_count\"] == res[\"page_count\"]\nassert res[\"dpi_low_count\"]+res[\"margin_count\"]+res[\"bleed_short_count\"]+res[\"ink_over_count\"]+res[\"element_short_count\"] == res[\"finding_total\"]\nprint(\"  finding sum check:\", res[\"dpi_low_count\"]+res[\"margin_count\"]+res[\"bleed_short_count\"]+res[\"ink_over_count\"]+res[\"element_short_count\"], \"== finding_total\", res[\"finding_total\"])\nprint(\"ALL CHECKS PASSED\")\nPY" action.permission=* action.action=allow action.pattern=*
