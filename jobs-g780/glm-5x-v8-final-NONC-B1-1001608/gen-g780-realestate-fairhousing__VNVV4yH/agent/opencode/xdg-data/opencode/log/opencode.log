timestamp=2026-08-19T13:07:26.858Z level=INFO run=da1a75f8 message=evaluated permission=bash pattern="python3 -c \"\nimport csv,json\nrows=list(csv.DictReader(open('/app/fairhousing_audit.csv')))\nrj=json.load(open('/app/results.json'))\nsc=len(rows)\nflag=sum(1 for r in rows if r['finding']!='none')\npn=sum(1 for r in rows if 'PROHIBITED_PERSONAL_NARRATIVE' in r['finding'])\npl=sum(1 for r in rows if 'PROTECTED_CLASS_LANGUAGE' in r['finding'])\ndm=sum(1 for r in rows if 'DISCLAIMER_MISSING' in r['finding'])\nprint('csv counts: section=%d flagged=%d pn=%d pcl=%d dm=%d'%(sc,flag,pn,pl,dm))\nprint('json counts: section=%d flagged=%d pn=%d pcl=%d dm=%d'%(rj['section_count'],rj['flagged_count'],rj['personal_narrative_count'],rj['protected_lang_count'],rj['disclaimer_missing_count']))\nassert sc==rj['section_count'] and flag==rj['flagged_count'] and pn==rj['personal_narrative_count'] and pl==rj['protected_lang_count'] and dm==rj['disclaimer_missing_count'], 'MISMATCH'\nprint('CSV == results.json: OK')\nprint('columns:', list(rows[0].keys()))\nprint('row count (excl header):', len(rows))\n# verify exactly 2 columns and no extra\nfor r in rows:\n    assert len(r)==2, 'bad column count in '+r['section_id']\n    assert list(r.keys())==['section_id','finding'], 'bad columns in '+r['section_id']\nprint('all rows have exactly section_id,finding: OK')\n\"" action.permission=* action.action=allow action.pattern=*
