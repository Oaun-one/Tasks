timestamp=2026-08-20T02:42:03.904Z level=INFO run=9a0b85f7 message=evaluated permission=bash pattern="cat > /tmp/opencode/audit.py << 'PYEOF'\nimport csv\nfrom datetime import date\n\nAUDIT_DATE = date(2026,3,31)\n\naccounts = {}\nwith open('/app/input/client_accounts.csv') as f:\n    for r in csv.DictReader(f):\n        accounts[r['account_id']] = r\n\nlicences = {}\nwith open('/app/input/licensed_property_register.csv') as f:\n    for r in csv.DictReader(f):\n        licences[r['license_id']] = r\n\ndef covers(lic_id, ltype, distribution):\n    if lic_id == 'none': return False\n    lic = licences.get(lic_id)\n    if not lic: return False\n    if lic['license_type'] != ltype: return False\n    cd = lic['covers_distribution']\n    if cd != 'all' and distribution not in cd.split(';'): return False\n    vu = date.fromisoformat(lic['valid_until'])\n    if vu < AUDIT_DATE: return False\n    return True\n\ndef consent_ok(minor, ctype, valid, distribution):\n    if minor != 'True': return True\n    if ctype == 'none': return False\n    if date.fromisoformat(valid) < AUDIT_DATE: return False\n    if ctype == 'basic' and distribution not in ('personal_only','client_internal'): return False\n    return True\n\ndef agmt_clears(acc_id, distribution):\n    a = accounts[acc_id]\n    if a['agreement_status'] != 'active': return False\n    cov = a['master_agreement_covers']\n    if cov == 'none': return False\n    return distribution in cov.split(';')\n\nresults = {}\nwith open('/app/input/composite_request_log.csv') as f:\n    for r in csv.DictReader(f):\n        rid = r['request_id']\n        f_list = []\n        # §3\n        if r['character_property'] != 'none':\n            dist = r['intended_distribution']\n            if not (covers(r['character_license_id'],'character',dist) or dist=='personal_only'):\n                f_list.append('UNLICENSED_CHARACTER_USE')\n        # §4\n        bs = r['background_source']\n        if bs == 'third_party_unlicensed':\n            f_list.append('THIRD_PARTY_BACKGROUND_UNLICENSED')\n        elif bs == 'third_party_licensed':\n            if not covers(r['background_license_id'],'background',r['intended_distribution']):\n                f_list.append('THIRD_PARTY_BACKGROUND_UNLICENSED')\n        # §5\n        if r['subject_is_minor'] == 'True':\n            if not consent_ok(True, r['minor_consent_type'], r['minor_consent_valid_until'], r['intended_distribution']):\n                f_list.append('MISSING_MINOR_CONSENT')\n        # §6\n        if r['intended_distribution'] in ('social_public','print_for_sale'):\n            if not agmt_clears(r['account_id'], r['intended_distribution']):\n                f_list.append('COMMERCIAL_DISTRIBUTION_FLAG')\n        # §7\n        if r['alteration_level']=='substantive' and r['intended_distribution'] in ('social_public','print_for_sale'):\n            if r['alteration_disclosure_on_file'] != 'True':\n                f_list.append('ALTERATION_DISCLOSURE_MISSING')\n        results[rid] = (r['account_id'], f_list)\n\norder = ['UNLICENSED_CHARACTER_USE','THIRD_PARTY_BACKGROUND_UNLICENSED','MISSING_MINOR_CONSENT','COMMERCIAL_DISTRIBUTION_FLAG','ALTERATION_DISCLOSURE_MISSING']\nfor rid,(acc,fl) in results.items():\n    fl_sorted = [x for x in order if x in fl]\n    print(rid, acc, '|'.join(fl_sorted) if fl_sorted else 'none', len(fl))\n\n# account rollup\nfrom collections import defaultdict\nacct_reqs = defaultdict(list)\nfor rid,(acc,fl) in results.items():\n    acct_reqs[acc].append((rid,fl))\n\nprint(\"\\n--- ACCOUNTS ---\")\nesc = []\nfor acc in sorted(acct_reqs):\n    reqs = acct_reqs[acc]\n    flagged = [r for r,fl in reqs if fl]\n    maxf = max(len(fl) for r,fl in reqs)\n    escalate = len(flagged)>=2 or maxf>=3\n    if escalate: esc.append(acc)\n    print(acc, accounts[acc]['account_type'], len(reqs), len(flagged), 'ESCALATION_REQUIRED' if escalate else 'none', 'maxf=%d'%maxf)\n\nprint(\"\\n--- TOTALS ---\")\nflagged_count = sum(1 for rid,(acc,fl) in results.items() if fl)\nfinding_total = sum(len(fl) for rid,(acc,fl) in results.items())\nchar_count = sum(1 for rid,(acc,fl) in results.items() if 'UNLICENSED_CHARACTER_USE' in fl)\nbg_count = sum(1 for rid,(acc,fl) in results.items() if 'THIRD_PARTY_BACKGROUND_UNLICENSED' in fl)\ncon_count = sum(1 for rid,(acc,fl) in results.items() if 'MISSING_MINOR_CONSENT' in fl)\ncom_count = sum(1 for rid,(acc,fl) in results.items() if 'COMMERCIAL_DISTRIBUTION_FLAG' in fl)\ndis_count = sum(1 for rid,(acc,fl) in results.items() if 'ALTERATION_DISCLOSURE_MISSING' in fl)\nprint('request_count',len(results))\nprint('account_count',len(accounts))\nprint('flagged_count',flagged_count)\nprint('compliant_count',len(results)-flagged_count)\nprint('finding_total',finding_total)\nprint('character',char_count,'background',bg_count,'consent',con_count,'commercial',com_count,'disclosure',dis_count)\nprint('sum cats', char_count+bg_count+con_count+com_count+dis_count)\nprint('escalated',esc)\n\n# personal-use allowance clears (character not none, personal_only)\nprint(\"\\n--- PERSONAL-USE ALLOWANCE CLEARS (§3) ---\")\nwith open('/app/input/composite_request_log.csv') as f:\n    for r in csv.DictReader(f):\n        if r['character_property']!='none' and r['intended_distribution']=='personal_only':\n            print(r['request_id'], r['character_property'], r['character_license_id'])\nPYEOF" action.permission=* action.action=allow action.pattern=*
