timestamp=2026-08-19T09:12:37.805Z level=INFO run=a1eceed3 message=evaluated permission=bash pattern="python3 -c \"\nimport csv, json\nwith open('/app/fairhousing_audit.csv') as f:\n    rows=list(csv.reader(f))\nassert rows[0]==['section_id','finding'], rows[0]\nfor r in rows[1:]:\n    assert len(r)==2, r\nids=[r[0] for r in rows[1:]]\nassert ids==['SEC-%02d'%i for i in range(1,11)], ids\nprint('CSV OK:', len(rows)-1, 'data rows, 2 cols each, inventory order')\nwith open('/app/results.json') as f:\n    j=json.load(f)\nprint('JSON OK:', j)\n# cross-check counts against csv\nfrom collections import Counter\nlabels=Counter()\nflagged=0\nfor r in rows[1:]:\n    if r[1]=='none': continue\n    flagged+=1\n    for lab in r[1].split('|'):\n        labels[lab]+=1\nassert j['section_count']==len(rows)-1\nassert j['flagged_count']==flagged\nassert j['personal_narrative_count']==labels['PROHIBITED_PERSONAL_NARRATIVE']\nassert j['protected_lang_count']==labels['PROTECTED_CLASS_LANGUAGE']\nassert j['disclaimer_missing_count']==labels['DISCLAIMER_MISSING']\nprint('counts cross-check OK:', dict(labels), 'flagged=', flagged)\n\"" action.permission=* action.action=allow action.pattern=*
