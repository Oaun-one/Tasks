timestamp=2026-08-19T18:54:22.176Z level=INFO run=4aa0061f message=evaluated permission=bash pattern="python3 - << 'EOF'\nimport csv, json, collections\n\n# validate audit CSV\nwith open(\"/app/formatting_audit.csv\") as f:\n    rows = list(csv.reader(f))\nassert rows[0] == [\"section_id\",\"finding\"], rows[0]\nassert len(rows[0]) == 2, \"header must have exactly 2 columns\"\ndata = rows[1:]\nprint(\"audit rows (excl header):\", len(data))\nids = [r[0] for r in data]\nassert len(ids) == len(set(ids)), \"duplicate section_id\"\norder = {\"MARGIN_NONCOMPLIANT\":0,\"FONT_NONCOMPLIANT\":1,\"SPACING_NONCOMPLIANT\":2}\nfor sid,f in data:\n    if f != \"none\":\n        parts = f.split(\"|\")\n        assert all(p in order for p in parts), (sid,f)\n        assert parts == sorted(parts, key=lambda x: order[x]), (sid,f,\"order\")\n        assert \" \" not in f, (sid,f,\"no spaces\")\nprint(\"audit CSV: OK, unique ids =\", len(ids))\n\n# validate results.json\nwith open(\"/app/results.json\") as f:\n    res = json.load(f)\nkeys = {\"section_count\",\"flagged_count\",\"margin_count\",\"font_count\",\"spacing_count\"}\nassert set(res.keys()) == keys, res.keys()\nassert all(isinstance(res[k],int) for k in res), res\n\n# cross-check counts vs CSV\nmargin = sum(1 for _,f in data if \"MARGIN_NONCOMPLIANT\" in f.split(\"|\"))\nfont = sum(1 for _,f in data if \"FONT_NONCOMPLIANT\" in f.split(\"|\"))\nspacing = sum(1 for _,f in data if \"SPACING_NONCOMPLIANT\" in f.split(\"|\"))\nflagged = sum(1 for _,f in data if f != \"none\")\nassert res[\"section_count\"] == len(data) == 30\nassert res[\"flagged_count\"] == flagged, (res[\"flagged_count\"], flagged)\nassert res[\"margin_count\"] == margin, (res[\"margin_count\"], margin)\nassert res[\"font_count\"] == font, (res[\"font_count\"], font)\nassert res[\"spacing_count\"] == spacing, (res[\"spacing_count\"], spacing)\nprint(\"results.json: OK ->\", res)\nprint(\"cross-check: margin\",margin,\"font\",font,\"spacing\",spacing,\"flagged\",flagged)\nEOF" action.permission=* action.action=allow action.pattern=*
