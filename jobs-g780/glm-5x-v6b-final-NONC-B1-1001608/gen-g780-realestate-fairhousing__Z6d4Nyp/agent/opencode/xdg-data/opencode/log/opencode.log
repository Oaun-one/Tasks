timestamp=2026-08-19T10:32:21.335Z level=INFO run=9ec41bd5 message=evaluated permission=bash pattern="python3 - <<'PY'\nimport csv, json\n# Validate audit CSV: exactly 2 cols, header + 30 rows in order, valid labels\nlabels = {\"PROHIBITED_PERSONAL_NARRATIVE\",\"PROTECTED_CLASS_LANGUAGE\",\"DISCLAIMER_MISSING\",\"none\"}\nwith open(\"/app/fairhousing_audit.csv\", newline=\"\") as f:\n    r = list(csv.reader(f))\nassert r[0] == [\"section_id\",\"finding\"], r[0]\nassert len(r) == 31, len(r)\nexpected_ids = [f\"SEC-{i:02d}\" for i in range(1,31)]\ngot_ids = [row[0] for row in r[1:]]\nassert got_ids == expected_ids, got_ids\nfor sid, finding in r[1:]:\n    assert len(row := [sid,finding]) == 2\n    parts = finding.split(\"|\")\n    assert all(p in labels for p in parts), (sid, finding)\n    if len(parts) > 1:\n        # order must be PN | PL | DM\n        order = [\"PROHIBITED_PERSONAL_NARRATIVE\",\"PROTECTED_CLASS_LANGUAGE\",\"DISCLAIMER_MISSING\"]\n        assert parts == [p for p in order if p in parts], (sid, parts)\n# Recount from CSV\nnone_n = sum(1 for _,f in r[1:] if f==\"none\")\nflagged = len(r[1:]) - none_n\npn = sum(1 for _,f in r[1:] if \"PROHIBITED_PERSONAL_NARRATIVE\" in f)\npl = sum(1 for _,f in r[1:] if \"PROTECTED_CLASS_LANGUAGE\" in f)\ndm = sum(1 for _,f in r[1:] if \"DISCLAIMER_MISSING\" in f)\nprint(\"csv rows:\", len(r[1:]), \"none:\", none_n, \"flagged:\", flagged, \"PN:\", pn, \"PL:\", pl, \"DM:\", dm)\n# Validate results.json matches recount\nres = json.load(open(\"/app/results.json\"))\nassert res == {\"section_count\":30,\"flagged_count\":flagged,\"personal_narrative_count\":pn,\"protected_lang_count\":pl,\"disclaimer_missing_count\":dm}, res\nprint(\"results.json:\", res)\nprint(\"ALL CHECKS PASSED\")\nPY" action.permission=* action.action=allow action.pattern=*
