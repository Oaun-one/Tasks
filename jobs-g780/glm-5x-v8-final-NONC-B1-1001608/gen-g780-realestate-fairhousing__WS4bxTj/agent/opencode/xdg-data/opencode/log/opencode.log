timestamp=2026-08-19T13:01:13.458Z level=INFO run=e701d059 message=evaluated permission=bash pattern="python3 - <<'PY'\nimport csv,collections\nrows=list(csv.DictReader(open('fairhousing_audit.csv')))\nsec=len(rows)\nflagged=sum(1 for r in rows if r['finding']!='none')\npn=sum(1 for r in rows if 'PROHIBITED_PERSONAL_NARRATIVE' in r['finding'])\npl=sum(1 for r in rows if 'PROTECTED_CLASS_LANGUAGE' in r['finding'])\ndm=sum(1 for r in rows if 'DISCLAIMER_MISSING' in r['finding'])\nprint('sections',sec,'flagged',flagged,'pn',pn,'pl',pl,'dm',dm)\nimport json; d=json.load(open('results.json'))\nassert d['section_count']==sec and d['flagged_count']==flagged and d['personal_narrative_count']==pn and d['protected_lang_count']==pl and d['disclaimer_missing_count']==dm\nprint('cross-check OK')\n# verify order of labels within each finding\norder=['PROHIBITED_PERSONAL_NARRATIVE','PROTECTED_CLASS_LANGUAGE','DISCLAIMER_MISSING']\nfor r in rows:\n    if r['finding']!='none':\n        labs=r['finding'].split('|')\n        assert labs==sorted(labs,key=lambda x:order.index(x)),(r['section_id'],labs)\nprint('label order OK')\n# verify inventory order preserved\nids=[r['section_id'] for r in rows]\nassert ids==[f'SEC-{i:02d}' for i in range(1,31)], ids\nprint('inventory order OK')\n# verify only 2 columns\nfor r in rows:\n    assert set(r.keys())=={'section_id','finding'}\nprint('column count OK')\nPY" action.permission=* action.action=allow action.pattern=*
