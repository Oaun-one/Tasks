timestamp=2026-08-19T19:08:59.754Z level=INFO run=911c27af message=evaluated permission=bash pattern="python3 -c \"\nimport csv\nrows = list(csv.reader(open('formatting_audit.csv')))\nassert rows[0] == ['section_id','finding']\ndata = rows[1:]\nassert len(data) == 30\norder = ['MARGIN_NONCOMPLIANT','FONT_NONCOMPLIANT','SPACING_NONCOMPLIANT']\nmc=fc=sc=flag=0\nsids=set()\nfor sid,f in data:\n    sids.add(sid)\n    parts = f.split('|')\n    if f != 'none':\n        assert all(p in order for p in parts), (sid,f)\n        expected = [p for p in order if p in parts]\n        assert parts == expected, ('order wrong',sid,f,expected)\n        flag+=1\n        if 'MARGIN_NONCOMPLIANT' in parts: mc+=1\n        if 'FONT_NONCOMPLIANT' in parts: fc+=1\n        if 'SPACING_NONCOMPLIANT' in parts: sc+=1\nassert len(sids)==30\nassert flag==18 and mc==10 and fc==6 and sc==5\nprint('unique sids:',len(sids),'| flagged:',flag,'margin:',mc,'font:',fc,'spacing:',sc)\nprint('ALL CHECKS PASSED')\n\"" action.permission=* action.action=allow action.pattern=*
