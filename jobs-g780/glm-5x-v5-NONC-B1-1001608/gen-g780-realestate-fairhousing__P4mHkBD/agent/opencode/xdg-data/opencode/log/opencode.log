timestamp=2026-08-19T10:03:17.769Z level=INFO run=33948704 message=evaluated permission=bash pattern="cat > /tmp/verify.py << 'PYEOF'\nimport csv, re\n\nrequired = [\"race\",\"color\",\"religion\",\"sex\",\"familial status\",\"national origin\",\n            \"disability\",\"sexual orientation\",\"veteran status\",\"marital status\",\"source of income\"]\nprotected2 = required[:9]  # RE-FH-9 §2 classes (marital/source added by bulletin are disclosure-required, not §2-listed)\n\ndef norm(s):\n    return s.lower().replace(\"colour\",\"color\")\n\nrows = list(csv.DictReader(open(\"/app/input/seller_book_sections.csv\")))\nnotice_pat = re.compile(r\"does not discriminate on the basis of (.*?)\\.\\s*$\", re.S)\n\nfor r in rows:\n    body = norm(r[\"body\"])\n    m = notice_pat.search(body)\n    if m:\n        listed = m.group(1)\n        # split on commas and \"or\"\n        toks = re.split(r\",|\\bor\\b\", listed)\n        toks = [t.strip() for t in toks if t.strip()]\n        named = toks\n        missing = [c for c in required if c not in named]\n        extra = [n for n in named if n not in required]\n        print(f\"{r['section_id']:6} role={r['role']:16} notice=YES named={named} missing={missing} extra={extra} compliant={not missing}\")\n    else:\n        print(f\"{r['section_id']:6} role={r['role']:16} notice=NO\")\nPYEOF" action.permission=* action.action=allow action.pattern=*
