timestamp=2026-08-19T19:04:03.613Z level=INFO run=5f096b37 message=evaluated permission=bash pattern="python3 -c \"\nimport csv,json\nrows=list(csv.DictReader(open('formatting_audit.csv')))\nprint('audit rows:',len(rows))\nprint('cols:',list(rows[0].keys()))\nassert list(rows[0].keys())==['section_id','finding'],'bad header'\norder=['MARGIN_NONCOMPLIANT','FONT_NONCOMPLIANT','SPACING_NONCOMPLIANT']\nfor r in rows:\n    if r['finding']!='none':\n        parts=r['finding'].split('|')\n        assert ' ' not in r['finding'],'space in finding'\n        assert parts==sorted(parts,key=lambda p:order.index(p)),'wrong order'\nprint('all findings well-formed & ordered')\nj=json.load(open('results.json'))\nprint('json:',j)\nassert list(j.keys())==['section_count','flagged_count','margin_count','font_count','spacing_count']\nassert all(isinstance(v,int) for v in j.values())\n# cross-check counts\nmc=sum(1 for r in rows if 'MARGIN_NONCOMPLIANT' in r['finding'])\nfc=sum(1 for r in rows if 'FONT_NONCOMPLIANT' in r['finding'])\nsc=sum(1 for r in rows if 'SPACING_NONCOMPLIANT' in r['finding'])\nfl=sum(1 for r in rows if r['finding']!='none')\nassert (len(rows),fl,mc,fc,sc)==(j['section_count'],j['flagged_count'],j['margin_count'],j['font_count'],j['spacing_count']),'mismatch'\nprint('CSV/JSON consistent')\n\"" action.permission=* action.action=allow action.pattern=*
