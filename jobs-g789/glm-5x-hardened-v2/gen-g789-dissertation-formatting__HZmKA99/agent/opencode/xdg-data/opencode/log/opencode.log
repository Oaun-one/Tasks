timestamp=2026-08-19T19:02:35.279Z level=INFO run=68c0d0c9 message=evaluated permission=bash pattern="cat > /tmp/opencode/audit.py << 'PYEOF'\nimport csv\n\nSUB_DATE = \"2026-03-09\"\n\n# Amendments: id -> effective date\namendments = {\n    \"A-1\": \"2024-06-01\",\n    \"A-2\": \"2025-01-15\",\n    \"A-3\": \"2025-09-01\",\n    \"A-4\": \"2026-07-01\",\n    \"A-5\": \"2025-11-01\",\n}\nprint(\"=== Amendment force (effective <= submission 2026-03-09) ===\")\nfor k,v in amendments.items():\n    print(f\"  {k}: effective {v} -> {'IN FORCE' if v <= SUB_DATE else 'NOT IN FORCE'}\")\n\n# Waivers: id -> (section, rule, scope, expires)\nwaivers = {\n    \"W-1\": (\"SEC-AN-01\", \"Rule2_font_id\", \"2026-12-31\"),\n    \"W-2\": (\"SEC-AN-03\", \"Rule2_font_id\", \"2026-01-31\"),\n    \"W-3\": (\"SEC-LOF\", \"Rule1_outer\", \"2026-11-30\"),\n}\nprint(\"\\n=== Waiver force (expires >= submission 2026-03-09) ===\")\nfor k,(s,scope,exp) in waivers.items():\n    print(f\"  {k}: {s} {scope} expires {exp} -> {'IN FORCE' if exp >= SUB_DATE else 'EXPIRED'}\")\n\nACCEPTED_FONTS = {\"Times New Roman\",\"TimesNewRomanPSMT\",\"Times New Roman PS MT Std\"}\n\n# thresholds\nINNER_MIN = 3.0  # A-2\nOTHER_MIN = 2.5  # base\nFONT_SIZE_REQ = 12.0\nMULT_REQ = 1.5\nEXACT_REQ = 18.0\nLAND_W = 29.7\nPRINTABLE_W = LAND_W - INNER_MIN - OTHER_MIN  # 24.2\nprint(f\"\\nLandscape printable width = {PRINTABLE_W}\")\n\nrows = list(csv.DictReader(open(\"/app/input/dissertation_section_log.csv\")))\nprint(f\"\\nTotal data rows: {len(rows)}\")\n\n# pick highest revision per section_id\nbest = {}\nfor r in rows:\n    sid = r[\"section_id\"]\n    rev = int(r[\"revision\"])\n    if sid not in best or rev > int(best[sid][\"revision\"]):\n        best[sid] = r\n\nsetaside = [r for r in rows if r is not None]\n# count set-aside\nsetaside_ids = []\nfor r in rows:\n    sid = r[\"section_id\"]\n    if int(r[\"revision\"]) != int(best[sid][\"revision\"]):\n        setaside_ids.append((sid, r[\"revision\"]))\nprint(f\"Audited sections: {len(best)}\")\nprint(f\"Set-aside (superseded) rows: {len(setaside_ids)} -> {setaside_ids}\")\n\nprint(\"\\n=== AUDIT ===\")\nfindings = {}\ndef audit(r):\n    sid = r[\"section_id\"]\n    stype = r[\"section_type\"]\n    orient = r[\"orientation\"]\n    mt=float(r[\"margin_top_cm\"]); mb=float(r[\"margin_bottom_cm\"])\n    mi=float(r[\"margin_inner_cm\"]); mo=float(r[\"margin_outer_cm\"])\n    fn=r[\"font_name\"]; fs=float(r[\"font_size_pt\"])\n    sm=r[\"spacing_mode\"]; sv=float(r[\"spacing_value\"])\n    wt=r[\"widest_table_cm\"]; wt=float(wt) if wt else None\n\n    # Rule1 exception A-3\n    exc = False\n    if stype==\"annex\" and orient==\"landscape\" and wt is not None and wt > PRINTABLE_W:\n        exc = True\n\n    f=[]\n    # margins\n    # exception relieves top/bottom/outer only; inner always applies\n    inner_breach = mi < INNER_MIN\n    if exc:\n        breach = inner_breach  # top/bottom/outer relieved\n    else:\n        breach = (mt < OTHER_MIN) or (mb < OTHER_MIN) or (mo < OTHER_MIN) or inner_breach\n    if breach: f.append(\"MARGIN_NONCOMPLIANT\")\n    # font\n    font_breach = (fn not in ACCEPTED_FONTS) or (fs != FONT_SIZE_REQ)\n    # waivers\n    if sid==\"SEC-AN-01\" and fn not in ACCEPTED_FONTS:\n        # W-1 in force, clears font identifier only; size still must be 12.0\n        if fs != FONT_SIZE_REQ:\n            font_breach = True\n        else:\n            font_breach = False  # identifier cleared, size ok\n    if sid==\"SEC-AN-03\" and fn not in ACCEPTED_FONTS:\n        # W-2 expired -> not applied\n        pass\n    if font_breach: f.append(\"FONT_NONCOMPLIANT\")\n    # spacing\n    if sm==\"multiple\":\n        sp_breach = (sv != MULT_REQ)\n    elif sm==\"exact\":\n        sp_breach = (sv != EXACT_REQ)\n    else:\n        sp_breach = True\n    if sp_breach: f.append(\"SPACING_NONCOMPLIANT\")\n    finding = \"|\".join(f) if f else \"none\"\n    return finding, exc, (mt,mb,mi,mo), (fn,fs), (sm,sv), wt\n\nflagged=0; mc=0; fc=0; sc=0\nexc_sections=[]\nfor sid in sorted(best):\n    r=best[sid]\n    finding, exc, margins, font, spacing, wt = audit(r)\n    findings[sid]=finding\n    if exc: exc_sections.append((sid, wt))\n    if finding!=\"none\":\n        flagged+=1\n        if \"MARGIN\" in finding: mc+=1\n        if \"FONT\" in finding: fc+=1\n        if \"SPACING\" in finding: sc+=1\n    print(f\"{sid:12s} type={r['section_type']:11s} orient={r['orientation']:9s} \"\n          f\"margins={margins} font={font} spacing={spacing} wt={wt} exc={exc} -> {finding}\")\n\nprint(f\"\\n=== COUNTS ===\")\nprint(f\"section_count={len(best)} flagged_count={flagged} margin_count={mc} font_count={fc} spacing_count={sc}\")\nprint(f\"\\nException-applied sections: {exc_sections}\")\n\nimport json\nresults={\"section_count\":len(best),\"flagged_count\":flagged,\"margin_count\":mc,\"font_count\":fc,\"spacing_count\":sc}\nprint(\"\\n\"+json.dumps(results))\nPYEOF" action.permission=* action.action=allow action.pattern=*
