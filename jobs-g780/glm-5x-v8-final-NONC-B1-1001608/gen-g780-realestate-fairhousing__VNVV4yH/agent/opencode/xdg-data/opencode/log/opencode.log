timestamp=2026-08-19T13:05:10.249Z level=INFO run=da1a75f8 message=evaluated permission=bash pattern="cat > /tmp/opencode/audit.py << 'PYEOF'\nimport csv, re, json\n\nREQUIRED = [\"race\",\"colour\",\"religion\",\"sex\",\"familial status\",\"national origin\",\n            \"disability\",\"sexual orientation\",\"veteran status\",\"marital status\",\"source of income\"]\n# §2 protected classes (note: marital status & source of income are NOT §2 classes)\nPCLASSES = [\"race\",\"colour\",\"religion\",\"sex\",\"familial status\",\"national origin\",\n            \"disability\",\"sexual orientation\",\"veteran status\"]\nRESP_ROLES = {\"closing_page\",\"agent_bio\"}\n\nrows = list(csv.DictReader(open(\"/app/input/seller_book_sections.csv\")))\n\ndef find_notice(text):\n    # returns the disclosure notice substring if present, else None, plus the own-prose remainder\n    m = re.search(r\"This brokerage complies with the federal Fair Housing Act.*?(?:veteran status|familial status|national origin|source of income)[^.]*\\.\", text)\n    if not m:\n        return None, text\n    notice = m.group(0)\n    prose = text.replace(notice, \" \")\n    return notice, prose\n\ndef classes_named(notice):\n    if not notice: return set()\n    low = notice.lower()\n    named = set()\n    for c in REQUIRED:\n        # treat color == colour\n        variants = [c]\n        if c == \"colour\": variants = [\"colour\",\"color\"]\n        for v in variants:\n            if re.search(r\"\\b\"+re.escape(v)+r\"\\b\", low):\n                named.add(c); break\n    return named\n\ndef has_pclass_language(text):\n    \"\"\"Returns True if text contains a §2 protected-class term or proxy (outside any exempt notice).\"\"\"\n    low = text.lower()\n    # direct class terms (color==colour)\n    direct = [\"race\",\"colour\",\"color\",\"religion\",\"sex\",\"familial status\",\"national origin\",\n              \"disability\",\"sexual orientation\",\"veteran status\"]\n    for t in direct:\n        if re.search(r\"\\b\"+re.escape(t)+r\"\\b\", low):\n            return True\n    # proxies: houses of worship / parish or faith schools / street-by-household\n    proxy_terms = [\"church\",\"churches\",\"churchgoing\",\"parish\",\"faith\",\"worship\",\"congregation\",\n                   \"faith community\"]\n    for t in proxy_terms:\n        if re.search(r\"\\b\"+re.escape(t)+r\"\\b\", low):\n            return True\n    # street described by household type -> familial status\n    household_terms = [\"family-oriented\",\"families\",\"young families\",\"households\",\"household\"]\n    # only count if describing a place/street/block/neighbourhood by household\n    place = re.search(r\"\\b(street|block|neighbourhood|neighborhood|district|area|community)\\b\", low)\n    if place and any(re.search(r\"\\b\"+re.escape(t)+r\"\\b\", low) for t in [\"family-oriented\",\"young families\",\"households\",\"families\",\"churchgoing households\"]):\n        return True\n    # explicit household proxy phrases\n    if re.search(r\"\\b(family-oriented street|churchgoing households|young families|long-established families|congregation-centred)\\b\", low):\n        return True\n    return False\n\ndef has_personal_narrative(text):\n    low = text.lower()\n    pats = [\n        r\"write us a letter\",\n        r\"personal note about yourself\",\n        r\"include a (short )?personal note about (themselves|yourself)\",\n        r\"covering letter introducing yourself\",\n        r\"introduce a (short )?personal note\",\n        r\"letter about what brought you here\",\n        r\"tell us about yourselves\",\n        r\"why this home suits them\",\n        r\"like to know who is buying\",\n    ]\n    for p in pats:\n        if re.search(p, low):\n            return True\n    return False\n\nout = []\nfor r in rows:\n    sid = r[\"section_id\"]; role = r[\"role\"]; body = r[\"body\"]; title=r[\"title\"]\n    full = title + \" \" + body\n    notice, prose = find_notice(body)\n    named = classes_named(notice)\n    complete = (notice is not None) and named == set(REQUIRED)\n    abridged = (notice is not None) and not complete\n    findings = []\n    # §1\n    if has_personal_narrative(full):\n        findings.append(\"PROHIBITED_PERSONAL_NARRATIVE\")\n    # §2: protected-class language. Exempt only the notice terms IF complete.\n    # Build text to test: own prose always; notice terms only if abridged (no exemption) or if no exemption applies\n    pcl = False\n    if has_pclass_language(prose + \" \" + title):\n        pcl = True\n    if abridged:\n        # no exemption -> notice terms count\n        if has_pclass_language(notice):\n            pcl = True\n    if pcl:\n        findings.append(\"PROTECTED_CLASS_LANGUAGE\")\n    # §4: responsible roles\n    if role in RESP_ROLES:\n        if not complete:  # no notice or abridged\n            findings.append(\"DISCLAIMER_MISSING\")\n    finding = \"|\".join(findings) if findings else \"none\"\n    out.append((sid, role, finding, sorted(named), \"complete\" if complete else (\"abridged\" if abridged else \"none\"), notice is not None))\n\nfor sid, role, finding, named, status, hasn in out:\n    print(f\"{sid}\\t{role:16s}\\t{status:9s}\\t{finding}\")\n\n# counts\nsc = len(out)\nflag = sum(1 for _,_,f,_,_,_ in out if f!=\"none\")\npn = sum(1 for _,_,f,_,_,_ in out if \"PROHIBITED_PERSONAL_NARRATIVE\" in f)\npl = sum(1 for _,_,f,_,_,_ in out if \"PROTECTED_CLASS_LANGUAGE\" in f)\ndm = sum(1 for _,_,f,_,_,_ in out if \"DISCLAIMER_MISSING\" in f)\nprint(\"\\nCOUNTS:\", sc, flag, pn, pl, dm)\nprint(\"CLEAN:\", [s for s,_,f,_,_,_ in out if f==\"none\"])\nPYEOF" action.permission=* action.action=allow action.pattern=*
