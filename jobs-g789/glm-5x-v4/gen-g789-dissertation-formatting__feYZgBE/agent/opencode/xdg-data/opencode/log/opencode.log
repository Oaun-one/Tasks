timestamp=2026-08-19T20:03:23.285Z level=INFO run=f0f06040 message=evaluated permission=bash pattern="python3 -c \"\nimport csv, json\nfrom collections import Counter\nrows=list(csv.DictReader(open('formatting_audit.csv')))\ncode_order=['MARGIN_NONCOMPLIANT','TYPE_AREA_INVALID','LEADING_NONCOMPLIANT','FONT_NONCOMPLIANT','HEADING_STYLE_INVALID','CAPTION_MISSING','NUMBERING_INVALID']\n# verify order within each finding field\nimport re\nbad_order=0\nclean=0; flagged=0; ftotal=0; c=Counter(); arc=0; rd=0\ntpl={'PART-00':'TPL-ARCHIVE','PART-01':'TPL-ARCHIVE','PART-02':'TPL-ARCHIVE','PART-03':'TPL-READING','PART-04':'TPL-READING','PART-05':'TPL-ARCHIVE','PART-06':'TPL-READING','PART-07':'TPL-ARCHIVE'}\nfor r in rows:\n    f=r['finding']\n    assert r['template_id']==tpl[r['part_id']], r\n    if f=='none':\n        clean+=1\n    else:\n        flagged+=1\n        codes=f.split('|')\n        # check order matches canonical\n        idxs=[code_order.index(x) for x in codes]\n        if idxs!=sorted(idxs): bad_order+=1; print('ORDER BAD',r['section_id'],codes)\n        for x in codes: c[x]+=1\n        ftotal+=len(codes)\n        if tpl[r['part_id']]=='TPL-ARCHIVE': arc+=1\n        else: rd+=1\nd=json.load(open('results.json'))\nchecks={\n 'section_count':len(rows)==d['section_count'],\n 'clean_section_count':clean==d['clean_section_count'],\n 'flagged_section_count':flagged==d['flagged_section_count'],\n 'finding_total':ftotal==d['finding_total'],\n 'margin_count':c['MARGIN_NONCOMPLIANT']==d['margin_count'],\n 'type_area_count':c['TYPE_AREA_INVALID']==d['type_area_count'],\n 'leading_count':c['LEADING_NONCOMPLIANT']==d['leading_count'],\n 'font_count':c['FONT_NONCOMPLIANT']==d['font_count'],\n 'heading_count':c['HEADING_STYLE_INVALID']==d['heading_count'],\n 'caption_missing_count':c['CAPTION_MISSING']==d['caption_missing_count'],\n 'numbering_count':c['NUMBERING_INVALID']==d['numbering_count'],\n 'flagged_archive_sections':arc==d['flagged_archive_sections'],\n 'flagged_reading_sections':rd==d['flagged_reading_sections'],\n}\nprint('finding-order issues:', bad_order)\nprint('all checks pass:', all(checks.values()))\nfor k,v in checks.items():\n    if not v: print('  MISMATCH:',k)\n# part summary cross-check\nps=list(csv.DictReader(open('part_summary.csv')))\nprint('part_summary rows:',len(ps))\ntot_sec=sum(int(x['section_count']) for x in ps)\ntot_flg=sum(int(x['flagged_sections']) for x in ps)\ninv=[x for x in ps if x['pagination']=='PAGINATION_INVALID']\nprint('sum section_count:',tot_sec,'==',d['section_count'],'->',tot_sec==d['section_count'])\nprint('sum flagged_sections:',tot_flg,'==',d['flagged_section_count'],'->',tot_flg==d['flagged_section_count'])\nprint('pagination_invalid_parts:',len(inv),'==',d['pagination_invalid_parts'],'->',len(inv)==d['pagination_invalid_parts'])\nsiv=sum(int(x['section_count']) for x in inv)\nprint('sections_in_invalid_parts:',siv,'==',d['sections_in_invalid_parts'],'->',siv==d['sections_in_invalid_parts'])\n\"" action.permission=* action.action=allow action.pattern=*
