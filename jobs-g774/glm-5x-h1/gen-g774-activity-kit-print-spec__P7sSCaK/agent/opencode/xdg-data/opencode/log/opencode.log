timestamp=2026-08-20T03:43:59.904Z level=INFO run=c82c906d message=evaluated permission=bash pattern="cat > /tmp/opencode/audit.py << 'PYEOF'\nimport csv, json, math, os\nfrom collections import defaultdict\n\nINP = \"/app/input\"\nOUT = \"/app\"\n\n# Load stock profiles\nstocks = {}\nwith open(f\"{INP}/stock_profiles.csv\") as f:\n    for r in csv.DictReader(f):\n        stocks[r[\"stock_code\"]] = {\n            \"min_dpi\": int(r[\"min_dpi\"]),\n            \"min_margin_in\": float(r[\"min_margin_in\"]),\n            \"max_ink_pct\": int(r[\"max_ink_pct\"]),\n            \"min_bleed_in\": float(r[\"min_bleed_in\"]),\n        }\n\n# Load sections\nsections = {}\nwith open(f\"{INP}/kit_sections.csv\") as f:\n    for r in csv.DictReader(f):\n        sections[r[\"section_id\"]] = {\n            \"binding\": r[\"binding\"],\n            \"stock_code\": r[\"stock_code\"],\n        }\n\n# Base element minimums\nbase_min = {\n    \"cover\": 1,\n    \"parent_guide\": 2,\n    \"map\": 4,\n    \"activity\": 4,\n    \"mission_cards\": 6,\n    \"bingo\": 9,\n    \"badge_certificate\": 4,\n}\n\ndef elem_min(page_type, binding):\n    m = base_min[page_type]\n    if binding == \"saddle_stitch\" and page_type in (\"mission_cards\", \"badge_certificate\"):\n        m += 2\n    return m\n\n# Load all page rows\nrows = []\nwith open(f\"{INP}/activity_kit_pages.csv\") as f:\n    for r in csv.DictReader(f):\n        r[\"revision\"] = int(r[\"revision\"])\n        r[\"artwork_dpi\"] = int(r[\"artwork_dpi\"])\n        r[\"placement_scale_pct\"] = int(r[\"placement_scale_pct\"])\n        r[\"margin_in\"] = float(r[\"margin_in\"])\n        r[\"full_bleed_design\"] = r[\"full_bleed_design\"] == \"True\"\n        r[\"bleed_in\"] = float(r[\"bleed_in\"])\n        r[\"total_ink_pct\"] = int(r[\"total_ink_pct\"])\n        r[\"element_count\"] = int(r[\"element_count\"])\n        rows.append(r)\n\n# Pick live (highest revision) per page_id; track superseded\nby_page = defaultdict(list)\nfor r in rows:\n    by_page[r[\"page_id\"]].append(r)\n\nlive = {}\nsuperseded = []\nfor pid, lst in by_page.items():\n    lst_sorted = sorted(lst, key=lambda x: x[\"revision\"])\n    live[pid] = lst_sorted[-1]\n    for r in lst_sorted[:-1]:\n        superseded.append(r)\n\n# Sort live by page_id numerically\ndef pnum(pid):\n    return int(pid.split(\"-\")[1])\nlive_ids = sorted(live.keys(), key=pnum)\n\naudit_rows = []\ncounts = {\n    \"dpi_low\": 0, \"margin\": 0, \"bleed_short\": 0,\n    \"ink_over\": 0, \"element_short\": 0,\n}\nfinding_total = 0\nshortfall_total = 0\nclean_count = 0\n\nfor pid in live_ids:\n    r = live[pid]\n    sec = sections[r[\"section_id\"]]\n    st = stocks[sec[\"stock_code\"]]\n    findings = []\n\n    eff_dpi = math.floor(r[\"artwork_dpi\"] * 100 / r[\"placement_scale_pct\"])\n    if eff_dpi < st[\"min_dpi\"]:\n        findings.append(\"DPI_TOO_LOW\")\n\n    if not r[\"full_bleed_design\"]:\n        if r[\"margin_in\"] < st[\"min_margin_in\"]:\n            findings.append(\"MARGIN_VIOLATION\")\n\n    if r[\"full_bleed_design\"]:\n        if r[\"bleed_in\"] < st[\"min_bleed_in\"]:\n            findings.append(\"BLEED_SHORT\")\n\n    if r[\"total_ink_pct\"] > st[\"max_ink_pct\"]:\n        findings.append(\"INK_OVER\")\n\n    emin = elem_min(r[\"page_type\"], sec[\"binding\"])\n    shortfall = max(0, emin - r[\"element_count\"])\n    if r[\"element_count\"] < emin:\n        findings.append(\"ELEMENT_COUNT_SHORT\")\n\n    finding_str = \"|\".join(findings) if findings else \"none\"\n\n    audit_rows.append({\n        \"page_id\": pid,\n        \"artwork_id\": r[\"artwork_id\"],\n        \"revision\": r[\"revision\"],\n        \"page_name\": r[\"page_name\"],\n        \"page_type\": r[\"page_type\"],\n        \"section_id\": r[\"section_id\"],\n        \"finding\": finding_str,\n        \"effective_dpi\": eff_dpi,\n        \"margin_in\": r[\"margin_in\"],\n        \"bleed_in\": r[\"bleed_in\"],\n        \"total_ink_pct\": r[\"total_ink_pct\"],\n        \"element_count\": r[\"element_count\"],\n        \"element_min\": emin,\n        \"shortfall\": shortfall,\n        \"stock_code\": sec[\"stock_code\"],\n        \"min_dpi\": st[\"min_dpi\"],\n        \"min_margin_in\": st[\"min_margin_in\"],\n        \"min_bleed_in\": st[\"min_bleed_in\"],\n        \"max_ink_pct\": st[\"max_ink_pct\"],\n        \"full_bleed_design\": r[\"full_bleed_design\"],\n    })\n\n    if findings:\n        finding_total += len(findings)\n        if \"DPI_TOO_LOW\" in findings: counts[\"dpi_low\"] += 1\n        if \"MARGIN_VIOLATION\" in findings: counts[\"margin\"] += 1\n        if \"BLEED_SHORT\" in findings: counts[\"bleed_short\"] += 1\n        if \"INK_OVER\" in findings: counts[\"ink_over\"] += 1\n        if \"ELEMENT_COUNT_SHORT\" in findings:\n            counts[\"element_short\"] += 1\n            shortfall_total += shortfall\n    else:\n        clean_count += 1\n\npage_count = len(audit_rows)\nflagged_count = page_count - clean_count\n\n# Write audit CSV (keyed by page_id + finding)\ncols = [\"page_id\",\"artwork_id\",\"revision\",\"page_name\",\"page_type\",\"section_id\",\"finding\"]\nwith open(f\"{OUT}/activity_kit_audit.csv\",\"w\",newline=\"\") as f:\n    w = csv.DictWriter(f, fieldnames=cols)\n    w.writeheader()\n    for a in audit_rows:\n        w.writerow({k:a[k] for k in cols})\n\n# results.json\nresults = {\n    \"page_count\": page_count,\n    \"superseded_count\": len(superseded),\n    \"clean_count\": clean_count,\n    \"flagged_count\": flagged_count,\n    \"finding_total\": finding_total,\n    \"dpi_low_count\": counts[\"dpi_low\"],\n    \"margin_count\": counts[\"margin\"],\n    \"bleed_short_count\": counts[\"bleed_short\"],\n    \"ink_over_count\": counts[\"ink_over\"],\n    \"element_short_count\": counts[\"element_short\"],\n    \"element_shortfall_total\": shortfall_total,\n}\nwith open(f\"{OUT}/results.json\",\"w\") as f:\n    json.dump(results, f, indent=2)\n\n# Print summary for verification\nprint(\"LIVE PAGES:\", page_count)\nprint(\"SUPERSEDED:\", len(superseded), [s[\"artwork_id\"] for s in superseded])\nprint(\"CLEAN:\", clean_count, \"FLAGGED:\", flagged_count)\nprint(\"FINDING_TOTAL:\", finding_total)\nprint(\"counts:\", counts)\nprint(\"shortfall_total:\", shortfall_total)\nprint()\nfor a in audit_rows:\n    print(f\"{a['page_id']} {a['artwork_id']} r{a['revision']} {a['page_type']:18} {a['section_id']} eff={a['effective_dpi']} mar={a['margin_in']} ble={a['bleed_in']} ink={a['total_ink_pct']} el={a['element_count']}/{a['element_min']} fb={a['full_bleed_design']} -> {a['finding']}\")\n\n# Save audit_rows + superseded info to a temp json for memo generation\nwith open(\"/tmp/opencode/audit_full.json\",\"w\") as f:\n    json.dump({\"audit\":audit_rows,\"superseded\":superseded,\"live\":live}, f, indent=2, default=str)\nPYEOF" action.permission=* action.action=allow action.pattern=*
