timestamp=2026-08-19T13:06:39.763Z level=INFO run=da1a75f8 message=evaluated permission=bash pattern="cat > /tmp/opencode/audit_final.py << 'PYEOF'\nimport csv, re\nREQUIRED = [\"race\",\"colour\",\"religion\",\"sex\",\"familial status\",\"national origin\",\n            \"disability\",\"sexual orientation\",\"veteran status\",\"marital status\",\"source of income\"]\nRESP = {\"closing_page\",\"agent_bio\"}\nMARKER = \"this brokerage complies with the federal fair housing act\"\nrows=list(csv.DictReader(open(\"/app/input/seller_book_sections.csv\")))\ndef notice(t):\n    low=t.lower(); i=low.find(MARKER)\n    return (None,t) if i==-1 else (t[i:], t[:i])\ndef named(n):\n    if not n: return set()\n    low=n.lower(); s=set()\n    for c in REQUIRED:\n        vs=[c] if c!=\"colour\" else [\"colour\",\"color\"]\n        for v in vs:\n            if re.search(r\"\\b\"+re.escape(v)+r\"\\b\", low): s.add(c); break\n    return s\ndef pcl(t):\n    low=t.lower()\n    for t2 in [\"race\",\"colour\",\"color\",\"religion\",\"sex\",\"familial status\",\"national origin\",\"disability\",\"sexual orientation\",\"veteran status\"]:\n        if re.search(r\"\\b\"+re.escape(t2)+r\"\\b\", low): return True\n    for t2 in [\"church\",\"churches\",\"churchgoing\",\"parish\",\"faith\",\"worship\",\"congregation\"]:\n        if re.search(r\"\\b\"+re.escape(t2)+r\"\\b\", low): return True\n    if re.search(r\"\\b(family-oriented|young families|churchgoing households|long-established families|congregation-centred)\\b\", low): return True\n    if re.search(r\"\\b(street|block|neighbourhood|neighborhood)\\b\", low) and re.search(r\"\\b(households|families|family-oriented)\\b\", low): return True\n    return False\ndef pn(t):\n    low=t.lower()\n    return any(re.search(p,low) for p in [r\"write us a letter\",r\"personal note about yourself\",r\"personal note about themselves\",r\"covering letter introducing yourself\",r\"introduce a short personal note\",r\"letter about what brought you here\",r\"tell us about yourselves\",r\"why this home suits them\",r\"like to know who is buying\"])\nHAND={\n\"SEC-01\":\"none\",\"SEC-02\":\"PROHIBITED_PERSONAL_NARRATIVE\",\"SEC-03\":\"PROTECTED_CLASS_LANGUAGE\",\n\"SEC-04\":\"PROTECTED_CLASS_LANGUAGE\",\"SEC-05\":\"DISCLAIMER_MISSING\",\"SEC-06\":\"none\",\n\"SEC-07\":\"PROHIBITED_PERSONAL_NARRATIVE|PROTECTED_CLASS_LANGUAGE|DISCLAIMER_MISSING\",\n\"SEC-08\":\"PROHIBITED_PERSONAL_NARRATIVE\",\"SEC-09\":\"PROTECTED_CLASS_LANGUAGE|DISCLAIMER_MISSING\",\n\"SEC-10\":\"none\",\"SEC-11\":\"PROTECTED_CLASS_LANGUAGE|DISCLAIMER_MISSING\",\n\"SEC-12\":\"PROTECTED_CLASS_LANGUAGE|DISCLAIMER_MISSING\",\"SEC-13\":\"none\",\n\"SEC-14\":\"PROTECTED_CLASS_LANGUAGE|DISCLAIMER_MISSING\",\"SEC-15\":\"PROTECTED_CLASS_LANGUAGE|DISCLAIMER_MISSING\",\n\"SEC-16\":\"PROTECTED_CLASS_LANGUAGE|DISCLAIMER_MISSING\",\"SEC-17\":\"PROHIBITED_PERSONAL_NARRATIVE|PROTECTED_CLASS_LANGUAGE\",\n\"SEC-18\":\"none\",\"SEC-19\":\"PROTECTED_CLASS_LANGUAGE\",\"SEC-20\":\"none\",\"SEC-21\":\"DISCLAIMER_MISSING\",\n\"SEC-22\":\"PROTECTED_CLASS_LANGUAGE\",\"SEC-23\":\"PROTECTED_CLASS_LANGUAGE|DISCLAIMER_MISSING\",\n\"SEC-24\":\"PROHIBITED_PERSONAL_NARRATIVE\",\"SEC-25\":\"PROTECTED_CLASS_LANGUAGE\",\"SEC-26\":\"none\",\n\"SEC-27\":\"PROHIBITED_PERSONAL_NARRATIVE\",\"SEC-28\":\"none\",\"SEC-29\":\"PROHIBITED_PERSONAL_NARRATIVE\",\n\"SEC-30\":\"DISCLAIMER_MISSING\"}\nout=[]\nallok=True\nfor r in rows:\n    sid=r[\"section_id\"]; role=r[\"role\"]; body=r[\"body\"]; title=r[\"title\"]\n    n,p=notice(body); nm=named(n)\n    complete = n is not None and nm==set(REQUIRED)\n    abridged = n is not None and not complete\n    f=[]\n    if pn(title+\" \"+body): f.append(\"PROHIBITED_PERSONAL_NARRATIVE\")\n    hit = pcl(p+\" \"+title)\n    if abridged and pcl(n): hit=True\n    if hit: f.append(\"PROTECTED_CLASS_LANGUAGE\")\n    if role in RESP and not complete: f.append(\"DISCLAIMER_MISSING\")\n    finding=\"|\".join(f) if f else \"none\"\n    ok = finding==HAND[sid]\n    if not ok: allok=False\n    out.append((sid,finding))\n    print(f\"{sid}: {finding:62s} {'OK' if ok else 'MISMATCH hand='+HAND[sid]}\")\nprint(\"\\nALL MATCH:\", allok)\nsc=len(out); flag=sum(1 for _,f in out if f!=\"none\")\na=sum(1 for _,f in out if \"PROHIBITED_PERSONAL_NARRATIVE\" in f)\nb=sum(1 for _,f in out if \"PROTECTED_CLASS_LANGUAGE\" in f)\nc=sum(1 for _,f in out if \"DISCLAIMER_MISSING\" in f)\nimport json\nprint(json.dumps({\"section_count\":sc,\"flagged_count\":flag,\"personal_narrative_count\":a,\"protected_lang_count\":b,\"disclaimer_missing_count\":c},indent=2))\nprint(\"CLEAN:\", [s for s,f in out if f==\"none\"])\nPYEOF" action.permission=* action.action=allow action.pattern=*
