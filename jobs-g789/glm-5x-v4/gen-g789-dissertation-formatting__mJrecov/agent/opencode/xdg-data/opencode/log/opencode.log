timestamp=2026-08-19T20:04:40.483Z level=INFO run=a456e0ad message=evaluated permission=bash pattern="python3 -c \"\nimport csv, json\nrows = list(csv.DictReader(open('formatting_audit.csv')))\ncodes = ['MARGIN_NONCOMPLIANT','TYPE_AREA_INVALID','LEADING_NONCOMPLIANT','FONT_NONCOMPLIANT','HEADING_STYLE_INVALID','CAPTION_MISSING','NUMBERING_INVALID']\nflagged = [r for r in rows if r['finding']!='none']\nclean = [r for r in rows if r['finding']=='none']\nftotal = 0\ncounts = {c:0 for c in codes}\nfor r in rows:\n    if r['finding']!='none':\n        for c in r['finding'].split('|'):\n            counts[c]+=1\n            ftotal+=1\n# verify ordering of each finding string matches standard order\norder_idx = {c:i for i,c in enumerate(codes)}\nfor r in rows:\n    if r['finding']!='none':\n        fs=r['finding'].split('|')\n        idxs=[order_idx[c] for c in fs]\n        assert idxs==sorted(idxs), ('order wrong', r['section_id'], r['finding'])\n# template split of flagged (need part_plan)\npp = {x['part_id']:x['template_id'] for x in csv.DictReader(open('input/part_plan.csv'))}\nfa = sum(1 for r in flagged if pp[r['part_id']]=='TPL-ARCHIVE')\nfr = sum(1 for r in flagged if pp[r['part_id']]=='TPL-READING')\nrj = json.load(open('results.json'))\nprint('audit rows:', len(rows), '== results.section_count', rj['section_count'])\nprint('flagged:', len(flagged), '==', rj['flagged_section_count'])\nprint('clean:', len(clean), '==', rj['clean_section_count'])\nprint('finding_total:', ftotal, '==', rj['finding_total'])\nfor c in codes:\n    key=c.replace('MARGIN_NONCOMPLIANT','margin_count').replace('TYPE_AREA_INVALID','type_area_count').replace('LEADING_NONCOMPLIANT','leading_count').replace('FONT_NONCOMPLIANT','font_count').replace('HEADING_STYLE_INVALID','heading_count').replace('CAPTION_MISSING','caption_missing_count').replace('NUMBERING_INVALID','numbering_count')\n    print(c, counts[c], '==', rj[key], 'OK' if counts[c]==rj[key] else 'MISMATCH')\nprint('flagged_archive', fa, '==', rj['flagged_archive_sections'])\nprint('flagged_reading', fr, '==', rj['flagged_reading_sections'])\nprint('All finding strings correctly ordered:', True)\n\"" action.permission=* action.action=allow action.pattern=*
