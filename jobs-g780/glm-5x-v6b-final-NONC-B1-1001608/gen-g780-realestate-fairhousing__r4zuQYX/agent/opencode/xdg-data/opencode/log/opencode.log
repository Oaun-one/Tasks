timestamp=2026-08-19T10:33:13.328Z level=INFO run=350b177b message=evaluated permission=bash pattern="python3 - <<'EOF'\nimport csv, json\nrows = list(csv.DictReader(open('/app/fairhousing_audit.csv')))\nids = [r['section_id'] for r in rows]\nassert len(ids) == 30, len(ids)\nassert ids == sorted(ids, key=lambda s: int(s.split('-')[1])), \"not in inventory order\"\nassert all(set(r.keys()) == {'section_id','finding'} for r in rows), \"extra columns\"\nlabels = ['PROHIBITED_PERSONAL_NARRATIVE','PROTECTED_CLASS_LANGUAGE','DISCLAIMER_MISSING']\nnone = sum(1 for r in rows if r['finding']=='none')\nflagged = sum(1 for r in rows if r['finding']!='none')\ncounts = { 'section_count': 30, 'flagged_count': flagged,\n  'personal_narrative_count': sum(1 for r in rows if 'PROHIBITED_PERSONAL_NARRATIVE' in r['finding']),\n  'protected_lang_count': sum(1 for r in rows if 'PROTECTED_CLASS_LANGUAGE' in r['finding']),\n  'disclaimer_missing_count': sum(1 for r in rows if 'DISCLAIMER_MISSING' in r['finding']) }\nres = json.load(open('/app/results.json'))\nprint(\"recomputed:\", counts)\nprint(\"results.json:\", res)\nassert counts == res, \"MISMATCH\"\n# verify join order for multi-label findings\nfor r in rows:\n    parts = r['finding'].split('|')\n    if len(parts) > 1:\n        assert parts == [l for l in labels if l in r['finding']], (r['section_id'], parts)\nprint(\"OK: 30 rows, in order, 2 cols, counts match, multi-label order correct, JSON valid\")\nEOF" action.permission=* action.action=allow action.pattern=*
