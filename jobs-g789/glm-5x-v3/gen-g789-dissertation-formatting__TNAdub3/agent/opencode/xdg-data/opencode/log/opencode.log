timestamp=2026-08-19T19:41:42.176Z level=INFO run=716e7d97 message=evaluated permission=bash pattern="python3 -c \"\nimport json,csv\nd=json.load(open('results.json'))\nrows=list(csv.DictReader(open('formatting_audit.csv')))\nflag=[r for r in rows if r['finding']!='none']\nprint('audit rows',len(rows),'flagged',len(flag),'clean',len(rows)-len(flag))\n# count finding occurrences\nfrom collections import Counter\nc=Counter()\nfor r in flag:\n    for k in r['finding'].split('|'): c[k]+=1\norder=['MARGIN_NONCOMPLIANT','TYPE_AREA_INVALID','LEADING_NONCOMPLIANT','FONT_NONCOMPLIANT','HEADING_STYLE_INVALID','CAPTION_MISSING','NUMBERING_INVALID']\nprint('per-type:',{k:c[k] for k in order},'sum',sum(c.values()))\nprint('json matches:', d['section_count']==len(rows), d['flagged_section_count']==len(flag), d['finding_total']==sum(c.values()))\n\"" action.permission=* action.action=allow action.pattern=*
