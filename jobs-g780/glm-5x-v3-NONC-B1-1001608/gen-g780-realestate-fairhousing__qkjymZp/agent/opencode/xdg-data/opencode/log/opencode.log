timestamp=2026-08-19T09:25:52.685Z level=INFO run=fc7033b2 message=evaluated permission=bash pattern="python3 - <<'PY'\nimport csv, json\nrows=list(csv.DictReader(open('fairhousing_audit.csv')))\nlabels=[\"PROHIBITED_PERSONAL_NARRATIVE\",\"PROTECTED_CLASS_LANGUAGE\",\"DISCLAIMER_MISSING\"]\ndef has(f,l): return l in f.split(\"|\")\ncounts={\n \"section_count\": len(rows),\n \"flagged_count\": sum(1 for r in rows if r[\"finding\"]!=\"none\"),\n \"personal_narrative_count\": sum(1 for r in rows if has(r[\"finding\"],\"PROHIBITED_PERSONAL_NARRATIVE\")),\n \"protected_lang_count\": sum(1 for r in rows if has(r[\"finding\"],\"PROTECTED_CLASS_LANGUAGE\")),\n \"disclaimer_missing_count\": sum(1 for r in rows if has(r[\"finding\"],\"DISCLAIMER_MISSING\")),\n}\nres=json.load(open('results.json'))\nprint(\"computed:\",counts)\nprint(\"results.json:\",res)\nprint(\"MATCH\" if counts==res else \"MISMATCH\")\n# sanity: only two columns, header, no extra rows\nassert list(rows[0].keys())==[\"section_id\",\"finding\"], rows[0].keys()\nfor r in rows:\n    for l in r[\"finding\"].split(\"|\"):\n        assert l==\"none\" or l in labels, (r, l)\nprint(\"columns/labels OK\")\nPY" action.permission=* action.action=allow action.pattern=*
