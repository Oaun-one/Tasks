timestamp=2026-08-20T04:04:38.678Z level=INFO run=7da4f70a message=evaluated permission=bash pattern="python3 -c \"\nimport csv, json\naudit = list(csv.DictReader(open('activity_kit_audit.csv')))\nsumm = list(csv.DictReader(open('section_summary.csv')))\nres = json.load(open('results.json'))\n\n# audit checks\nassert len(audit) == res['page_count'] == 36, 'page count mismatch'\nclean = [r for r in audit if r['finding']=='none']\nflagged = [r for r in audit if r['finding']!='none']\nassert len(clean) == res['clean_count'] == 11\nassert len(flagged) == res['flagged_count'] == 25\n\n# finding_total = total codes\ntot = 0\nper = {'DPI_TOO_LOW':0,'MARGIN_VIOLATION':0,'BLEED_SHORT':0,'INK_OVER':0,'ELEMENT_COUNT_SHORT':0}\nfor r in flagged:\n    codes = r['finding'].split('|')\n    tot += len(codes)\n    for c in codes: per[c]+=1\nassert tot == res['finding_total'] == 41, tot\nassert per['DPI_TOO_LOW']==res['dpi_low_count']==9\nassert per['MARGIN_VIOLATION']==res['margin_count']==11\nassert per['BLEED_SHORT']==res['bleed_short_count']==3\nassert per['INK_OVER']==res['ink_over_count']==8\nassert per['ELEMENT_COUNT_SHORT']==res['element_short_count']==10\n\n# section summary checks\nassert len(summ) == res['section_count'] == 8\nassert sum(int(s['live_page_count']) for s in summ) == 36\nassert sum(int(s['held_back']) for s in summ) == 10\nassert sum(int(s['flagged_pages']) for s in summ) == 25\ninv = [s for s in summ if s['imposition']=='IMPOSITION_INVALID']\nassert len(inv) == res['imposition_invalid_sections'] == 4\nprint('All cross-checks passed.')\nprint('Invalid sections:', [s['section_id'] for s in inv])\n\"" action.permission=* action.action=allow action.pattern=*
