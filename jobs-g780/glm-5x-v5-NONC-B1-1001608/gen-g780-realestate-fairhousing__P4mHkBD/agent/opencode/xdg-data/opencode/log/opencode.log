timestamp=2026-08-19T10:03:23.668Z level=INFO run=33948704 message=evaluated permission=bash pattern="cat > /tmp/final.py << 'PYEOF'\nfindings = {\n\"SEC-01\":\"none\",\n\"SEC-02\":\"PROHIBITED_PERSONAL_NARRATIVE\",\n\"SEC-03\":\"PROTECTED_CLASS_LANGUAGE\",\n\"SEC-04\":\"PROTECTED_CLASS_LANGUAGE\",\n\"SEC-05\":\"DISCLAIMER_MISSING\",\n\"SEC-06\":\"none\",\n\"SEC-07\":\"PROHIBITED_PERSONAL_NARRATIVE|PROTECTED_CLASS_LANGUAGE|DISCLAIMER_MISSING\",\n\"SEC-08\":\"PROHIBITED_PERSONAL_NARRATIVE\",\n\"SEC-09\":\"PROTECTED_CLASS_LANGUAGE|DISCLAIMER_MISSING\",\n\"SEC-10\":\"none\",\n\"SEC-11\":\"PROTECTED_CLASS_LANGUAGE|DISCLAIMER_MISSING\",\n\"SEC-12\":\"none\",\n\"SEC-13\":\"none\",\n\"SEC-14\":\"PROTECTED_CLASS_LANGUAGE|DISCLAIMER_MISSING\",\n\"SEC-15\":\"PROTECTED_CLASS_LANGUAGE|DISCLAIMER_MISSING\",\n\"SEC-16\":\"none\",\n\"SEC-17\":\"PROHIBITED_PERSONAL_NARRATIVE|PROTECTED_CLASS_LANGUAGE\",\n\"SEC-18\":\"none\",\n\"SEC-19\":\"PROTECTED_CLASS_LANGUAGE\",\n\"SEC-20\":\"none\",\n\"SEC-21\":\"DISCLAIMER_MISSING\",\n\"SEC-22\":\"PROTECTED_CLASS_LANGUAGE\",\n\"SEC-23\":\"none\",\n\"SEC-24\":\"PROHIBITED_PERSONAL_NARRATIVE\",\n\"SEC-25\":\"PROTECTED_CLASS_LANGUAGE\",\n\"SEC-26\":\"none\",\n\"SEC-27\":\"PROHIBITED_PERSONAL_NARRATIVE\",\n\"SEC-28\":\"none\",\n\"SEC-29\":\"PROHIBITED_PERSONAL_NARRATIVE\",\n\"SEC-30\":\"DISCLAIMER_MISSING\",\n}\nimport csv\ninv = [r[\"section_id\"] for r in csv.DictReader(open(\"/app/input/seller_book_sections.csv\"))]\nassert list(findings.keys()) == inv, \"order mismatch!\"\nassert len(inv)==30\nlabels = [\"PROHIBITED_PERSONAL_NARRATIVE\",\"PROTECTED_CLASS_LANGUAGE\",\"DISCLAIMER_MISSING\",\"none\"]\n# verify join order\nfor k,v in findings.items():\n    if \"|\" in v:\n        parts=v.split(\"|\")\n        idx=[labels.index(p) for p in parts]\n        assert idx==sorted(idx), f\"order wrong {k}\"\nflagged = [k for k,v in findings.items() if v!=\"none\"]\nprint(\"section_count\", len(inv))\nprint(\"flagged_count\", len(flagged))\nprint(\"personal_narrative_count\", sum(\"PROHIBITED_PERSONAL_NARRATIVE\" in v for v in findings.values()))\nprint(\"protected_lang_count\", sum(\"PROTECTED_CLASS_LANGUAGE\" in v for v in findings.values()))\nprint(\"disclaimer_missing_count\", sum(\"DISCLAIMER_MISSING\" in v for v in findings.values()))\nprint(\"flagged sections:\", flagged)\nPYEOF" action.permission=* action.action=allow action.pattern=*
