timestamp=2026-08-19T10:00:33.547Z level=INFO run=fd0af30a message=evaluated permission=bash pattern="python3 -c \"\nimport csv,json\nrows=list(csv.DictReader(open('fairhousing_audit.csv')))\nprint('rows:',len(rows))\nprint('cols:',list(rows[0].keys()))\nbad=[r for r in rows if set(r.keys())!={'section_id','finding'}]\nprint('rows with extra cols:',len(bad))\norder=['SEC-%02d'%i for i in range(1,31)]\nprint('inventory order ok:', [r['section_id'] for r in rows]==order)\nvalid={'PROHIBITED_PERSONAL_NARRATIVE','PROTECTED_CLASS_LANGUAGE','DISCLAIMER_MISSING','none'}\nfor r in rows:\n    parts=r['finding'].split('|')\n    assert all(p in valid for p in parts), r\n    assert r['finding']=='none' or parts==sorted(parts, key=lambda x:['PROHIBITED_PERSONAL_NARRATIVE','PROTECTED_CLASS_LANGUAGE','DISCLAIMER_MISSING'].index(x)), r\nprint('all findings well-formed & ordered')\n# recount from CSV\nfl=sum(1 for r in rows if r['finding']!='none')\npn=sum(1 for r in rows if 'PROHIBITED_PERSONAL_NARRATIVE' in r['finding'])\npl=sum(1 for r in rows if 'PROTECTED_CLASS_LANGUAGE' in r['finding'])\ndm=sum(1 for r in rows if 'DISCLAIMER_MISSING' in r['finding'])\nprint('csv recount: flagged',fl,'pn',pn,'pl',pl,'dm',dm)\nd=json.load(open('results.json'))\nprint('results.json:',d)\nassert d=={'section_count':30,'flagged_count':fl,'personal_narrative_count':pn,'protected_lang_count':pl,'disclaimer_missing_count':dm}, 'MISMATCH'\nprint('results.json matches CSV recount OK')\n\"" action.permission=* action.action=allow action.pattern=*
