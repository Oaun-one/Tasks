timestamp=2026-08-19T12:38:56.334Z level=INFO run=e7dfec69 message=evaluated permission=bash pattern="python3 - << 'PY'\nimport csv,json,collections\nrows=list(csv.DictReader(open(\"/app/fairhousing_audit.csv\")))\nprint(\"csv sections:\",len(rows),\"| header cols:\",list(rows[0].keys()))\nflag=sum(1 for r in rows if r[\"finding\"]!=\"none\")\npn=sum(1 for r in rows if \"PROHIBITED_PERSONAL_NARRATIVE\" in r[\"finding\"])\npcl=sum(1 for r in rows if \"PROTECTED_CLASS_LANGUAGE\" in r[\"finding\"])\ndm=sum(1 for r in rows if \"DISCLAIMER_MISSING\" in r[\"finding\"])\nres=json.load(open(\"/app/results.json\"))\nprint(\"csv-derived:\",{\"section_count\":len(rows),\"flagged_count\":flag,\"personal_narrative_count\":pn,\"protected_lang_count\":pcl,\"disclaimer_missing_count\":dm})\nprint(\"results.json:\",res)\nprint(\"match:\",res=={\"section_count\":len(rows),\"flagged_count\":flag,\"personal_narrative_count\":pn,\"protected_lang_count\":pcl,\"disclaimer_missing_count\":dm})\n# verify only the two allowed columns and allowed labels\nallowed={\"PROHIBITED_PERSONAL_NARRATIVE\",\"PROTECTED_CLASS_LANGUAGE\",\"DISCLAIMER_MISSING\",\"none\"}\nbad=[]\nfor r in rows:\n    if set(r.keys())!={\"section_id\",\"finding\"}: bad.append((r[\"section_id\"],\"cols\"))\n    for lab in r[\"finding\"].split(\"|\"):\n        if lab not in allowed: bad.append((r[\"section_id\"],lab))\nprint(\"bad rows/labels:\",bad)\nprint(\"none sections:\",[r[\"section_id\"] for r in rows if r[\"finding\"]==\"none\"])\nPY" action.permission=* action.action=allow action.pattern=*
