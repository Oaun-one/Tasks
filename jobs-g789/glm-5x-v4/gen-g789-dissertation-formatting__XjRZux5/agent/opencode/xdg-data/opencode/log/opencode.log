timestamp=2026-08-19T20:10:34.354Z level=INFO run=d1486552 message=evaluated permission=bash pattern="python3 -c \"\nimport csv, json\nrows=list(csv.DictReader(open('formatting_audit.csv')))\nparts=list(csv.DictReader(open('part_summary.csv')))\nr=json.load(open('results.json'))\ncodes=['MARGIN_NONCOMPLIANT','TYPE_AREA_INVALID','LEADING_NONCOMPLIANT','FONT_NONCOMPLIANT','HEADING_STYLE_INVALID','CAPTION_MISSING','NUMBERING_INVALID']\nkeymap={'MARGIN_NONCOMPLIANT':'margin_count','TYPE_AREA_INVALID':'type_area_count','LEADING_NONCOMPLIANT':'leading_count','FONT_NONCOMPLIANT':'font_count','HEADING_STYLE_INVALID':'heading_count','CAPTION_MISSING':'caption_missing_count','NUMBERING_INVALID':'numbering_count'}\nassert len(rows)==r['section_count']\nassert len(parts)==r['part_count']\nflagged=[x for x in rows if x['finding']!='none']\nclean=[x for x in rows if x['finding']=='none']\nassert len(flagged)==r['flagged_section_count']\nassert len(clean)==r['clean_section_count']\nft=0; cc={c:0 for c in codes}\nfor x in flagged:\n    for c in x['finding'].split('|'):\n        ft+=1; cc[c]+=1\nassert ft==r['finding_total']\nfor c in codes:\n    assert cc[c]==r[keymap[c]], (c,cc[c],r[keymap[c]])\nassert sum(int(p['section_count']) for p in parts)==r['section_count']\nassert sum(int(p['flagged_sections']) for p in parts)==r['flagged_section_count']\ninv=[p for p in parts if p['pagination']=='PAGINATION_INVALID']\nassert len(inv)==r['pagination_invalid_parts']\nassert sum(int(p['section_count']) for p in inv)==r['sections_in_invalid_parts']\n# flagged split by template\nfa=sum(1 for x in flagged if x['template_id']=='TPL-ARCHIVE')\nfr=sum(1 for x in flagged if x['template_id']=='TPL-READING')\nassert fa==r['flagged_archive_sections'], (fa,r['flagged_archive_sections'])\nassert fr==r['flagged_reading_sections'], (fr,r['flagged_reading_sections'])\n# every part_summary start_page parity matches pagination label\nfor p in parts:\n    sp=int(p['start_page'])\n    assert (sp%2==1)==(p['pagination']=='none'), p\nprint('All cross-checks passed.')\nprint('Invalid pagination parts:', [(p['part_id'],p['start_page']) for p in inv])\nprint('Totals: sections',r['section_count'],'flagged',r['flagged_section_count'],'findings',r['finding_total'],'shortfall',r['caption_shortfall_total'])\n\"" action.permission=* action.action=allow action.pattern=*
