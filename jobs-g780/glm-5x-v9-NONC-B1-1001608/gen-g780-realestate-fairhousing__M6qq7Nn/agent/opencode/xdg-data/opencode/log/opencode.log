timestamp=2026-08-19T13:46:59.615Z level=INFO run=701e4851 message=evaluated permission=bash pattern="python3 -c \"\nimport csv, json\nrows = list(csv.DictReader(open('fairhousing_audit.csv')))\nprint('columns:', list(rows[0].keys()))\nprint('row count:', len(rows))\nassert list(rows[0].keys()) == ['section_id','finding'], 'wrong columns'\nassert [r['section_id'] for r in rows] == [f'SEC-{i:02d}' for i in range(1,31)], 'not in inventory order / missing sections'\nvalid = {'none','PROHIBITED_PERSONAL_NARRATIVE','PROTECTED_CLASS_LANGUAGE','DISCLAIMER_MISSING'}\nfor r in rows:\n    parts = r['finding'].split('|')\n    assert all(p in valid for p in parts), r\n    # verify ordering rule\n    order = ['PROHIBITED_PERSONAL_NARRATIVE','PROTECTED_CLASS_LANGUAGE','DISCLAIMER_MISSING']\n    idx = [order.index(p) for p in parts]\n    assert idx == sorted(idx), ('order', r['section_id'], r['finding'])\n# verify exactly 2 columns (no extra)\nimport io\nraw = open('fairhousing_audit.csv').read()\nfor line in raw.strip().splitlines():\n    assert line.count(',') == 1, ('not exactly 2 cols', line)\nprint('CSV OK: 2 columns, 30 sections, valid labels, correct join order')\nprint('---JSON validation---')\nd = json.load(open('results.json'))\nprint(d)\nassert d == {'section_count':30,'flagged_count':22,'personal_narrative_count':7,'protected_lang_count':14,'disclaimer_missing_count':11}, 'json mismatch'\n# cross-check counts from CSV\nfc = sum(1 for r in rows if r['finding']!='none')\npn = sum(1 for r in rows if 'PROHIBITED_PERSONAL_NARRATIVE' in r['finding'])\npl = sum(1 for r in rows if 'PROTECTED_CLASS_LANGUAGE' in r['finding'])\ndm = sum(1 for r in rows if 'DISCLAIMER_MISSING' in r['finding'])\nprint('CSV-derived: section_count',len(rows),'flagged',fc,'pn',pn,'pl',pl,'dm',dm)\nassert (len(rows),fc,pn,pl,dm) == (30,22,7,14,11)\nprint('results.json matches CSV-derived counts: OK')\n\"" action.permission=* action.action=allow action.pattern=*
