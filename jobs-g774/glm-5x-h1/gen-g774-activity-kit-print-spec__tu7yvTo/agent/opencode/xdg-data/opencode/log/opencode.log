timestamp=2026-08-20T03:45:16.695Z level=INFO run=1f3a90fc message=evaluated permission=bash pattern="python3 - <<'EOF'\nimport csv, json, math, os\nIN=\"/app/input\"\nstock={}; sec={}\nfor r in csv.DictReader(open(IN+\"/stock_profiles.csv\")):\n    stock[r[\"stock_code\"]]={k:(int(v) if k in(\"min_dpi\",\"max_ink_pct\") else float(v)) for k,v in r.items() if k!=\"stock_name\"}\nfor r in csv.DictReader(open(IN+\"/kit_sections.csv\")):\n    sec[r[\"section_id\"]]=r\nrows=[]\nfor r in csv.DictReader(open(IN+\"/activity_kit_pages.csv\")):\n    rows.append(r)\nby={}\nfor r in rows:\n    if r[\"page_id\"] not in by or int(r[\"revision\"])>int(by[r[\"page_id\"]][\"revision\"]):\n        by[r[\"page_id\"]]=r\nsup=[r for r in rows if r is not by[r[\"page_id\"]]]\nbase={\"cover\":1,\"parent_guide\":2,\"map\":4,\"activity\":4,\"mission_cards\":6,\"bingo\":9,\"badge_certificate\":4}\nORDER=[\"DPI_TOO_LOW\",\"MARGIN_VIOLATION\",\"BLEED_SHORT\",\"INK_OVER\",\"ELEMENT_COUNT_SHORT\"]\nexp={}\nfor pid in sorted(by):\n    r=by[pid]; s=sec[r[\"section_id\"]]; st=stock[s[\"stock_code\"]]\n    eff=math.floor(int(r[\"artwork_dpi\"])*100//int(r[\"placement_scale_pct\"]))\n    emin=base[r[\"page_type\"]]\n    if s[\"binding\"]==\"saddle_stitch\" and r[\"page_type\"] in(\"mission_cards\",\"badge_certificate\"): emin+=2\n    fb=r[\"full_bleed_design\"].strip().lower()==\"true\"\n    c=[]\n    if eff<st[\"min_dpi\"]: c.append(\"DPI_TOO_LOW\")\n    if not fb and float(r[\"margin_in\"])<st[\"min_margin_in\"]: c.append(\"MARGIN_VIOLATION\")\n    if fb and float(r[\"bleed_in\"])<st[\"min_bleed_in\"]: c.append(\"BLEED_SHORT\")\n    if int(r[\"total_ink_pct\"])>st[\"max_ink_pct\"]: c.append(\"INK_OVER\")\n    if int(r[\"element_count\"])<emin: c.append(\"ELEMENT_COUNT_SHORT\")\n    exp[pid]=\"|\".join(x for x in ORDER if x in c) if c else \"none\"\n\n# validate CSV\ngot={}\nfor r in csv.DictReader(open(\"/app/activity_kit_audit.csv\")):\n    got[r[\"page_id\"]]=r[\"finding\"]\nassert set(got)==set(exp), (set(got)^set(exp))\nmismatch=[p for p in exp if exp[p]!=got[p]]\nassert not mismatch, mismatch\nprint(\"audit CSV: 30 rows match independent computation:\", len(got)==30 and not mismatch)\n\n# validate JSON keys + values\nj=json.load(open(\"/app/results.json\"))\nreq=[\"page_count\",\"superseded_count\",\"clean_count\",\"flagged_count\",\"finding_total\",\"dpi_low_count\",\"margin_count\",\"bleed_short_count\",\"ink_over_count\",\"element_short_count\",\"element_shortfall_total\"]\nassert set(j)==set(req), set(j)^set(req)\nft=sum(len(got[p].split(\"|\")) for p in got if got[p]!=\"none\")\nclean=sum(1 for p in got if got[p]==\"none\")\nsh=0\nfor pid in by:\n    r=by[pid]; s=sec[r[\"section_id\"]]; emin=base[r[\"page_type\"]]\n    if s[\"binding\"]==\"saddle_stitch\" and r[\"page_type\"] in(\"mission_cards\",\"badge_certificate\"): emin+=2\n    sh+=max(0,emin-int(r[\"element_count\"]))\ndef cc(code): return sum(1 for p in got if code in got[p].split(\"|\"))\ncheck={\"page_count\":len(by),\"superseded_count\":len(sup),\"clean_count\":clean,\"flagged_count\":len(by)-clean,\n       \"finding_total\":ft,\"dpi_low_count\":cc(\"DPI_TOO_LOW\"),\"margin_count\":cc(\"MARGIN_VIOLATION\"),\n       \"bleed_short_count\":cc(\"BLEED_SHORT\"),\"ink_over_count\":cc(\"INK_OVER\"),\n       \"element_short_count\":cc(\"ELEMENT_COUNT_SHORT\"),\"element_shortfall_total\":sh}\nassert j==check, (\"json mismatch\", j, check)\nprint(\"results.json keys + values match independent computation:\", j==check)\nprint(\"finding_total breakdown:\", ft, \"= dpi\",cc(\"DPI_TOO_LOW\"),\"margin\",cc(\"MARGIN_VIOLATION\"),\"bleed\",cc(\"BLEED_SHORT\"),\"ink\",cc(\"INK_OVER\"),\"elem\",cc(\"ELEMENT_COUNT_SHORT\"))\nprint(\"ALL DELIVERABLES CONSISTENT\")\nEOF" action.permission=* action.action=allow action.pattern=*
