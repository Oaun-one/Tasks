timestamp=2026-08-19T18:49:27.939Z level=INFO run=30ebe8f2 message=evaluated permission=bash pattern="python3 -c \"\nimport csv, json\nwith open('/app/formatting_audit.csv') as f:\n    rows = list(csv.reader(f))\nprint('header:', rows[0])\nprint('data rows:', len(rows)-1)\nassert rows[0]==['section_id','finding'], 'BAD HEADER'\nvalid={'none','MARGIN_NONCOMPLIANT','FONT_NONCOMPLIANT','SPACING_NONCOMPLIANT'}\norder=['MARGIN_NONCOMPLIANT','FONT_NONCOMPLIANT','SPACING_NONCOMPLIANT']\nsids=set()\nfor sid,find in rows[1:]:\n    sids.add(sid)\n    if find!='none':\n        parts=find.split('|')\n        assert parts==order[:len(parts)], f'BAD ORDER/SPACES: {sid} {find}'\n        assert all(p in valid for p in parts)\n    assert ' ' not in find\nprint('all findings well-formed; unique section_ids:', len(sids))\nwith open('/app/results.json') as f:\n    j=json.load(f)\nprint('json:', j)\nkeys=set(j)\nassert keys=={'section_count','flagged_count','margin_count','font_count','spacing_count'}, keys\nassert all(isinstance(v,int) for v in j.values())\n# cross-check counts\nfrom collections import Counter\nc=Counter()\nflag=0\nfor sid,find in rows[1:]:\n    if find!='none':\n        flag+=1\n        for p in find.split('|'): c[p]+=1\nassert j['section_count']==len(rows)-1==30\nassert j['flagged_count']==flag==18\nassert j['margin_count']==c['MARGIN_NONCOMPLIANT']==10\nassert j['font_count']==c['FONT_NONCOMPLIANT']==6\nassert j['spacing_count']==c['SPACING_NONCOMPLIANT']==5\nprint('ALL CHECKS PASS')\n\"" action.permission=* action.action=allow action.pattern=*
