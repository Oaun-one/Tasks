timestamp=2026-08-19T12:37:24.296Z level=INFO run=53d8c1d1 message=evaluated permission=bash pattern="python3 - << 'PY'\nimport csv,json\nwith open(\"fairhousing_audit.csv\") as f:\n    rows=list(csv.reader(f))\nassert rows[0]==[\"section_id\",\"finding\"], rows[0]\nbody=rows[1:]\nassert len(body)==30, len(body)\nassert [r[0] for r in body]==[f\"SEC-{i:02d}\" for i in range(1,31)]\norder=[\"PROHIBITED_PERSONAL_NARRATIVE\",\"PROTECTED_CLASS_LANGUAGE\",\"DISCLAIMER_MISSING\"]\nfor sid,finding in body:\n    assert len([sid])==1\n    if finding!=\"none\":\n        labs=finding.split(\"|\")\n        assert labs==sorted(lab for lab in labs if True) or True  # placeholder\n        # check ordering matches prescribed order\n        idxs=[order.index(l) for l in labs]\n        assert idxs==sorted(idxs), (sid,finding)\n        assert len(set(labs))==len(labs), (sid,finding)\nprint(\"CSV OK: 30 rows, header correct, inventory order, label order correct\")\nfmap={r[0]:r[1] for r in body}\nprint(\"flagged_count:\", sum(1 for v in fmap.values() if v!=\"none\"))\nprint(\"personal_narrative_count:\", sum(1 for v in fmap.values() if \"PROHIBITED_PERSONAL_NARRATIVE\" in v))\nprint(\"protected_lang_count:\", sum(1 for v in fmap.values() if \"PROTECTED_CLASS_LANGUAGE\" in v))\nprint(\"disclaimer_missing_count:\", sum(1 for v in fmap.values() if \"DISCLAIMER_MISSING\" in v))\nPY" action.permission=* action.action=allow action.pattern=*
