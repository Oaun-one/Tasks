timestamp=2026-08-19T20:16:05.792Z level=INFO run=49df4b65 message=evaluated permission=bash pattern="python3 -c \"\nimport csv\nrows=list(csv.DictReader(open('dissertation_section_log.csv')))\n# highest revision per section\nlatest={}\nfor r in rows:\n    s=r['section_id']\n    if s not in latest or int(r['revision'])>int(latest[s]['revision']): latest[s]=r\nA=list(latest.values())\nprint('audited:',len(A),'superseded:',len(rows)-len(A))\n\nparts={r['part_id']:r for r in csv.DictReader(open('part_plan.csv'))}\ntpls={r['template_id']:r for r in csv.DictReader(open('template_profiles.csv'))}\n\n# independent pagination\nbys=sorted(A,key=lambda r:int(r['sequence']))\ncum=0\nprint()\nprint('PAGINATION (independent):')\nfor pid in ['PART-00','PART-01','PART-02','PART-03','PART-04','PART-05','PART-06','PART-07']:\n    secs=[r for r in bys if r['part_id']==pid]\n    minseq=int(min(s['sequence'] for s in secs))\n    before=sum(int(s['page_extent']) for s in bys if int(s['sequence'])<minseq)\n    sp=1+before\n    print(f'  {pid}: start={sp} {\\\"PAGINATION_INVALID\\\" if sp%2==0 else \\\"none\\\"}')\n\n# type-area exception thresholds\nprint()\nprint('TYPE-AREA exception thresholds:')\nfor tid,t in tpls.items():\n    thr=round(29.7-3.0-float(t['min_outer_cm']),2)\n    print(f'  {tid}: 29.7-3.0-{t[\\\"min_outer_cm\\\"]}={thr}')\n\n# template-dependent band (24.2,24.7]\nprint()\nprint('Landscape annexes with widest in (24.2,24.7] (template-dependent):')\nfor r in bys:\n    if r['section_type']=='annex' and r['orientation']=='landscape' and r['widest_table_cm']:\n        w=float(r['widest_table_cm'])\n        if 24.2<w<=24.7+1e-9:\n            tid=parts[r['part_id']]['template_id']\n            thr=round(29.7-3.0-float(tpls[tid]['min_outer_cm']),2)\n            print(f'  {r[\\\"section_id\\\"]} {tid} widest={w} allowance={thr} released={w>thr+1e-9}')\n\n# leading conversions (mm)\nprint()\nprint('Leading (mm) conversions:')\nfor r in bys:\n    if r['leading_unit']=='mm':\n        c=round(float(r['leading_value'])/0.35,6)\n        print(f'  {r[\\\"section_id\\\"]}: {r[\\\"leading_value\\\"]}mm -> {c}pt (|{-18.0+c if False else abs(c-18.0):.2f} from 18.0)')\n\"" action.permission=* action.action=allow action.pattern=*
