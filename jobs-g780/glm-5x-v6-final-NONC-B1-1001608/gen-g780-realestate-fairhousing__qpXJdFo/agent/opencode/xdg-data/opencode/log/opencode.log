timestamp=2026-08-19T10:25:37.727Z level=INFO run=e3f8cd26 message=evaluated permission=bash pattern="python3 - <<'PY'\nimport csv, json\nrows = list(csv.reader(open('fairhousing_audit.csv')))\nassert rows[0] == ['section_id','finding'], rows[0]\ndata = rows[1:]\n# exactly 2 cols, no empty\nassert all(len(r)==2 and r[0] and r[1] for r in data)\n# 30 sections\nassert len(data)==30, len(data)\n# inventory order SEC-01..SEC-30\nassert [r[0] for r in data] == [f'SEC-{i:02d}' for i in range(1,31)]\n# labels valid + order rule\norder = {'PROHIBITED_PERSONAL_NARRATIVE':0,'PROTECTED_CLASS_LANGUAGE':1,'DISCLAIMER_MISSING':2}\nfor _,f in data:\n    if f=='none': continue\n    parts=f.split('|')\n    assert all(p in order for p in parts), f\n    assert parts==sorted(parts,key=lambda p:order[p]), f\"order: {f}\"\n# counts from CSV\nimport collections\nflagged = sum(1 for _,f in data if f!='none')\npn = sum(1 for _,f in data if 'PROHIBITED_PERSONAL_NARRATIVE' in f.split('|'))\npl = sum(1 for _,f in data if 'PROTECTED_CLASS_LANGUAGE' in f.split('|'))\ndm = sum(1 for _,f in data if 'DISCLAIMER_MISSING' in f.split('|'))\nderived = {'section_count':len(data),'flagged_count':flagged,'personal_narrative_count':pn,'protected_lang_count':pl,'disclaimer_missing_count':dm}\nrj = json.load(open('results.json'))\nprint('derived:',derived)\nprint('results.json:',rj)\nassert derived==rj, (derived,rj)\nprint('ALL CHECKS PASS')\nPY" action.permission=* action.action=allow action.pattern=*
