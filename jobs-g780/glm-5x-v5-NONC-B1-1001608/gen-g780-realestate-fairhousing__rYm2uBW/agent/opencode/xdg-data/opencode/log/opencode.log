timestamp=2026-08-19T09:59:50.960Z level=INFO run=fd0af30a message=evaluated permission=bash pattern="python3 -c \"\nimport csv\nrows=list(csv.DictReader(open('input/seller_book_sections.csv')))\n\nREQUIRED=['race','color','religion','sex','familial status','national origin',\n          'disability','sexual orientation','veteran status','marital status','source of income']\nRELIG=['church','churchgoing','parish','faith','congregation','worship']\nFAMIL=['family-oriented','young families','families','households','churchgoing']\nPN=['write us a letter','send a personal note','personal note about yourself',\n    'personal note about themselves','short personal note','covering letter introducing yourself',\n    'tell us about yourselves','would like to know who is buying','what brought you here',\n    'the one that moves us most']\n\ndef notice_of(body):\n    i=body.find('This brokerage complies')\n    return body[i:] if i>=0 else None\n\nresults={}\nfor r in rows:\n    sid,role,body=r['section_id'],r['role'],r['body']\n    bl=body.lower()\n    notice=notice_of(body)\n    own=bl if notice is None else body[:body.find('This brokerage complies')].lower()\n    compliant = bool(notice) and all(c in notice.lower() for c in REQUIRED)\n    pn = any(p in bl for p in PN)\n    own_proxy = any(p in own for p in set(RELIG+FAMIL))\n    if notice is None:\n        s2 = own_proxy\n    elif compliant:\n        s2 = own_proxy\n    else:\n        s2 = True\n    responsible = role in ('closing_page','agent_bio')\n    s4 = (responsible and not compliant)\n    labels=[]\n    if pn: labels.append('PROHIBITED_PERSONAL_NARRATIVE')\n    if s2: labels.append('PROTECTED_CLASS_LANGUAGE')\n    if s4: labels.append('DISCLAIMER_MISSING')\n    finding='|'.join(labels) if labels else 'none'\n    results[sid]=finding\n    nstat='compliant' if compliant else ('abridged' if notice else 'none')\n    print(f'{sid} {role:16} notice={nstat:10} pn={int(pn)} ownproxy={int(own_proxy)} => {finding}')\n\n# counts\nsc=len(rows)\nflagged=sum(1 for v in results.values() if v!='none')\npn_c=sum(1 for v in results.values() if 'PROHIBITED_PERSONAL_NARRATIVE' in v)\npl_c=sum(1 for v in results.values() if 'PROTECTED_CLASS_LANGUAGE' in v)\ndm_c=sum(1 for v in results.values() if 'DISCLAIMER_MISSING' in v)\nprint('---')\nprint('section_count',sc,'flagged_count',flagged,'pn',pn_c,'pl',pl_c,'dm',dm_c)\nprint('none count', sum(1 for v in results.values() if v=='none'))\n\"" action.permission=* action.action=allow action.pattern=*
