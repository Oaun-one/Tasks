    {
      "name": "audit_header_is_two_columns",
      "metadata": {
        "how_justification": "Opens formatting_audit.csv with csv.extract_text and applies regex_match.",
        "why_justification": "The prompt pins the audit to exactly the columns section_id,finding. This rejects an echo of the input log with a finding column appended."
      },
      "source": {
        "type": "file",
        "file": {
          "type": "csv",
          "command": "extract_text",
          "arguments": {
            "path": "formatting_audit.csv"
          }
        }
      },
      "assertion": {
        "type": "deterministic",
        "expected": "(?mi)\\A\\x22?section_id\\x22?\\s*,\\s*\\x22?finding\\x22?\\s*$",
        "deterministic": {
          "path": "$.text",
          "comparison": "regex_match"
        }
      }
    },
