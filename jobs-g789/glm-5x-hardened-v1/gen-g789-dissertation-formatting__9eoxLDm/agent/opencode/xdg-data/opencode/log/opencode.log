timestamp=2026-08-19T18:53:30.906Z level=INFO run=4aa0061f message=evaluated permission=bash pattern="cat << 'EOF' > /tmp/opencode/audit.py\nimport csv, json\n\nSUB_DATE = \"2026-03-09\"\n\n# ---- read log ----\nrows = []\nwith open(\"/app/input/dissertation_section_log.csv\") as f:\n    r = csv.DictReader(f)\n    for row in r:\n        rows.append(row)\n\nprint(\"total data rows:\", len(rows))\n\n# keep highest revision per section_id\nlatest = {}\nfor row in rows:\n    sid = row[\"section_id\"]\n    rev = int(row[\"revision\"])\n    if sid not in latest or rev > int(latest[sid][\"revision\"]):\n        latest[sid] = row\n\nset_aside = [r for r in rows if r not in latest.values()]\n# (above counts each superseded row; do it properly by id+rev)\n# recompute set-aside precisely:\naudit_rows = list(latest.values())\naudited_ids = {r[\"section_id\"] for r in audit_rows}\nset_aside_rows = [r for r in rows if (r[\"section_id\"], int(r[\"revision\"])) not in {(x[\"section_id\"], int(x[\"revision\"])) for x in audit_rows}]\n\nprint(\"audited sections:\", len(audit_rows))\nprint(\"set-aside rows:\", len(set_aside_rows))\nprint(\"set-aside ids:\", [(r[\"section_id\"], r[\"revision\"]) for r in set_aside_rows])\n\n# ---- thresholds (in-force amendments) ----\n# A-1 superseded by A-2; A-2 eff 2025-01-15 <= sub -> inner min 3.0\n# A-3 eff 2025-09-01 <= sub -> landscape annex exception narrowed\n# A-4 eff 2026-07-01 > sub -> NOT in force (body stays 1.5)\n# A-5 eff 2025-11-01 <= sub -> exact mode = 18.0 pt\nINNER_MIN = 3.0\nOTHER_MIN = 2.5\nFONT_SIZE_REQ = 12.0\nACCEPTED_FONTS = {\"Times New Roman\", \"TimesNewRomanPSMT\", \"Times New Roman PS MT Std\"}\nMULT_REQ = 1.5\nEXACT_REQ = 18.0\nLAND_W = 29.7\nPRINTABLE_LAND = LAND_W - INNER_MIN - OTHER_MIN  # 24.2\nOVERSIZE_GT = PRINTABLE_LAND  # table must be > this\n\n# ---- waivers ----\n# W-1 SEC-AN-01 Rule2 font-identifier only, expires 2026-12-31 -> in force\n# W-2 SEC-AN-03 Rule2 font-identifier only, expires 2026-01-31 -> EXPIRED (sub 2026-03-09 > 2026-01-31)\n# W-3 SEC-LOF Rule1 outer only, expires 2026-11-30 -> in force\nwaiver_font_id = {\"SEC-AN-01\"}     # W-1 in force clears font-identifier\nwaiver_outer = {\"SEC-LOF\"}         # W-3 in force clears outer margin\n\ndef audit(row):\n    findings = []\n    sid = row[\"section_id\"]\n    stype = row[\"section_type\"]\n    orient = row[\"orientation\"]\n    top = float(row[\"margin_top_cm\"]); bot = float(row[\"margin_bottom_cm\"])\n    inner = float(row[\"margin_inner_cm\"]); outer = float(row[\"margin_outer_cm\"])\n    font = row[\"font_name\"]; fsize = float(row[\"font_size_pt\"])\n    mode = row[\"spacing_mode\"]; sval = float(row[\"spacing_value\"])\n    wt = row[\"widest_table_cm\"]; wt = float(wt) if wt else None\n\n    # Rule 1 exception (A-3): annex + landscape + oversized table\n    exc = False\n    if stype == \"annex\" and orient == \"landscape\" and wt is not None and wt > OVERSIZE_GT:\n        exc = True\n\n    # Margin check\n    margin_breach = False\n    breaches = []\n    # inner is never relieved\n    if inner < INNER_MIN:\n        margin_breach = True; breaches.append((\"inner\", inner, INNER_MIN))\n    # top/bottom/outer relieved if exception applies\n    if not exc:\n        if top < OTHER_MIN: margin_breach = True; breaches.append((\"top\", top, OTHER_MIN))\n        if bot < OTHER_MIN: margin_breach = True; breaches.append((\"bottom\", bot, OTHER_MIN))\n        if outer < OTHER_MIN: margin_breach = True; breaches.append((\"outer\", outer, OTHER_MIN))\n    else:\n        # exception relieves top/bottom/outer; but if waiver W-3 outer for SEC-LOF (not annex anyway) N/A\n        pass\n    # W-3 clears outer margin finding for SEC-LOF (outer only)\n    if margin_breach and sid in waiver_outer:\n        # only clear outer breaches\n        breaches = [b for b in breaches if b[0] != \"outer\"]\n        margin_breach = len(breaches) > 0\n    if margin_breach:\n        findings.append(\"MARGIN_NONCOMPLIANT\")\n\n    # Rule 2 font\n    font_breach = False\n    font_id_bad = font not in ACCEPTED_FONTS\n    size_bad = fsize != FONT_SIZE_REQ\n    if font_id_bad and sid in waiver_font_id:\n        font_id_bad = False  # W-1 clears font-identifier only\n    # (W-2 expired -> not applied for SEC-AN-03)\n    if font_id_bad or size_bad:\n        font_breach = True\n    if font_breach:\n        findings.append(\"FONT_NONCOMPLIANT\")\n\n    # Rule 3 spacing\n    spacing_breach = False\n    if mode == \"multiple\":\n        if sval != MULT_REQ:\n            spacing_breach = True\n    elif mode == \"exact\":\n        if sval != EXACT_REQ:\n            spacing_breach = True\n    if spacing_breach:\n        findings.append(\"SPACING_NONCOMPLIANT\")\n\n    order = [\"MARGIN_NONCOMPLIANT\",\"FONT_NONCOMPLIANT\",\"SPACING_NONCOMPLIANT\"]\n    findings.sort(key=lambda x: order.index(x))\n    finding = \"|\".join(findings) if findings else \"none\"\n    return finding, exc, breaches, (font_id_bad, size_bad, font, fsize, mode, sval)\n\nresults = {}\ndetail = {}\nexc_applied = []\nfor row in audit_rows:\n    f, exc, mb, fb = audit(row)\n    results[row[\"section_id\"]] = f\n    detail[row[\"section_id\"]] = (f, exc, mb, fb)\n    if exc:\n        exc_applied.append((row[\"section_id\"], float(row[\"widest_table_cm\"])))\n\nprint(\"\\n--- AUDIT ---\")\nfor sid in sorted(results):\n    print(sid, \"->\", results[sid])\n\nprint(\"\\n--- exception applies to ---\")\nprint(exc_applied)\n\n# counts\nmargin_count = sum(1 for f in results.values() if \"MARGIN_NONCOMPLIANT\" in f.split(\"|\"))\nfont_count = sum(1 for f in results.values() if \"FONT_NONCOMPLIANT\" in f.split(\"|\"))\nspacing_count = sum(1 for f in results.values() if \"SPACING_NONCOMPLIANT\" in f.split(\"|\"))\nflagged_count = sum(1 for f in results.values() if f != \"none\")\nsection_count = len(results)\nprint(\"\\n--- counts ---\")\nprint(\"section_count\", section_count)\nprint(\"flagged_count\", flagged_count)\nprint(\"margin_count\", margin_count)\nprint(\"font_count\", font_count)\nprint(\"spacing_count\", spacing_count)\nprint(\"total findings\", margin_count+font_count+spacing_count)\n\nprint(\"\\n--- printable width threshold ---\")\nprint(\"PRINTABLE_LAND\", PRINTABLE_LAND, \"oversize if >\", OVERSIZE_GT)\n\n# save for later\nwith open(\"/tmp/opencode/results_computed.json\",\"w\") as fh:\n    json.dump(dict(section_count=section_count, flagged_count=flagged_count,\n                   margin_count=margin_count, font_count=font_count,\n                   spacing_count=spacing_count), fh, indent=2)\nwith open(\"/tmp/opencode/audit_computed.csv\",\"w\",newline=\"\") as fh:\n    w=csv.writer(fh)\n    w.writerow([\"section_id\",\"finding\"])\n    for sid in sorted(results):\n        w.writerow([sid, results[sid]])\nwith open(\"/tmp/opencode/detail.json\",\"w\") as fh:\n    json.dump(detail, fh, indent=2, default=str)\nEOF" action.permission=* action.action=allow action.pattern=*
