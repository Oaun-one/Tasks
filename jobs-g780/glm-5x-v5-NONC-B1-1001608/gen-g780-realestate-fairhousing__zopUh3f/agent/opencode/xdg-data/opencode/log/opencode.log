timestamp=2026-08-19T09:59:08.993Z level=INFO run=45aa995a message=evaluated permission=bash pattern="python3 - << 'EOF'\nimport csv, json, os\n\ncsv_path = \"/app/fairhousing_audit.csv\"\njson_path = \"/app/results.json\"\n\n# Parse CSV\nwith open(csv_path) as f:\n    rows = list(csv.DictReader(f))\n\nprint(\"CSV rows:\", len(rows))\nprint(\"Columns:\", list(rows[0].keys()))\norder = [r[\"section_id\"] for r in rows]\nprint(\"Inventory order sequential:\", order == [f\"SEC-{i:02d}\" for i in range(1, 31)])\n\n# Recompute counts (count sections, not labels)\nlabels = [\"PROHIBITED_PERSONAL_NARRATIVE\", \"PROTECTED_CLASS_LANGUAGE\", \"DISCLAIMER_MISSING\"]\npc = sum(1 for r in rows if r[\"finding\"] != \"none\")\npn = sum(1 for r in rows if \"PROHIBITED_PERSONAL_NARRATIVE\" in r[\"finding\"].split(\"|\"))\npl = sum(1 for r in rows if \"PROTECTED_CLASS_LANGUAGE\" in r[\"finding\"].split(\"|\"))\ndm = sum(1 for r in rows if \"DISCLAIMER_MISSING\" in r[\"finding\"].split(\"|\"))\n\n# Check label ordering in any multi-finding row matches the required order\nbad_order = []\nfor r in rows:\n    if r[\"finding\"] != \"none\":\n        parts = r[\"finding\"].split(\"|\")\n        expected = [l for l in labels if l in parts]\n        if parts != expected:\n            bad_order.append((r[\"section_id\"], r[\"finding\"]))\nprint(\"Rows with wrong label order:\", bad_order)\n\nrecomputed = {\n    \"section_count\": len(rows),\n    \"flagged_count\": pc,\n    \"personal_narrative_count\": pn,\n    \"protected_lang_count\": pl,\n    \"disclaimer_missing_count\": dm,\n}\nprint(\"Recomputed:\", recomputed)\n\nwith open(json_path) as f:\n    on_disk = json.load(f)\nprint(\"On disk:  \", on_disk)\nprint(\"MATCH:\", recomputed == on_disk)\n\n# sanity: every finding value is valid\nvalid = {\"none\"} | set(labels)\ninvalid = [r for r in rows if r[\"finding\"] not in valid and not all(p in labels for p in r[\"finding\"].split(\"|\"))]\nprint(\"Invalid finding values:\", invalid)\nEOF" action.permission=* action.action=allow action.pattern=*
