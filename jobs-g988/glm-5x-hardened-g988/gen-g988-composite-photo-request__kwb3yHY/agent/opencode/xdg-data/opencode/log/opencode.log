timestamp=2026-08-20T02:43:55.204Z level=INFO run=a3b12e3a message=evaluated permission=bash pattern="cat > /tmp/opencode/audit.py << 'PYEOF'\nimport csv, json\nfrom datetime import date\n\nAUDIT_DATE = date(2026, 3, 31)\n\ndef load_csv(path):\n    with open(path, newline='') as f:\n        return list(csv.DictReader(f))\n\naccounts = {a['account_id']: a for a in load_csv('/app/input/client_accounts.csv')}\nlicences = {l['license_id']: l for l in load_csv('/app/input/licensed_property_register.csv')}\nrequests = load_csv('/app/input/composite_request_log.csv')\n\ndef parse_date(s):\n    y, m, d = s.split('-')\n    return date(int(y), int(m), int(d))\n\ndef lic_covers(req, lic_id, use_type):\n    \"\"\"§2: does licence cover the request for the given use_type?\"\"\"\n    if lic_id == 'none' or lic_id == '':\n        return False\n    lic = licences.get(lic_id)\n    if lic is None:\n        return False\n    # (1) id appears in register -> yes (we got it)\n    # (2) license_type matches use\n    if lic['license_type'] != use_type:\n        return False\n    # (3) covers_distribution lists intended_distribution or is 'all'\n    dists = lic['covers_distribution'].split(';')\n    dists = [d.strip() for d in dists]\n    if dists == ['all']:\n        pass\n    elif req['intended_distribution'] not in dists:\n        return False\n    # (4) valid_until on or after audit date\n    if parse_date(lic['valid_until']) < AUDIT_DATE:\n        return False\n    return True\n\ndef account_clears(acc, distribution):\n    \"\"\"§6: account clears the channel\"\"\"\n    if acc['agreement_status'] != 'active':\n        return False\n    covers = [c.strip() for c in acc['master_agreement_covers'].split(';')]\n    return distribution in covers\n\nFINDING_ORDER = [\n    'UNLICENSED_CHARACTER_USE',\n    'THIRD_PARTY_BACKGROUND_UNLICENSED',\n    'MISSING_MINOR_CONSENT',\n    'COMMERCIAL_DISTRIBUTION_FLAG',\n    'ALTERATION_DISCLOSURE_MISSING',\n]\n\naudit = {}  # request_id -> list of findings\nrecords = {}  # request_id -> dict of deciding records per finding\n\nfor req in requests:\n    rid = req['request_id']\n    findings = []\n    rec = {}\n\n    # §3 Licensed-character use\n    if req['character_property'] != 'none':\n        cleared_by_lic = lic_covers(req, req['character_license_id'], 'character')\n        personal = req['intended_distribution'] == 'personal_only'\n        if not (cleared_by_lic or personal):\n            findings.append('UNLICENSED_CHARACTER_USE')\n            if req['character_license_id'] in ('none',''):\n                rec['UNLICENSED_CHARACTER_USE'] = 'no licence on request'\n            else:\n                lic = licences.get(req['character_license_id'])\n                if lic is None:\n                    rec['UNLICENSED_CHARACTER_USE'] = f\"{req['character_license_id']} not in register\"\n                else:\n                    # why doesn't it cover?\n                    reasons=[]\n                    if lic['license_type']!='character':\n                        reasons.append(f\"{req['character_license_id']} license_type={lic['license_type']}\")\n                    dists=[d.strip() for d in lic['covers_distribution'].split(';')]\n                    if dists!=['all'] and req['intended_distribution'] not in dists:\n                        reasons.append(f\"{req['character_license_id']} covers {lic['covers_distribution']} not {req['intended_distribution']}\")\n                    if parse_date(lic['valid_until']) < AUDIT_DATE:\n                        reasons.append(f\"{req['character_license_id']} valid_until {lic['valid_until']} (before audit date)\")\n                    rec['UNLICENSED_CHARACTER_USE'] = '; '.join(reasons) if reasons else req['character_license_id']\n\n    # §4 Third-party backgrounds\n    bs = req['background_source']\n    if bs == 'customer_original':\n        pass\n    elif bs == 'third_party_unlicensed':\n        findings.append('THIRD_PARTY_BACKGROUND_UNLICENSED')\n        rec['THIRD_PARTY_BACKGROUND_UNLICENSED'] = 'background_source=third_party_unlicensed (own record)'\n    elif bs == 'third_party_licensed':\n        if not lic_covers(req, req['background_license_id'], 'background'):\n            findings.append('THIRD_PARTY_BACKGROUND_UNLICENSED')\n            if req['background_license_id'] in ('none',''):\n                rec['THIRD_PARTY_BACKGROUND_UNLICENSED'] = 'no background licence on request'\n            else:\n                lic = licences.get(req['background_license_id'])\n                if lic is None:\n                    rec['THIRD_PARTY_BACKGROUND_UNLICENSED'] = f\"{req['background_license_id']} not in register\"\n                else:\n                    reasons=[]\n                    if lic['license_type']!='background':\n                        reasons.append(f\"{req['background_license_id']} license_type={lic['license_type']}\")\n                    dists=[d.strip() for d in lic['covers_distribution'].split(';')]\n                    if dists!=['all'] and req['intended_distribution'] not in dists:\n                        reasons.append(f\"{req['background_license_id']} covers {lic['covers_distribution']} not {req['intended_distribution']}\")\n                    if parse_date(lic['valid_until']) < AUDIT_DATE:\n                        reasons.append(f\"{req['background_license_id']} valid_until {lic['valid_until']} (before audit date)\")\n                    rec['THIRD_PARTY_BACKGROUND_UNLICENSED'] = '; '.join(reasons) if reasons else req['background_license_id']\n\n    # §5 Minor consent\n    if req['subject_is_minor'] == 'True':\n        ct = req['minor_consent_type']\n        reasons=[]\n        if ct == 'none':\n            reasons.append('consent type none (not present)')\n        else:\n            if parse_date(req['minor_consent_valid_until']) < AUDIT_DATE:\n                reasons.append(f\"consent valid_until {req['minor_consent_valid_until']} (before audit date)\")\n            dist = req['intended_distribution']\n            if ct == 'basic' and dist not in ('personal_only','client_internal'):\n                reasons.append(f\"basic consent does not cover {dist}\")\n        if reasons:\n            findings.append('MISSING_MINOR_CONSENT')\n            rec['MISSING_MINOR_CONSENT'] = '; '.join(reasons)\n\n    # §6 Commercial distribution routing\n    dist = req['intended_distribution']\n    if dist in ('social_public','print_for_sale'):\n        acc = accounts[req['account_id']]\n        if not account_clears(acc, dist):\n            findings.append('COMMERCIAL_DISTRIBUTION_FLAG')\n            if acc['agreement_status'] != 'active':\n                rec['COMMERCIAL_DISTRIBUTION_FLAG'] = f\"account {req['account_id']} agreement {acc['agreement_status']} (lapsed covers nothing)\"\n            else:\n                covers=[c.strip() for c in acc['master_agreement_covers'].split(';')]\n                rec['COMMERCIAL_DISTRIBUTION_FLAG'] = f\"account {req['account_id']} active but covers {acc['master_agreement_covers']} (not {dist})\"\n\n    # §7 Alteration disclosure\n    if req['alteration_level']=='substantive' and dist in ('social_public','print_for_sale'):\n        if req['alteration_disclosure_on_file'] != 'True':\n            findings.append('ALTERATION_DISCLOSURE_MISSING')\n            rec['ALTERATION_DISCLOSURE_MISSING'] = 'substantive + public/paid, disclosure not on file'\n\n    # order findings per FINDING_ORDER\n    ordered = [f for f in FINDING_ORDER if f in findings]\n    audit[rid] = ordered\n    records[rid] = rec\n\n# Print per-request\nprint(\"=== PER REQUEST ===\")\nfor req in requests:\n    rid=req['request_id']\n    fs = audit[rid]\n    s = '|'.join(fs) if fs else 'none'\n    print(f\"{rid} ({req['account_id']}, {req['intended_distribution']}, char={req['character_property']}, bgsrc={req['background_source']}): {s}\")\n    for f in fs:\n        print(f\"    {f}: {records[rid][f]}\")\n\n# Account summary\nprint(\"\\n=== ACCOUNT SUMMARY ===\")\nacc_summary={}\nfor acc_id, acc in accounts.items():\n    reqs = [r for r in requests if r['account_id']==acc_id]\n    flagged = [r for r in reqs if audit[r['request_id']]]\n    escalate = 'none'\n    if len(flagged) >= 2:\n        escalate = 'ESCALATION_REQUIRED'\n    elif any(len(audit[r['request_id']])>=3 for r in reqs):\n        escalate = 'ESCALATION_REQUIRED'\n    acc_summary[acc_id]=(acc['account_type'], len(reqs), len(flagged), escalate)\n    print(f\"{acc_id} {acc['account_type']} count={len(reqs)} flagged={len(flagged)} esc={escalate}\")\n\n# Stats\nflagged_count = sum(1 for r in requests if audit[r['request_id']])\ncompliant_count = len(requests)-flagged_count\nfinding_total = sum(len(audit[r['request_id']]) for r in requests)\ndef count_finding(f):\n    return sum(1 for r in requests if f in audit[r['request_id']])\nchar_count=count_finding('UNLICENSED_CHARACTER_USE')\nbg_count=count_finding('THIRD_PARTY_BACKGROUND_UNLICENSED')\nconsent_count=count_finding('MISSING_MINOR_CONSENT')\ncomm_count=count_finding('COMMERCIAL_DISTRIBUTION_FLAG')\ndisc_count=count_finding('ALTERATION_DISCLOSURE_MISSING')\nescalated=sum(1 for a in acc_summary if acc_summary[a][3]=='ESCALATION_REQUIRED')\n\nprint(\"\\n=== STATS ===\")\nprint(f\"request_count={len(requests)}\")\nprint(f\"account_count={len(accounts)}\")\nprint(f\"flagged_count={flagged_count}\")\nprint(f\"compliant_count={compliant_count}\")\nprint(f\"finding_total={finding_total}\")\nprint(f\"character_count={char_count}\")\nprint(f\"background_count={bg_count}\")\nprint(f\"consent_count={consent_count}\")\nprint(f\"commercial_count={comm_count}\")\nprint(f\"disclosure_count={disc_count}\")\nprint(f\"escalated_accounts={escalated}\")\n\n# Personal-use allowance clears (§3)\nprint(\"\\n=== PERSONAL-USE ALLOWANCE CLEARS (character, personal_only) ===\")\nfor req in requests:\n    if req['character_property']!='none' and req['intended_distribution']=='personal_only':\n        print(f\"{req['request_id']}: {req['character_property']} ({req['character_license_id']})\")\n\n# Cleared by licence for §3\nprint(\"\\n=== §3 CLEARED BY LICENCE ===\")\nfor req in requests:\n    if req['character_property']!='none':\n        if lic_covers(req, req['character_license_id'], 'character'):\n            print(f\"{req['request_id']}: {req['character_property']} cleared by {req['character_license_id']}\")\n\n# Cleared by licence for §4\nprint(\"\\n=== §4 CLEARED BY LICENCE ===\")\nfor req in requests:\n    if req['background_source']=='third_party_licensed':\n        if lic_covers(req, req['background_license_id'], 'background'):\n            print(f\"{req['request_id']}: bg {req['background_license_id']} covers\")\n\n# Lapsed accounts\nprint(\"\\n=== LAPSED AGREEMENTS ===\")\nfor acc_id, acc in accounts.items():\n    if acc['agreement_status']=='lapsed':\n        print(f\"{acc_id} {acc['account_name']} covers={acc['master_agreement_covers']} (lapsed)\")\nPYEOF" action.permission=* action.action=allow action.pattern=*
