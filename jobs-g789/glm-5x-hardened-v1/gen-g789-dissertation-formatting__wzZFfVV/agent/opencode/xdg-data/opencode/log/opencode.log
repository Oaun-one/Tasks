timestamp=2026-08-19T18:48:39.740Z level=INFO run=30ebe8f2 message=evaluated permission=bash pattern="cat > /tmp/opencode/audit.py << 'PYEOF'\nimport csv, json\n\nLOG = \"/app/input/dissertation_section_log.csv\"\nSUB_DATE = \"2026-03-09\"\n\n# Accepted Times New Roman identifiers (Appendix F)\nACCEPTED_FONTS = {\"Times New Roman\", \"TimesNewRomanPSMT\", \"Times New Roman PS MT Std\"}\n\n# Thresholds (in force for this submission: A-2, A-3, A-5 applied; A-1 superseded; A-4 NOT in force)\nINNER_MIN = 3.0          # A-2\nOTHER_MIN = 2.5          # Rule 1 base (top/bottom/outer), unchanged\nFONT_SIZE_REQ = 12.0     # Rule 2\nMULT_REQ = 1.5           # Rule 3 (A-4 not in force -> body stays 1.5)\nEXACT_REQ = 18.0         # A-5\nLAND_W = 29.7            # A4 landscape physical width\nPRINTABLE_W = LAND_W - INNER_MIN - OUTER := LAND_W - 3.0 - 2.5  # 24.2\n\nPRINTABLE_W = round(LAND_W - 3.0 - 2.5, 2)  # 24.2\n\nrows = []\nwith open(LOG) as f:\n    r = csv.DictReader(f)\n    for row in r:\n        rows.append(row)\n\ntotal_rows = len(rows)\n\n# Keep highest revision per section_id\nlatest = {}\nfor row in rows:\n    sid = row[\"section_id\"]\n    rev = int(row[\"revision\"])\n    if sid not in latest or rev > int(latest[sid][\"revision\"]):\n        latest[sid] = row\n\naudited = list(latest.values())\nset_aside = [row for row in rows if row not in {id(r) for r in audited}]\n# the above set membership by id is fine because audited rows are the same dict objects from rows\n\ndef num(x):\n    return float(x) if x not in (None, \"\") else None\n\ndef exception_applies(row):\n    # A-3: section_type=annex, orientation=landscape, widest_table_cm > printable width (24.2)\n    if row[\"section_type\"] != \"annex\":\n        return False\n    if row[\"orientation\"] != \"landscape\":\n        return False\n    wt = num(row[\"widest_table_cm\"])\n    if wt is None:\n        return False\n    return wt > PRINTABLE_W\n\ndef margin_finding(row, waived_outer=False):\n    # returns True if MARGIN_NONCOMPLIANT (after exception + waiver)\n    top = num(row[\"margin_top_cm\"]); bot = num(row[\"margin_bottom_cm\"])\n    inner = num(row[\"margin_inner_cm\"]); outer = num(row[\"margin_outer_cm\"])\n    exc = exception_applies(row)\n    breaches = []\n    # inner never excepted\n    if inner is None or inner < INNER_MIN:\n        breaches.append(\"inner\")\n    # top/bot/outer excepted when exc applies\n    if not exc:\n        if top is None or top < OTHER_MIN:\n            breaches.append(\"top\")\n        if bot is None or bot < OTHER_MIN:\n            breaches.append(\"bottom\")\n        # outer may be waived\n        if not waived_outer:\n            if outer is None or outer < OTHER_MIN:\n                breaches.append(\"outer\")\n    return bool(breaches), breaches\n\ndef font_finding(row, waived_identifier=False):\n    fn = row[\"font_name\"]\n    fs = num(row[\"font_size_pt\"])\n    ident_ok = fn in ACCEPTED_FONTS\n    size_ok = (fs is not None and fs == FONT_SIZE_REQ)\n    breach = False\n    reasons = []\n    if not ident_ok and not waived_identifier:\n        breach = True; reasons.append(\"identifier\")\n    if not size_ok:\n        breach = True; reasons.append(\"size\")\n    return breach, reasons\n\ndef spacing_finding(row):\n    mode = row[\"spacing_mode\"]\n    val = num(row[\"spacing_value\"])\n    if mode == \"multiple\":\n        ok = (val is not None and val == MULT_REQ)\n    elif mode == \"exact\":\n        ok = (val is not None and val == EXACT_REQ)\n    else:\n        ok = False\n    return (not ok), [f\"{mode}={val} (req {'1.5' if mode=='multiple' else '18.0'})\"]\n\n# Waivers (in force only if submission date <= expiry)\nwaivers = {\n    \"SEC-AN-01\": {\"rule\":\"font_identifier\", \"expires\":\"2026-12-31\"},\n    \"SEC-AN-03\": {\"rule\":\"font_identifier\", \"expires\":\"2026-01-31\"},\n    \"SEC-LOF\":   {\"rule\":\"outer_margin\",    \"expires\":\"2026-11-30\"},\n}\n\ndef waiver_in_force(sid, key):\n    w = waivers.get(sid)\n    if not w: return False\n    return w[\"rule\"]==key and SUB_DATE <= w[\"expires\"]\n\nresults = []\nfor row in sorted(audited, key=lambda r: r[\"section_id\"]):\n    sid = row[\"section_id\"]\n    m, mb = margin_finding(row, waived_outer=waiver_in_force(sid,\"outer_margin\"))\n    f, fb = font_finding(row, waived_identifier=waiver_in_force(sid,\"font_identifier\"))\n    s, sb = spacing_finding(row)\n    findings = []\n    if m: findings.append(\"MARGIN_NONCOMPLIANT\")\n    if f: findings.append(\"FONT_NONCOMPLIANT\")\n    if s: findings.append(\"SPACING_NONCOMPLIANT\")\n    finding = \"|\".join(findings) if findings else \"none\"\n    results.append((sid, finding, m, f, s, mb, fb, sb, row))\n\nprint(\"TOTAL ROWS:\", total_rows)\nprint(\"AUDITED:\", len(audited))\nprint(\"SET ASIDE:\", len(set_aside))\nprint(\"SET-ASIDE ROWS:\", [ (r[\"section_id\"], r[\"revision\"]) for r in set_aside ])\nprint()\nprint(\"PRINTABLE_W:\", PRINTABLE_W)\nprint()\nflagged = margin = font = spacing = 0\nfor sid, finding, m, f, s, mb, fb, sb, row in results:\n    if m: margin += 1\n    if f: font += 1\n    if s: spacing += 1\n    if finding != \"none\": flagged += 1\n    print(f\"{sid:12s} type={row['section_type']:11s} orient={row['orientation']:8s} \"\n          f\"inner={row['margin_inner_cm']:>4} outer={row['margin_outer_cm']:>4} \"\n          f\"top={row['margin_top_cm']:>4} bot={row['margin_bottom_cm']:>4} \"\n          f\"font={row['font_name']:22s} sz={row['font_size_pt']:>4} \"\n          f\"sp={row['spacing_mode']:>8}={row['spacing_value']:>4} wt={row['widest_table_cm']:>4} \"\n          f\"exc={exception_applies(row)} -> {finding}  [M:{mb} F:{fb} S:{sb}]\")\nprint()\nprint(\"flagged:\", flagged, \"margin:\", margin, \"font:\", font, \"spacing:\", spacing)\n\n# Write CSV\nwith open(\"/app/formatting_audit.csv\",\"w\",newline=\"\") as cf:\n    w = csv.writer(cf)\n    w.writerow([\"section_id\",\"finding\"])\n    for sid, finding, *_ in results:\n        w.writerow([sid, finding])\n\n# Write results.json\nwith open(\"/app/results.json\",\"w\") as jf:\n    json.dump({\n        \"section_count\": len(audited),\n        \"flagged_count\": flagged,\n        \"margin_count\": margin,\n        \"font_count\": font,\n        \"spacing_count\": spacing,\n    }, jf, indent=2)\n\nprint(\"\\nFiles written.\")\nPYEOF" action.permission=* action.action=allow action.pattern=*
