timestamp=2026-08-20T04:03:58.703Z level=INFO run=fe2aaff0 message=evaluated permission=bash pattern="python3 -c \"\nimport math\n# Spot-check tricky effective_dpi floors and inclusive limits\nprint('PG-04 rev2 eff:', math.floor(220*100/80), 'vs 260 ->', 'CLEAR' if math.floor(220*100/80)>=260 else 'BREACH')\nprint('PG-06 eff:', math.floor(450*100/150), 'vs 300')\nprint('PG-07 eff:', math.floor(600*100/200), 'vs 300')\nprint('PG-27 rev2 eff:', math.floor(480*100/200), 'vs 240')\nprint('PG-33 rev2 eff:', math.floor(600*100/200), 'vs 300')\nprint('PG-14 eff:', math.floor(520*100/200), 'vs 260')\nprint('PG-13 eff:', math.floor(260*100/100), 'vs 260 (inclusive)')\nprint('PG-22 eff:', math.floor(240*100/100), 'vs 240 (inclusive)')\n# amendment-created element breaches\nfor pid, count, base, sec in [('PG-12',7,6,'saddle'),('PG-13',6,6,'saddle'),('PG-15',5,6,'saddle'),('PG-33',7,6,'saddle'),('PG-25',5,4,'saddle'),('PG-24',6,4,'saddle'),('PG-11',8,6,'saddle')]:\n    amended = base+2\n    print(pid,'count',count,'base',base,'->',('CLEAR' if count>=base else f'SHORT{base-count}'),'| amended',amended,'->',('CLEAR' if count>=amended else f'SHORT{amended-count}'))\n\"" action.permission=* action.action=allow action.pattern=*
