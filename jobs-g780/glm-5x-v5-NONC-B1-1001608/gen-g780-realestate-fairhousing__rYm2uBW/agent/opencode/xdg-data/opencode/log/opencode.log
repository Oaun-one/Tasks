timestamp=2026-08-19T09:58:57.916Z level=INFO run=fd0af30a message=evaluated permission=bash pattern="python3 -c \"\nimport csv\nrows=list(csv.DictReader(open('input/seller_book_sections.csv')))\nfor r in rows:\n    if r['section_id'] in ('SEC-04','SEC-08','SEC-10','SEC-11','SEC-13','SEC-14','SEC-15','SEC-19','SEC-22','SEC-24','SEC-26','SEC-29'):\n        import re\n        m=re.search(r'on the basis of (.+)', r['body'])\n        print(r['section_id'], r['role'])\n        print('   ->', m.group(1) if m else 'NO NOTICE')\n\"" action.permission=* action.action=allow action.pattern=*
