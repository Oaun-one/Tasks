timestamp=2026-08-19T13:05:39.887Z level=INFO run=da1a75f8 message=evaluated permission=bash pattern="cat > /tmp/opencode/audit.py << 'PYEOF'\nimport csv, re, json\n\nREQUIRED = [\"race\",\"colour\",\"religion\",\"sex\",\"familial status\",\"national origin\",\n            \"disability\",\"sexual orientation\",\"veteran status\",\"marital status\",\"source of income\"]\nPCLASSES = [\"race\",\"colour\",\"religion\",\"sex\",\"familial status\",\"national origin\",\n            \"disability\",\"sexual orientation\",\"veteran status\"]\nRESP_ROLES = {\"closing_page\",\"agent_bio\"}\nMARKER = \"this brokerage complies with the federal fair housing act\"\n\nrows = list(csv.DictReader(open(\"/app/input/seller_book_sections.csv\")))\n\ndef find_notice(text):\n    low = text.lower()\n    i = low.find(MARKER)\n    if i == -1:\n        return None, text\n    notice = text[i:]            # notice runs to end of body (always the last sentence here)\n    prose = text[:i]\n    return notice, prose\n\ndef classes_named(notice):\n    if not notice: return set()\n    low = notice.lower()\n    named = set()\n    for c in REQUIRED:\n        variants = [c] if c != \"colour\" else [\"colour\",\"color\"]\n        for v in variants:\n            if re.search(r\"\\b\"+re.escape(v)+r\"\\b\", low):\n                named.add(c); break\n    return named\n\ndef has_pclass(text):\n    low = text.lower()\n    direct = [\"race\",\"colour\",\"color\",\"religion\",\"sex\",\"familial status\",\"national origin\",\n              \"disability\",\"sexual orientation\",\"veteran status\"]\n    for t in direct:\n        if re.search(r\"\\b\"+re.escape(t)+r\"\\b\", low):\n            return True\n    proxy = [\"church\",\"churches\",\"churchgoing\",\"parish\",\"faith\",\"worship\",\"congregation\"]\n    for t in proxy:\n        if re.search(r\"\\b\"+re.escape(t)+r\"\\b\", low):\n            return True\n    if re.search(r\"\\b(family-oriented|young families|churchgoing households|long-established families|congregation-centred)\\b\", low):\n        return True\n    # street/block/neighbourhood described by a household type -> familial status\n    if re.search(r\"\\b(street|block|neighbourhood|neighborhood)\\b\", low) and re.search(r\"\\b(households|families|family-oriented)\\b\", low):\n        return True\n    return False\n\ndef has_pn(text):\n    low = text.lower()\n    pats = [r\"write us a letter\", r\"personal note about yourself\", r\"personal note about themselves\",\n            r\"covering letter introducing yourself\", r\"introduce a short personal note\",\n            r\"letter about what brought you here\", r\"tell us about yourselves\",\n            r\"why this home suits them\", r\"like to know who is buying\",\n            r\"write us a letter about what brought you here\"]\n    return any(re.search(p, low) for p in pats)\n\nout = []\nfor r in rows:\n    sid=r[\"section_id\"]; role=r[\"role\"]; body=r[\"body\"]; title=r[\"title\"]\n    full = title+\" \"+body\n    notice, prose = find_notice(body)\n    named = classes_named(notice)\n    complete = notice is not None and named == set(REQUIRED)\n    abridged = notice is not None and not complete\n    f = []\n    if has_pn(full): f.append(\"PROHIBITED_PERSONAL_NARRATIVE\")\n    pcl = has_pclass(prose+\" \"+title)\n    if abridged and has_pclass(notice): pcl = True\n    if pcl: f.append(\"PROTECTED_CLASS_LANGUAGE\")\n    if role in RESP_ROLES and not complete: f.append(\"DISCLAIMER_MISSING\")\n    finding = \"|\".join(f) if f else \"none\"\n    out.append((sid, role, finding, \"complete\" if complete else (\"abridged\" if abridged else \"no-notice\"),\n               sorted(named)))\n\nHAND = {\n\"SEC-01\":\"none\",\"SEC-02\":\"PROHIBITED_PERSONAL_NARRATIVE\",\"SEC-03\":\"PROTECTED_CLASS_LANGUAGE\",\n\"SEC-04\":\"PROTECTED_CLASS_LANGUAGE\",\"SEC-05\":\"DISCLAIMER_MISSING\",\"SEC-06\":\"none\",\n\"SEC-07\":\"PROHIBITED_PERSONAL_NARRATIVE|PROTECTED_CLASS_LANGUAGE|DISCLAIMER_MISSING\",\n\"SEC-08\":\"PROHIBITED_PERSONAL_NARRATIVE\",\"SEC-09\":\"PROTECTED_CLASS_LANGUAGE|DISCLAIMER_MISSING\",\n\"SEC-10\":\"none\",\"SEC-11\":\"PROTECTED_CLASS_LANGUAGE|DISCLAIMER_MISSING\",\n\"SEC-12\":\"PROTECTED_CLASS_LANGUAGE|DISCLAIMER_MISSING\",\"SEC-13\":\"none\",\n\"SEC-14\":\"PROTECTED_CLASS_LANGUAGE|DISCLAIMER_MISSING\",\"SEC-15\":\"PROTECTED_CLASS_LANGUAGE|DISCLAIMER_MISSING\",\n\"SEC-16\":\"PROTECTED_CLASS_LANGUAGE|DISCLAIMER_MISSING\",\"SEC-17\":\"PROHIBITED_PERSONAL_NARRATIVE|PROTECTED_CLASS_LANGUAGE\",\n\"SEC-18\":\"none\",\"SEC-19\":\"PROTECTED_CLASS_LANGUAGE\",\"SEC-20\":\"none\",\"SEC-21\":\"DISCLAIMER_MISSING\",\n\"SEC-22\":\"PROTECTED_CLASS_LANGUAGE\",\"SEC-23\":\"none\",\"SEC-24\":\"PROHIBITED_PERSONAL_NARRATIVE\",\n\"SEC-25\":\"PROTECTED_CLASS_LANGUAGE\",\"SEC-26\":\"none\",\"SEC-27\":\"PROHIBITED_PERSONAL_NARRATIVE\",\n\"SEC-28\":\"none\",\"SEC-29\":\"PROHIBITED_PERSONAL_NARRATIVE\",\"SEC-30\":\"DISCLAIMER_MISSING\",\n}\nok = True\nfor sid, role, finding, status, named in out:\n    match = \"OK\" if finding == HAND[sid] else \"MISMATCH(hand=%s)\"%HAND[sid]\n    if finding != HAND[sid]: ok = False\n    print(f\"{sid}\\t{role:16s}\\t{status:9s}\\t{finding:60s}\\t{match}\")\nprint(\"\\nALL MATCH:\", ok)\nsc=len(out); flag=sum(1 for _,_,f,_,_ in out if f!=\"none\")\npn=sum(1 for _,_,f,_,_ in out if \"PROHIBITED_PERSONAL_NARRATIVE\" in f)\npl=sum(1 for _,_,f,_,_ in out if \"PROTECTED_CLASS_LANGUAGE\" in f)\ndm=sum(1 for _,_,f,_,_ in out if \"DISCLAIMER_MISSING\" in f)\nprint(\"COUNTS section=%d flagged=%d pn=%d pcl=%d dm=%d\"%(sc,flag,pn,pl,dm))\nprint(\"CLEAN:\", [s for s,_,f,_,_ in out if f==\"none\"])\nPYEOF" action.permission=* action.action=allow action.pattern=*
