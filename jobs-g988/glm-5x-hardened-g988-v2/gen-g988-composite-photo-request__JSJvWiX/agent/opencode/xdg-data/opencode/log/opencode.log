timestamp=2026-08-20T03:11:42.116Z level=INFO run=0ab716c5 message=evaluated permission=bash pattern="python3 -c \"\nimport csv, json\nfrom datetime import date\nfrom collections import defaultdict\n\nAUDIT_DATE = date(2026, 3, 31)\nregister = {}\nwith open('/app/input/licensed_property_register.csv') as f:\n    for row in csv.DictReader(f): register[row['license_id']] = row\nsuperseded_by = {row['supersedes']: lid for lid,row in register.items() if row['supersedes']!='none'}\ndef terms(lid):\n    if lid=='none' or not lid or lid not in register: return None\n    r = register[superseded_by[lid]] if lid in superseded_by else register[lid]\n    return r['license_type'], r['covers_distribution'], r['valid_until']\ndef covers(lid,use,dist):\n    t=terms(lid)\n    if not t: return False\n    lt,cd,vu=t\n    if lt!=use: return False\n    if not(cd=='all' or dist in [c.strip() for c in cd.split(';')]): return False\n    if date.fromisoformat(vu)<AUDIT_DATE: return False\n    return True\naccounts={}\nwith open('/app/input/client_accounts.csv') as f:\n    for row in csv.DictReader(f): accounts[row['account_id']]=row\ndef clears(aid,dist):\n    a=accounts[aid]\n    if a['agreement_status']!='active': return False\n    return dist in [c.strip() for c in a['master_agreement_covers'].split(';')] if a['master_agreement_covers']!='none' else False\nreqs=[]\nwith open('/app/input/composite_request_log.csv') as f:\n    for row in csv.DictReader(f): reqs.append(row)\naudited=[r for r in reqs if r['intake_status']!='withdrawn']\nPP={'social_public','print_for_sale'}\nB=lambda s: s=='True'\nSECTION_ORDER=['UNLICENSED_CHARACTER_USE','THIRD_PARTY_BACKGROUND_UNLICENSED','MISSING_MINOR_CONSENT','COMMERCIAL_DISTRIBUTION_FLAG','ALTERATION_DISCLOSURE_MISSING']\nexp_audit={}\nfor r in audited:\n    f=[]; d=r['intended_distribution']\n    if r['character_property']!='none' and not(d=='personal_only' or covers(r['character_license_id'],'character',d)): f.append('UNLICENSED_CHARACTER_USE')\n    if r['background_source']=='third_party_unlicensed': f.append('THIRD_PARTY_BACKGROUND_UNLICENSED')\n    elif r['background_source']=='third_party_licensed' and not covers(r['background_license_id'],'background',d): f.append('THIRD_PARTY_BACKGROUND_UNLICENSED')\n    if B(r['subject_is_minor']):\n        ct=r['minor_consent_type']; bad=False\n        if ct=='none': bad=True\n        elif date.fromisoformat(r['minor_consent_valid_until'])<AUDIT_DATE: bad=True\n        elif ct=='basic' and d not in('personal_only','client_internal'): bad=True\n        if bad: f.append('MISSING_MINOR_CONSENT')\n    if d in PP and not clears(r['account_id'],d): f.append('COMMERCIAL_DISTRIBUTION_FLAG')\n    if r['alteration_level']=='substantive' and d in PP and not B(r['alteration_disclosure_on_file']): f.append('ALTERATION_DISCLOSURE_MISSING')\n    exp_audit[r['request_id']]=f  # already in section order\n\n# Compare audit CSV (order-sensitive against section order)\nerrs=[]\nwith open('/app/composite_request_audit.csv') as fh:\n    rows=list(csv.DictReader(fh))\nif list(rows[0].keys())!=['request_id','finding']: errs.append('cols')\nif [r['request_id'] for r in rows]!=[r['request_id'] for r in audited]: errs.append('id order')\nfor r in rows:\n    exp='|'.join(exp_audit[r['request_id']]) if exp_audit[r['request_id']] else 'none'\n    if r['finding']!=exp: errs.append(f\\\"{r['request_id']}: '{r['finding']}' != '{exp}'\\\")\nprint('audit order-sensitive (section order):', 'PASS' if not errs else errs)\n\n# Check no withdrawn in audit\nwithd=[r['request_id'] for r in rows if r['finding']=='withdrawn']\nprint('withdrawn present:', withd if withd else 'no')\nprint('audit rows:', len(rows))\n\"" action.permission=* action.action=allow action.pattern=*
